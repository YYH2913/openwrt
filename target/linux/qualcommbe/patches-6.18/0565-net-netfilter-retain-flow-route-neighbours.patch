 int nft_flow_route(const struct nft_pktinfo *pkt, const struct nf_conn *ct,
 		   struct nf_flow_route *route, enum ip_conntrack_dir dir,
 		   struct nft_flowtable *ft)
 {
+	struct net *net = nft_net(pkt);
+	unsigned int fib_seq = fib_notifier_seq_read(net);
 	struct dst_entry *this_dst = skb_dst(pkt->skb);
+	u32 dst_cookie = nft_flow_dst_cookie(this_dst, nft_pf(pkt));
 	struct dst_entry *other_dst = NULL;
 	struct flowi fl;
 
@@ -256,7 +279,7 @@ int nft_flow_route(const struct nft_pkti
 	if (!dst_hold_safe(this_dst))
 		return -ENOENT;
 
-	nf_route(nft_net(pkt), &other_dst, &fl, false, nft_pf(pkt));
+	nf_route(net, &other_dst, &fl, false, nft_pf(pkt));
 	if (!other_dst) {
 		dst_release(this_dst);
 		return -ENOENT;
@@ -271,6 +294,15 @@ int nft_flow_route(const struct nft_pkti
 		nft_dev_forward_path(route, ct, !dir, ft);
 	}
 
+	if (fib_seq != fib_notifier_seq_read(net) ||
+	    !dst_check(this_dst, dst_cookie)) {
+		nf_flow_route_release(route);
+		return -EAGAIN;
+	}
+
+	route->tuple[dir].fib_seq = fib_seq;
+	route->tuple[!dir].fib_seq = fib_seq;
+
 	return 0;
 }
 EXPORT_SYMBOL_GPL(nft_flow_route);
