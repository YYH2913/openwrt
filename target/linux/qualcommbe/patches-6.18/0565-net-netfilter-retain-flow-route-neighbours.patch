 #include <net/netfilter/nf_flow_table.h>
 #include <net/netfilter/nf_conntrack.h>
 #include <net/netfilter/nf_conntrack_core.h>
@@ -92,6 +93,17 @@ static struct dst_entry *nft_route_dst_f
 	return dst;
 }
 
+static struct neighbour *
+nft_route_neigh_fetch(struct nf_flow_route *route,
+		      enum flow_offload_tuple_dir dir)
+{
+	struct neighbour *neigh = route->tuple[dir].neigh;
+
+	route->tuple[dir].neigh = NULL;
+
+	return neigh;
+}
+
 static int flow_offload_fill_route(struct flow_offload *flow,
 				   struct nf_flow_route *route,
 				   enum flow_offload_tuple_dir dir)
@@ -100,6 +112,9 @@ static int flow_offload_fill_route(struc
 	struct dst_entry *dst = nft_route_dst_fetch(route, dir);
 	int i, j = 0;
 
+	flow_tuple->neigh = nft_route_neigh_fetch(route, dir);
+	flow_tuple->fib_seq = route->tuple[dir].fib_seq;
+
 	switch (flow_tuple->l3proto) {
 	case NFPROTO_IPV4:
 		flow_tuple->mtu = ip_dst_mtu_maybe_forward(dst, true);
@@ -146,11 +161,31 @@ static int flow_offload_fill_route(struc
 static void nft_flow_dst_release(struct flow_offload *flow,
 				 enum flow_offload_tuple_dir dir)
 {
+	if (flow->tuplehash[dir].tuple.neigh)
+		neigh_release(flow->tuplehash[dir].tuple.neigh);
+
 	if (flow->tuplehash[dir].tuple.xmit_type == FLOW_OFFLOAD_XMIT_NEIGH ||
 	    flow->tuplehash[dir].tuple.xmit_type == FLOW_OFFLOAD_XMIT_XFRM)
 		dst_release(flow->tuplehash[dir].tuple.dst_cache);
 }
 
+void nf_flow_route_release(struct nf_flow_route *route)
+{
+	int dir;
+
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		if (route->tuple[dir].neigh) {
+			neigh_release(route->tuple[dir].neigh);
+			route->tuple[dir].neigh = NULL;
+		}
+		if (route->tuple[dir].dst) {
+			dst_release(route->tuple[dir].dst);
+			route->tuple[dir].dst = NULL;
+		}
+	}
+}
+EXPORT_SYMBOL_GPL(nf_flow_route_release);
+
 void flow_offload_route_init(struct flow_offload *flow,
 			     struct nf_flow_route *route)
 {
@@ -393,15 +428,13 @@ flow_offload_lookup(struct nf_flowtable
 {
 	struct flow_offload_tuple_rhash *tuplehash;
 	struct flow_offload *flow;
-	int dir;
 
 	tuplehash = rhashtable_lookup(&flow_table->rhashtable, tuple,
 				      nf_flow_offload_rhash_params);
 	if (!tuplehash)
 		return NULL;
 
-	dir = tuplehash->tuple.dir;
-	flow = container_of(tuplehash, struct flow_offload, tuplehash[dir]);
+	flow = flow_offload_tuple_to_flow(&tuplehash->tuple);
 	if (test_bit(NF_FLOW_TEARDOWN, &flow->flags))
 		return NULL;
 
