From: syed touqeer pasha <quic_spasha@quicinc.com>
Date: Tue, 2 May 2023 16:13:47 +0530
Subject: [PATCH] net: ethernet: qualcomm: ppe: gate direct-switch queues

QSDK EDMA v2 explicitly enables every queue mapped to a PPE2TCL ring when
starting a direct-switch node and disables those queues before stopping the
ring.  The upstream-style port only relies on the one-time global queue
initialization.  That leaves a restarted or otherwise disabled queue unable
to produce PPE2TCL descriptors even though its flow, enqueue-VP, scheduler
and queue-to-ring mappings are valid.

Mirror the vendor lifecycle for each node's eight dedicated queues.  Keep
trying every queue on teardown so one register error cannot leave the rest
of the ring fed while its descriptors are being stopped.

Link: https://git.codelinaro.org/clo/qsdk/oss/lklm/nss-ppe/-/tree/87bb9b326dfe7ddafb2cc8bc588e74d552a2a9b5
Based-on: https://git.codelinaro.org/clo/qsdk/oss/lklm/nss-ppe/-/commit/75ce3baf08f3650a764705a1d9e72304eba621d0
Signed-off-by: syed touqeer pasha <quic_spasha@quicinc.com>
Assisted-by: Codex:GPT-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_ds.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_ds.c
@@ -1193,6 +1193,40 @@ err_resources:
 }
 EXPORT_SYMBOL_GPL(qcom_ppe_ds_register);
 
+static int ppe_ds_queues_set(struct qcom_ppe_ds_node *node, bool enable)
+{
+	struct regmap *regmap = ppe_ds_regmap(node);
+	u32 queue, reg, val = enable ? 0 : U32_MAX;
+	int err = 0, ret;
+
+	for (queue = node->queue_start;
+	     queue < node->queue_start + node->queue_count; queue++) {
+		reg = PPE_ENQ_OPR_TBL_ADDR + PPE_ENQ_OPR_TBL_INC * queue;
+		ret = regmap_update_bits(regmap, reg,
+					 PPE_ENQ_OPR_TBL_ENQ_DISABLE, val);
+		if (ret) {
+			dev_err(node->client,
+				"failed to %s direct-switch queue %u enqueue: %d\n",
+				enable ? "enable" : "disable", queue, ret);
+			if (!err)
+				err = ret;
+		}
+
+		reg = PPE_DEQ_OPR_TBL_ADDR + PPE_DEQ_OPR_TBL_INC * queue;
+		ret = regmap_update_bits(regmap, reg,
+					 PPE_DEQ_OPR_TBL_DEQ_DISABLE, val);
+		if (ret) {
+			dev_err(node->client,
+				"failed to %s direct-switch queue %u dequeue: %d\n",
+				enable ? "enable" : "disable", queue, ret);
+			if (!err)
+				err = ret;
+		}
+	}
+
+	return err;
+}
+
 /* Stop every EDMA ring before releasing any memory it can still access.
  * The caller has already quiesced the WLAN producer and holds node->lock.
  */
@@ -1215,5 +1249,8 @@ static void ppe_ds_hw_stop(struct qcom_p
 		dev_warn(node->client, "REO2PPE ring %u did not stop: %d\n",
 			 node->reo2ppe.id, ret);
+	/* Stop PPE from feeding the WLAN source ring before disabling it. */
+	ppe_ds_queues_set(node, false);
+
 	regmap_clear_bits(regmap,
 			  ppe_ds_reg(EDMA_REG_RXDESC_CTRL(node->ppe2tcl.ring_id)),
 			  EDMA_RXDESC_RX_EN);
@@ -1310,6 +1347,10 @@ int qcom_ppe_ds_start(struct qcom_ppe_ds
 	if (ret)
 		goto err_start;
 
+	ret = ppe_ds_queues_set(node, true);
+	if (ret)
+		goto err_start;
+
 	data = node->reg.rxfill_low_threshold ?: 32;
 	ret = regmap_write(regmap,
 			   ppe_ds_reg(EDMA_REG_RXFILL_UGT_THRE(node->rxfill.ring_id)),
-- 
