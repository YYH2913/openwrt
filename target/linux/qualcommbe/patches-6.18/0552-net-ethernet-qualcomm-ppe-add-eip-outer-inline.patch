 /* Initialize EDMA service codes used by CPU and virtual-port injection. */
 static int ppe_servcode_init(struct ppe_device *ppe_dev)
 {
+	struct ppe_queue_ucast_dest queue_dst = {
+		.service_code_en = true,
+		.service_code = PPE_EIP_SC_PPE2EIP_DECAP,
+	};
 	struct ppe_sc_cfg sc_cfg = {};
-	int ret;
+	int profile, queue, queue_end, ret;
 
 	bitmap_zero(sc_cfg.bitmaps.counter, PPE_SC_BYPASS_COUNTER_SIZE);
 	bitmap_zero(sc_cfg.bitmaps.tunnel, PPE_SC_BYPASS_TUNNEL_SIZE);
@@ -2692,7 +2696,59 @@
 		sc_cfg.bitmaps.egress);
 	sc_cfg.next_service_code = PPE_EDMA_SC_SPF_BYPASS_ID;
 
-	return ppe_sc_config_set(ppe_dev, PPE_EDMA_SC_SPF_BYPASS_ID, sc_cfg);
+	ret = ppe_sc_config_set(ppe_dev, PPE_EDMA_SC_SPF_BYPASS_ID, sc_cfg);
+	if (ret)
+		return ret;
+
+	/* SC7 redirects an outer ESP/NAT-T flow to the EIP physical port.
+	 * EIP consumes an L3-offset packet and returns it with SC8.
+	 */
+	sc_cfg = (struct ppe_sc_cfg){};
+	sc_cfg.dest_port_valid = true;
+	sc_cfg.dest_port = PPE_EIP_PORT;
+	sc_cfg.next_service_code = PPE_EIP_SC_EIP2PPE;
+	sc_cfg.eip_field_update_bitmap = PPE_EIP_UPDATE_DEST_INFO |
+					 PPE_EIP_UPDATE_HASH_FLOW_INDEX |
+					 PPE_EIP_UPDATE_FAKE_L2_PROTO;
+	sc_cfg.eip_hw_service = PPE_EIP_HW_SERVICE_IPSEC;
+	/* Zero selects the L3 offset; one selects L4. */
+	sc_cfg.eip_offset_sel = 0;
+	set_bit(PPE_SC_BYPASS_EGRESS_L3_PKT_EDIT, sc_cfg.bitmaps.egress);
+	set_bit(PPE_SC_BYPASS_EGRESS_L2_SOURCE_SECURITY,
+		sc_cfg.bitmaps.egress);
+	ret = ppe_sc_config_set(ppe_dev, PPE_EIP_SC_PPE2EIP_DECAP, sc_cfg);
+	if (ret)
+		return ret;
+
+	/* SC8 is the tag on decrypted packets returning from EIP. Preserve it
+	 * across ingress flow processing so exception delivery can identify the
+	 * inline path.
+	 */
+	sc_cfg = (struct ppe_sc_cfg){};
+	sc_cfg.next_service_code = PPE_EIP_SC_EIP2PPE;
+	set_bit(PPE_SC_BYPASS_INGRESS_FLOW_SERVICE_CODE,
+		sc_cfg.bitmaps.ingress);
+	ret = ppe_sc_config_set(ppe_dev, PPE_EIP_SC_EIP2PPE, sc_cfg);
+	if (ret)
+		return ret;
+
+	ret = ppe_port_resource_get(ppe_dev, PPE_EIP_PORT, PPE_RES_UCAST,
+				    &queue, &queue_end);
+	if (ret)
+		return ret;
+
+	/* A service-code lookup is indexed by source profile. Program all four
+	 * profiles because EIP traffic can arrive from any physical port.
+	 */
+	for (profile = 0; profile < PPE_QUEUE_SRC_PROFILE_NUM; profile++) {
+		queue_dst.src_profile = profile;
+		ret = ppe_queue_ucast_base_set(ppe_dev, queue_dst, queue,
+					       PPE_QUEUE_REDIR_PROFILE_ID);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
 }
 
