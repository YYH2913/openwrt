+static int ppe_ft_eip_flows_show(struct seq_file *seq, void *data)
+{
+	struct ppe_flowtable *ft = seq->private;
+	struct qcom_ppe_eip_flow *flow;
+
+	mutex_lock(&ft->lock);
+	list_for_each_entry(flow, &ft->eip_flows, node) {
+		u32 packets = 0, w0 = 0;
+		u16 bind_ref = 0;
+		u64 bytes = 0;
+
+		regmap_read(ft->ppe_dev->regmap,
+			    PPE_FLOW_TBL_ADDR + PPE_FLOW_TBL_INC * flow->index,
+			    &w0);
+		ppe_flow_stats_get(ft->ppe_dev, flow->index, &packets, &bytes);
+
+		if (flow->my_mac_l3_if >= 0 &&
+		    flow->my_mac_l3_if < PPE_IN_L3_IF_TBL_ENTRIES &&
+		    flow->my_mac >= 0 &&
+		    flow->my_mac < PPE_MY_MAC_TBL_ENTRIES)
+			bind_ref = ft->my_mac_l3_refs[flow->my_mac_l3_if]
+							 [flow->my_mac];
+
+		if (flow->tuple.ipv6) {
+			seq_printf(seq, "[%pI6c] -> [%pI6c]",
+				   &flow->tuple.src.v6, &flow->tuple.dst.v6);
+		} else {
+			seq_printf(seq, "%pI4 -> %pI4",
+				   &flow->tuple.src.v4, &flow->tuple.dst.v4);
+		}
+		seq_printf(seq,
+			   " proto:%u sport:%u dport:%u index:%d valid:%u ref:%u poisoned:%u ingress:%u l3_if:%d host:%u my_mac:%d bind_ref:%u service:%u packets:%u bytes:%llu\n",
+			   flow->tuple.protocol,
+			   be16_to_cpu(flow->tuple.src_port),
+			   be16_to_cpu(flow->tuple.dst_port), flow->index,
+			   !!(w0 & PPE_FLOW_W0_VALID), flow->refcnt,
