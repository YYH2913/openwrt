+			   flow->my_mac_l3_if, flow->entry.host_index,
+			   flow->my_mac, bind_ref, flow->entry.service_code,
+			   packets, (unsigned long long)bytes);
+	}
+	mutex_unlock(&ft->lock);
+
+	return 0;
+}
