+static bool
+ppe_ft_eip_tuple_equal(const struct qcom_ppe_eip_tuple *a,
+		       const struct qcom_ppe_eip_tuple *b)
+{
+	if (a->ipv6 != b->ipv6 || a->protocol != b->protocol ||
+	    a->src_port != b->src_port || a->dst_port != b->dst_port)
+		return false;
+
+	if (a->ipv6)
+		return ipv6_addr_equal(&a->src.v6, &b->src.v6) &&
+		       ipv6_addr_equal(&a->dst.v6, &b->dst.v6);
+
+	return a->src.v4 == b->src.v4 && a->dst.v4 == b->dst.v4;
+}
+
+static int
+ppe_ft_eip_flow_install(struct ppe_flowtable *ft, struct net_device *ingress,
+			const struct qcom_ppe_eip_tuple *tuple,
+			struct qcom_ppe_eip_flow **result)
+{
+	struct qcom_ppe_eip_flow *flow;
+	struct edma_port_priv *port_priv;
+	int port, ret, err;
+
+	lockdep_assert_held(&ppe_eip_api_lock);
+	lockdep_assert_held(&ft->lock);
+
+	if (!ingress || !edma_port_dev_check(ingress))
+		return -EOPNOTSUPP;
+	if (tuple->protocol != IPPROTO_ESP && tuple->protocol != IPPROTO_UDP)
+		return -EPROTONOSUPPORT;
+	if (tuple->protocol == IPPROTO_UDP &&
+	    (!tuple->src_port || !tuple->dst_port))
+		return -EINVAL;
+	if (tuple->protocol == IPPROTO_ESP &&
+	    (tuple->src_port || tuple->dst_port))
+		return -EINVAL;
+
+	port_priv = netdev_priv(ingress);
+	port = port_priv->ppe_port->port_id;
+	if (port <= 0 || port >= ft->ppe_dev->num_ports)
+		return -EINVAL;
+
+	list_for_each_entry(flow, &ft->eip_flows, node) {
+		if (!ppe_ft_eip_tuple_equal(&flow->tuple, tuple))
+			continue;
+		if (flow->poisoned)
+			return -EIO;
+		/* A shared row is tied to one source L3 interface. Rekeyed SAs on
+		 * one WAN can share it, but the same tuple on another WAN cannot.
+		 */
+		if (flow->ingress_port != port)
+			return -EOPNOTSUPP;
+		if (flow->refcnt == UINT_MAX)
+			return -EOVERFLOW;
+		flow->refcnt++;
+		*result = flow;
+		return 0;
+	}
+
+	flow = kzalloc(sizeof(*flow), GFP_KERNEL);
+	if (!flow)
+		return -ENOMEM;
+	flow->ft = ft;
+	flow->tuple = *tuple;
+	if (flow->tuple.protocol == IPPROTO_ESP) {
+		flow->tuple.src_port = 0;
+		flow->tuple.dst_port = 0;
+	}
+	flow->my_mac = -1;
+	flow->my_mac_l3_if = -1;
+	flow->ingress_port = port;
+	flow->entry.is_ipv6 = tuple->ipv6;
+	flow->entry.is_3tuple = tuple->protocol == IPPROTO_ESP;
+	flow->entry.src_l3_if_valid = true;
+	flow->entry.src_l3_if = port;
+	flow->entry.proto = flow->entry.is_3tuple ? PPE_FLOW_PROTOCOL_OTHER :
+						       PPE_FLOW_PROTOCOL_UDP;
+	flow->entry.ip_proto = tuple->protocol;
+	flow->entry.sport = tuple->src_port;
+	flow->entry.dport = tuple->dst_port;
+	flow->entry.service_code = PPE_EIP_SC_PPE2EIP_DECAP;
+	flow->entry.fwd_type = PPE_FLOW_FWD_TYPE_ROUTE;
+	flow->entry.pmtu = PPE_FLOW_PMTU_MAX;
+	if (tuple->ipv6) {
+		flow->entry.sip.ip6 = tuple->src.v6;
+		flow->entry.dip.ip6 = tuple->dst.v6;
+	} else {
+		flow->entry.sip.ip4 = tuple->src.v4;
+		flow->entry.dip.ip4 = tuple->dst.v4;
+	}
+
+	/* Flow lookup is entered only after the router-MAC check. Retain the
+	 * ingress MAC in the shared MY_MAC table and select it on this port's
+	 * L3 interface before publishing the outer flow.
+	 */
+	flow->my_mac = ppe_ft_my_mac_get(ft, ingress->dev_addr);
+	if (flow->my_mac < 0) {
+		ret = flow->my_mac;
+		goto err_free;
+	}
+	ret = ppe_l3_if_set(ft->ppe_dev, port, ingress->dev_addr,
+			    ingress->mtu, -1);
+	if (ret)
+		goto err_mac;
+	ret = ppe_port_l3_if_set(ft->ppe_dev, port, port);
+	if (ret)
+		goto err_mac;
+	ret = ppe_ft_l3_my_mac_get(ft, port, flow->my_mac);
+	if (ret)
+		goto err_mac;
+	flow->my_mac_l3_if = port;
+
+	ret = ppe_ft_host_get(ft, &flow->entry);
+	if (ret)
+		goto err_mac;
+	ret = ppe_flow_entry_add(ft->ppe_dev, &flow->entry);
+	if (ret < 0)
+		goto err_host;
+	flow->index = ret;
+	ret = ppe_flow_entry_enable(ft->ppe_dev, flow->index, true);
+	if (ret)
+		goto err_flow;
+
+	flow->refcnt = 1;
+	list_add_tail(&flow->node, &ft->eip_flows);
+	*result = flow;
+	return 0;
+
+err_flow:
+	err = ppe_flow_entry_del(ft->ppe_dev, flow->index);
+	if (err && err != -ENOENT) {
+		/* Keep dependencies alive underneath an undeletable row. */
+		flow->poisoned = true;
+		list_add_tail(&flow->node, &ft->eip_flows);
+		return ret;
+	}
+err_host:
+	ppe_ft_host_put(ft, &flow->entry);
+err_mac:
+	ppe_ft_l3_my_mac_put(ft, flow->my_mac_l3_if, flow->my_mac);
+err_free:
+	kfree(flow);
+	return ret;
+}
+
+/* Remove one EIP outer row. A normal release quarantines an undeletable row
+ * with all dependencies intact. Driver teardown owns the hardware instance
+ * and can discard the software state after reporting the failed command.
+ */
+static bool ppe_ft_eip_flow_remove(struct ppe_flowtable *ft,
+				   struct qcom_ppe_eip_flow *flow,
+				   bool teardown)
+{
+	int ret, err;
+
+	lockdep_assert_held(&ppe_eip_api_lock);
+	lockdep_assert_held(&ft->lock);
+
+	ret = ppe_flow_entry_enable(ft->ppe_dev, flow->index, false);
+	err = ppe_flow_entry_del(ft->ppe_dev, flow->index);
+	if (err && err != -ENOENT) {
+		dev_err(ft->ppe_dev->dev,
+			"failed to remove EIP flow %d%s: %d\n", flow->index,
+			teardown ? " during teardown" : ", retaining resources",
+			err);
+		if (!teardown) {
+			flow->poisoned = true;
+			return false;
+		}
+	} else if (ret) {
+		dev_warn(ft->ppe_dev->dev,
+			 "EIP flow %d disable failed before successful delete: %d\n",
+			 flow->index, ret);
+	}
+
+	list_del(&flow->node);
+	ppe_ft_host_put(ft, &flow->entry);
+	ppe_ft_l3_my_mac_put(ft, flow->my_mac_l3_if, flow->my_mac);
+	if (teardown && flow->refcnt) {
+		flow->ft = NULL;
+		list_add_tail(&flow->node, &ppe_eip_retired_flows);
+	} else {
+		kfree(flow);
+	}
+	return true;
+}
+
+static void ppe_ft_eip_flow_drain(struct ppe_flowtable *ft)
+{
+	struct qcom_ppe_eip_flow *flow, *tmp;
+
+	lockdep_assert_held(&ppe_eip_api_lock);
+	lockdep_assert_held(&ft->lock);
+
+	list_for_each_entry_safe(flow, tmp, &ft->eip_flows, node)
+		ppe_ft_eip_flow_remove(ft, flow, true);
+}
+
+int qcom_ppe_eip_flow_get(struct net_device *ingress,
+			  const struct qcom_ppe_eip_tuple *tuple,
+			  struct qcom_ppe_eip_flow **flow)
+{
+	struct ppe_flowtable *ft;
+	int ret;
+
+	if (!tuple || !flow)
+		return -EINVAL;
+	*flow = NULL;
+
+	mutex_lock(&ppe_eip_api_lock);
+	ft = ppe_eip_ft;
+	if (!ft) {
+		ret = -ENODEV;
+		goto out_api;
+	}
+
+	mutex_lock(&ft->lock);
+	ret = ppe_ft_eip_flow_install(ft, ingress, tuple, flow);
+	mutex_unlock(&ft->lock);
+out_api:
+	mutex_unlock(&ppe_eip_api_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_ppe_eip_flow_get);
+
+void qcom_ppe_eip_flow_put(struct qcom_ppe_eip_flow *flow)
+{
+	struct qcom_ppe_eip_flow *candidate;
+	struct ppe_flowtable *ft;
+
+	if (!flow)
+		return;
+
+	mutex_lock(&ppe_eip_api_lock);
+	ft = ppe_eip_ft;
+	if (ft) {
+		mutex_lock(&ft->lock);
+		list_for_each_entry(candidate, &ft->eip_flows, node) {
+			if (candidate != flow)
+				continue;
+			if (WARN_ON_ONCE(!candidate->refcnt))
+				goto out_ft;
+			if (!--candidate->refcnt)
+				ppe_ft_eip_flow_remove(ft, candidate, false);
+			goto out_ft;
+		}
+		mutex_unlock(&ft->lock);
+	}
+
+	list_for_each_entry(candidate, &ppe_eip_retired_flows, node) {
+		if (candidate != flow)
+			continue;
+		if (WARN_ON_ONCE(!candidate->refcnt))
+			break;
+		if (!--candidate->refcnt) {
+			list_del(&candidate->node);
+			kfree(candidate);
+		}
+		break;
+	}
+	goto out_api;
+out_ft:
+	mutex_unlock(&ft->lock);
+out_api:
+	mutex_unlock(&ppe_eip_api_lock);
+}
+EXPORT_SYMBOL_GPL(qcom_ppe_eip_flow_put);
+
+int qcom_ppe_eip_vp_alloc(struct net_device *dev, qcom_ppe_eip_rx_t rx,
+			  void *data)
+{
+	struct ppe_flowtable *ft;
+	int ret;
+
+	mutex_lock(&ppe_eip_api_lock);
+	ft = ppe_eip_ft;
+	ret = ft ? ppe_vp_eip_alloc(ft->ppe_dev, dev, rx, data) : -ENODEV;
+	mutex_unlock(&ppe_eip_api_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_ppe_eip_vp_alloc);
+
+void qcom_ppe_eip_vp_free(int vp)
+{
+	struct ppe_flowtable *ft;
+
+	mutex_lock(&ppe_eip_api_lock);
+	ft = ppe_eip_ft;
+	if (ft)
+		ppe_vp_eip_free(ft->ppe_dev, vp);
+	mutex_unlock(&ppe_eip_api_lock);
+}
+EXPORT_SYMBOL_GPL(qcom_ppe_eip_vp_free);
