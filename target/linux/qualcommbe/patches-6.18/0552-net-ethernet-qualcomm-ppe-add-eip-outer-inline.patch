+/* Retain the association between one L3 interface and a shared MY_MAC row.
+ * The table row and this bitmap edge have separate lifetimes in hardware.
+ */
+static int ppe_ft_l3_my_mac_get(struct ppe_flowtable *ft, int l3_if,
+				int my_mac)
+{
+	u16 *refcnt;
+	int ret;
+
+	lockdep_assert_held(&ft->lock);
+
+	if (l3_if < 0 || l3_if >= PPE_IN_L3_IF_TBL_ENTRIES ||
+	    my_mac < 0 || my_mac >= PPE_MY_MAC_TBL_ENTRIES)
+		return -EINVAL;
+
+	refcnt = &ft->my_mac_l3_refs[l3_if][my_mac];
+	if (*refcnt == U16_MAX)
+		return -EOVERFLOW;
+	if ((*refcnt)++)
+		return 0;
+
+	ret = ppe_l3_if_my_mac_set(ft->ppe_dev, l3_if, my_mac, true);
+	if (ret)
+		*refcnt = 0;
+
+	return ret;
+}
+
+/* Release both the L3 association and the MY_MAC reference held by a flow.
+ * A bitmap edge which cannot be removed retains one phantom table reference,
+ * preventing the row from being recycled underneath stale hardware state.
+ */
+static void ppe_ft_l3_my_mac_put(struct ppe_flowtable *ft, int l3_if,
+				 int my_mac)
+{
+	u16 *refcnt;
+	int ret;
+
+	lockdep_assert_held(&ft->lock);
+
+	if (my_mac < 0)
+		return;
+	if (l3_if < 0) {
+		ppe_ft_my_mac_put(ft, my_mac);
+		return;
+	}
+	if (WARN_ON_ONCE(l3_if >= PPE_IN_L3_IF_TBL_ENTRIES ||
+			 my_mac >= PPE_MY_MAC_TBL_ENTRIES))
+		return;
+
+	refcnt = &ft->my_mac_l3_refs[l3_if][my_mac];
+	if (WARN_ON_ONCE(!*refcnt))
+		return;
+	if (--*refcnt) {
+		ppe_ft_my_mac_put(ft, my_mac);
+		return;
+	}
+
+	ret = ppe_l3_if_my_mac_set(ft->ppe_dev, l3_if, my_mac, false);
+	if (ret) {
+		*refcnt = 1;
+		dev_err(ft->ppe_dev->dev,
+			"retaining MY_MAC %d association on L3 interface %d: %d\n",
+			my_mac, l3_if, ret);
+		return;
+	}
+
+	ppe_ft_my_mac_put(ft, my_mac);
+}
