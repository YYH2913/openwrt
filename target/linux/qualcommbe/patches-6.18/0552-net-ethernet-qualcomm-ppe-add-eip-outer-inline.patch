+
+void ppe_vp_eip_free(struct ppe_device *ppe_dev, int port)
+{
+	struct ppe_vp *vp = ppe_dev->vp;
+	int i = port - PPE_VP_PORT_BASE;
+	struct ppe_vp_eip_rx *eip_rx;
+	struct ppe_vp_slot *slot;
+	int ret, err;
+
+	if (!vp || i < 0 || i >= PPE_VP_SLOTS)
+		return;
+
+	mutex_lock(&vp->lock);
+	slot = &vp->slots[i];
+	eip_rx = rcu_dereference_protected(slot->eip_rx,
+					   lockdep_is_held(&vp->lock));
+	if (!eip_rx || !slot->refcnt) {
+		mutex_unlock(&vp->lock);
+		return;
+	}
+
+	/* Stop new callbacks before disabling the hardware source port. Keep the
+	 * callback object and slot reservation alive until every old reader exits.
+	 */
+	rcu_assign_pointer(slot->eip_rx, NULL);
+	ret = ppe_vp_hw_set_queue(ppe_dev, port, false, 0, 0,
+				  PPE_VP_CPU_PORT);
+	err = ppe_vp_l3_cleanup(ppe_dev, slot, port);
+	if (!ret)
+		ret = err;
+	if (ret) {
+		slot->poisoned = true;
+		dev_err(ppe_dev->dev,
+			"failed to release EIP VP %d, quarantining slot: %d\n",
+				port, ret);
+	}
+
+	/* EDMA invokes the callback from NAPI/softirq context. */
+	synchronize_net();
+	kfree(eip_rx);
+	slot->refcnt = 0;
+	mutex_unlock(&vp->lock);
+}
+
+void ppe_vp_eip_shutdown(struct ppe_device *ppe_dev)
+{
+	int i;
+
+	for (i = 0; i < PPE_VP_SLOTS; i++)
+		ppe_vp_eip_free(ppe_dev, PPE_VP_PORT_BASE + i);
+}
