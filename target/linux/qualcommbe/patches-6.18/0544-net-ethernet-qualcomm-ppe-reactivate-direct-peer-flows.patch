From: Yanghan Ye <yyh94306@gmail.com>
Date: Mon, 27 Jul 2026 14:30:00 +0800
Subject: [PATCH] net: ethernet: qualcomm: ppe: reactivate direct peer flows

Direct-switch peer updates invalidate matching destination flows so an old
radio profile cannot keep forwarding packets after a station moves.  The
software flow object then remains attached to the netfilter flowtable,
however, so no new FLOW_CLS_REPLACE arrives when the peer is mapped again.
The hardware row consequently stays invalid for the lifetime of the
conntrack entry and all traffic falls back through the WLAN virtual-port
exception path and the CPU.

Update the priority profile of existing peer flows in place and restore the
VALID bit when the selected direct-switch node is available.  Keep the row
disabled when the peer disappears or its node is stopped; the existing node
state callback will enable a disabled row after that node restarts.  Change
the profile while the row is disabled so a migrating peer cannot briefly
forward into the previous PPE2TCL ring.

Link: https://git.codelinaro.org/clo/qsdk/oss/lklm/nss-ppe/-/tree/87bb9b326dfe7ddafb2cc8bc588e74d552a2a9b5
Assisted-by: Codex:GPT-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 drivers/net/ethernet/qualcomm/ppe/ppe_flow.c      | 55 ++++++++++++++++++++++
 drivers/net/ethernet/qualcomm/ppe/ppe_flow.h      |  2 +
 drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c | 25 ++++++----
 drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.h |  5 +-
 drivers/net/ethernet/qualcomm/ppe/ppe_vp.c        | 25 +++++++---
 5 files changed, 96 insertions(+), 16 deletions(-)

--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
@@ -253,6 +253,63 @@ int ppe_flow_entry_enable(struct ppe_dev
 	return ret;
 }
 
+int ppe_flow_entry_profile_set(struct ppe_device *ppe_dev, int index,
+			       u8 profile, bool enable)
+{
+	u32 reg = PPE_FLOW_TBL_ADDR + PPE_FLOW_TBL_INC * index;
+	u32 old[3], val[3], valid = enable ? PPE_FLOW_W0_VALID : 0;
+	int ret;
+
+	if (profile > (FIELD_MAX(PPE_FLOW_W2_PRI_PROFILE_HI) << 1 | 1))
+		return -ERANGE;
+
+	mutex_lock(&ppe_dev->flow_lock);
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, old, ARRAY_SIZE(old));
+	if (ret)
+		goto out;
+
+	/* Keep the row disabled until both profile fragments are visible. */
+	val[0] = old[0] & ~PPE_FLOW_W0_VALID;
+	ret = regmap_write(ppe_dev->regmap, reg, val[0]);
+	if (ret)
+		goto out;
+
+	val[1] = (old[1] & ~PPE_FLOW_W1_PRI_PROFILE_LO) |
+		 FIELD_PREP(PPE_FLOW_W1_PRI_PROFILE_LO, profile & 1);
+	ret = regmap_write(ppe_dev->regmap, reg + sizeof(u32), val[1]);
+	if (ret)
+		goto rollback;
+
+	val[2] = (old[2] & ~PPE_FLOW_W2_PRI_PROFILE_HI) |
+		 FIELD_PREP(PPE_FLOW_W2_PRI_PROFILE_HI, profile >> 1);
+	ret = regmap_write(ppe_dev->regmap, reg + 2 * sizeof(u32), val[2]);
+	if (ret)
+		goto rollback;
+
+	val[0] |= valid;
+	ret = regmap_write(ppe_dev->regmap, reg, val[0]);
+	if (ret)
+		goto rollback;
+
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+	if (!ret && ((val[0] & PPE_FLOW_W0_VALID) != valid ||
+		     FIELD_GET(PPE_FLOW_W1_PRI_PROFILE_LO, val[1]) !=
+		     (profile & 1) ||
+		     FIELD_GET(PPE_FLOW_W2_PRI_PROFILE_HI, val[2]) !=
+		     (profile >> 1)))
+		ret = -EIO;
+	if (!ret)
+		goto out;
+
+rollback:
+	regmap_write(ppe_dev->regmap, reg + 2 * sizeof(u32), old[2]);
+	regmap_write(ppe_dev->regmap, reg + sizeof(u32), old[1]);
+	regmap_write(ppe_dev->regmap, reg, old[0]);
+out:
+	mutex_unlock(&ppe_dev->flow_lock);
+	return ret;
+}
+
 int ppe_flow_entry_del(struct ppe_device *ppe_dev, int index)
 {
 	int ret;
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
@@ -92,6 +92,8 @@ int ppe_host_entry_del(struct ppe_device
 int ppe_flow_entry_add(struct ppe_device *ppe_dev,
 		       const struct ppe_flow_entry *flow);
 int ppe_flow_entry_enable(struct ppe_device *ppe_dev, int index, bool enable);
+int ppe_flow_entry_profile_set(struct ppe_device *ppe_dev, int index,
+			       u8 profile, bool enable);
 int ppe_flow_entry_del(struct ppe_device *ppe_dev, int index);
 int ppe_flow_stats_get(struct ppe_device *ppe_dev, int index, u32 *packets,
 		       u64 *bytes);
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
@@ -3388,16 +3388,20 @@ void ppe_flowtable_port_profile_state(st
 	mutex_unlock(&ft->lock);
 }
 
-void ppe_flowtable_port_peer_invalidate(struct ppe_device *ppe_dev, int port,
-					const u8 *addr)
+void ppe_flowtable_port_peer_state(struct ppe_device *ppe_dev, int port,
+				   const u8 *addr, u8 profile, bool enable)
 {
 	struct ppe_flowtable *ft = ppe_dev->flowtable;
 	struct rhashtable_iter iter;
 	struct ppe_ft_flow *flow;
 
-	if (!ft || !addr)
+	if (!ft || !addr || (enable && !profile))
 		return;
 
+	/* A peer transition must update every live conntrack direction that
+	 * resolves to this destination MAC; netfilter will not replace rows
+	 * which remain attached to its flowtable.
+	 */
 	mutex_lock(&ft->lock);
 	rhashtable_walk_enter(&ft->flows, &iter);
 	rhashtable_walk_start(&iter);
@@ -3413,16 +3417,20 @@ void ppe_flowtable_port_peer_invalidate(
 		    !ether_addr_equal(flow->dmac, addr))
 			continue;
 
-		ret = ppe_flow_entry_enable(ppe_dev, flow->index, false);
+		ret = ppe_flow_entry_profile_set(ppe_dev, flow->index,
+						 profile, enable);
 		if (ret) {
 			dev_warn(ppe_dev->dev,
-				 "failed to invalidate flow %d for VP %d peer %pM: %d\n",
-				 flow->index, port, addr, ret);
+				 "failed to %s flow %d for VP %d peer %pM profile %u: %d\n",
+				 enable ? "activate" : "disable", flow->index,
+				 port, addr, profile, ret);
 			continue;
 		}
 
-		/* Keep a node restart from re-enabling a stale peer flow. */
-		flow->entry.pri_profile = 0;
+		/* Keep the software record synchronized with the row so node stop
+		 * and restart callbacks select exactly the flows owned by it.
+		 */
+		flow->entry.pri_profile = profile;
 	}
 	rhashtable_walk_stop(&iter);
 	rhashtable_walk_exit(&iter);
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.h
@@ -20,5 +20,5 @@ void ppe_flowtable_port_carrier(struct p
 void ppe_flowtable_port_profile_state(struct ppe_device *ppe_dev, int port,
 				      u8 profile, bool up, bool invalidate);
-void ppe_flowtable_port_peer_invalidate(struct ppe_device *ppe_dev, int port,
-					const u8 *addr);
+void ppe_flowtable_port_peer_state(struct ppe_device *ppe_dev, int port,
+				   const u8 *addr, u8 profile, bool enable);
 #endif
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_vp.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_vp.c
@@ -957,7 +957,9 @@ int ppe_vp_ds_peer_set(struct ppe_device
 	struct ppe_vp *vp = ppe_dev->vp;
 	struct ppe_vp_peer *peer;
 	int i = port - PPE_VP_PORT_BASE;
-	bool invalidate = false;
+	int selected_node = PPE_VP_DS_NODE_NONE;
+	bool flow_enable = false;
+	bool update = false;
 	int ret = 0;
 
 	if (!vp || i < 0 || i >= PPE_VP_SLOTS || node < 0 ||
@@ -972,11 +974,14 @@ int ppe_vp_ds_peer_set(struct ppe_device
 		peer->node_refs[node]--;
 		if (peer->node == node && !peer->node_refs[node]) {
 			ppe_vp_ds_peer_select_node(peer);
-			invalidate = true;
+			update = true;
 		}
 		if (peer->node == PPE_VP_DS_NODE_NONE) {
 			list_del(&peer->list);
 			kfree(peer);
+		} else {
+			selected_node = peer->node;
+			flow_enable = vp->ds_node_up[selected_node];
 		}
 		goto out;
 	}
@@ -1001,15 +1006,22 @@ int ppe_vp_ds_peer_set(struct ppe_device
 		peer->node = PPE_VP_DS_NODE_NONE;
 		ether_addr_copy(peer->addr, addr);
 		list_add_tail(&peer->list, &vp->peers);
-		invalidate = true;
+		update = true;
 	}
 	peer->node_refs[node]++;
 	if (peer->node != node)
-		invalidate = true;
+		update = true;
 	peer->node = node;
+	selected_node = node;
+	flow_enable = vp->ds_node_up[node];
 out:
 	mutex_unlock(&vp->lock);
-	if (!ret && invalidate)
-		ppe_flowtable_port_peer_invalidate(ppe_dev, port, addr);
+	if (!ret && update) {
+		u8 profile = selected_node == PPE_VP_DS_NODE_NONE ? 0 :
+			PPE_VP_DS_PRI_PROFILE(selected_node);
+
+		ppe_flowtable_port_peer_state(ppe_dev, port, addr, profile,
+					      flow_enable);
+	}
 	return ret;
 }
