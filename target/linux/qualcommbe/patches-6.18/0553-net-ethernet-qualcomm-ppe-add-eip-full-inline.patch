+int qcom_ppe_eip_provider_register(const struct qcom_ppe_eip_provider_ops *ops)
+{
+	int ret = 0;
+
+	if (!ops || !ops->owner || !ops->flow_add || !ops->flow_del)
+		return -EINVAL;
+
+	mutex_lock(&ppe_eip_api_lock);
+	if (ppe_eip_provider)
+		ret = ppe_eip_provider == ops ? -EEXIST : -EBUSY;
+	else
+		ppe_eip_provider = ops;
+	mutex_unlock(&ppe_eip_api_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_ppe_eip_provider_register);
+
+void qcom_ppe_eip_provider_unregister(const struct qcom_ppe_eip_provider_ops *ops)
+{
+	mutex_lock(&ppe_eip_api_lock);
+	if (WARN_ON_ONCE(ppe_eip_provider != ops))
+		goto out;
+
+	ppe_eip_provider = NULL;
+out:
+	mutex_unlock(&ppe_eip_api_lock);
+}
+EXPORT_SYMBOL_GPL(qcom_ppe_eip_provider_unregister);
