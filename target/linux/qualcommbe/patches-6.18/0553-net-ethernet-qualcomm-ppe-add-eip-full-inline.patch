+static void ppe_ft_eip_provider_put(struct ppe_ft_flow *flow)
+{
+	const struct qcom_ppe_eip_provider_ops *ops;
+
+	if (!flow || !flow->eip_ops)
+		return;
+
+	ops = flow->eip_ops;
+	flow->eip_ops = NULL;
+	ops->flow_del(flow->eip_priv);
+	module_put(ops->owner);
+	flow->eip_priv = NULL;
+	flow->eip_dev = NULL;
+}
