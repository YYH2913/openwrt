+/**
+ * struct qcom_ppe_eip_inner_tuple - clear-text flow entering IPsec
+ * @src: Inner source address in network byte order.
+ * @dst: Inner destination address in network byte order.
+ * @src_port: TCP or UDP source port in network byte order.
+ * @dst_port: TCP or UDP destination port in network byte order.
+ * @protocol: IPPROTO_TCP or IPPROTO_UDP.
+ * @ipv6: Select IPv6 rather than IPv4 addresses.
+ */
+struct qcom_ppe_eip_inner_tuple {
+	union {
+		__be32 v4;
+		struct in6_addr v6;
+	} src, dst;
+	__be16 src_port;
+	__be16 dst_port;
+	u8 protocol;
+	bool ipv6;
+};
+
+/**
+ * struct qcom_ppe_eip_binding - EIP resources bound to one PPE flow
+ * @dev: EIP IPsec netdevice retained by the provider object.
+ * @priv: Provider-owned flow handle passed back to flow_del().
+ * @vp: PPE virtual port which represents the EIP inline input.
+ * @mtu: Clear-text path MTU programmed into the PPE flow.
+ */
+struct qcom_ppe_eip_binding {
+	struct net_device *dev;
+	void *priv;
+	int vp;
+	u16 mtu;
+};
+
+/**
+ * struct qcom_ppe_eip_provider_ops - outbound full-inline IPsec provider
+ * @owner: Module which owns the callbacks.
+ * @flow_add: Bind an exact XFRM state and inner tuple to EIP hardware.
+ * @flow_del: Release a binding returned by flow_add().
+ */
+struct qcom_ppe_eip_provider_ops {
+	struct module *owner;
+	int (*flow_add)(struct xfrm_state *x,
+			const struct qcom_ppe_eip_inner_tuple *tuple,
+			struct qcom_ppe_eip_binding *binding);
+	void (*flow_del)(void *priv);
+};
