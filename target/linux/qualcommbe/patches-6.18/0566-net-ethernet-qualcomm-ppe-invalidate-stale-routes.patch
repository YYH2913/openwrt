+static void ppe_ft_flow_neigh_put(struct ppe_ft_flow *flow)
+{
+	if (!flow || !flow->neigh)
+		return;
+
+	neigh_release(flow->neigh);
+	flow->neigh = NULL;
+}
+
+static bool ppe_ft_neigh_valid(struct neighbour *neigh,
+			       const u8 *dmac)
+{
+	bool valid;
+
+	if (!neigh || READ_ONCE(neigh->dead))
+		return false;
+
+	read_lock_bh(&neigh->lock);
+	valid = neigh->nud_state & NUD_VALID;
+	valid = valid && is_valid_ether_addr(neigh->ha) &&
+		ether_addr_equal(neigh->ha, dmac);
+	read_unlock_bh(&neigh->lock);
+
+	return valid;
+}
+
+static bool ppe_ft_tunnel_route_valid(struct ppe_flowtable *ft,
+				      const struct ppe_ft_flow *flow)
+{
+	const struct ppe_ft_tunnel *tunnel;
+	struct net *net;
+
+	if (flow->tunnel < 0)
+		return true;
+	if (flow->tunnel >= PPE_FT_TUNNELS)
+		return false;
+
+	tunnel = &ft->tunnels[flow->tunnel];
+	if (!tunnel->ref.refcnt || tunnel->poisoned || !tunnel->dev)
+		return false;
+
+	net = dev_net(tunnel->dev);
+	if (net != &init_net ||
+	    tunnel->fib_seq != fib_notifier_seq_read(net))
+		return false;
+
+	if (tunnel->pppoe >= 0)
+		return true;
+
+	return ppe_ft_neigh_valid(tunnel->neigh, tunnel->remote_mac);
+}
+
+static bool ppe_ft_flow_route_valid(struct ppe_flowtable *ft,
+				    const struct ppe_ft_flow *flow)
+{
+	struct net *net;
+
+	if (!flow->nf_flow)
+		return false;
+
+	net = nf_ct_net(flow->nf_flow->ct);
+	if (net != &init_net || flow->fib_seq != fib_notifier_seq_read(net))
+		return false;
+	if (flow->neigh && !ppe_ft_neigh_valid(flow->neigh, flow->dmac))
+		return false;
+
+	return ppe_ft_tunnel_route_valid(ft, flow);
+}
+
+static bool ppe_ft_flow_neigh_stale(struct ppe_flowtable *ft,
+				    const struct ppe_ft_flow *flow)
+{
+	const struct ppe_ft_tunnel *tunnel;
+
+	if (flow->neigh && !ppe_ft_neigh_valid(flow->neigh, flow->dmac))
+		return true;
+	if (flow->tunnel < 0 || flow->tunnel >= PPE_FT_TUNNELS)
+		return false;
+
+	tunnel = &ft->tunnels[flow->tunnel];
+	return tunnel->pppoe < 0 &&
+	       !ppe_ft_neigh_valid(tunnel->neigh, tunnel->remote_mac);
+}
+
+static void ppe_ft_route_work(struct work_struct *work)
+{
+	struct ppe_flowtable *ft = container_of(work, struct ppe_flowtable,
+						      route_work);
+	unsigned long events;
+
+	while ((events = xchg(&ft->route_events, 0))) {
+		struct rhashtable_iter iter;
+		struct ppe_ft_flow *flow;
+
+		if (READ_ONCE(ft->stopping))
+			return;
+
+		mutex_lock(&ft->lock);
+		rhashtable_walk_enter(&ft->flows, &iter);
+		rhashtable_walk_start(&iter);
+		while ((flow = rhashtable_walk_next(&iter))) {
+			bool fib_stale = test_bit(PPE_FT_ROUTE_EVENT_FIB, &events);
+			bool neigh_stale;
+			int ret;
+
+			if (IS_ERR(flow)) {
+				if (PTR_ERR(flow) == -EAGAIN)
+					continue;
+				break;
+			}
+			if (flow->invalidated)
+				continue;
+
+			neigh_stale =
+				test_bit(PPE_FT_ROUTE_EVENT_NEIGH, &events) &&
+				ppe_ft_flow_neigh_stale(ft, flow);
+			if (!fib_stale && !neigh_stale)
+				continue;
+
+			flow->invalidated = true;
+			ret = ppe_flow_entry_enable(ft->ppe_dev, flow->index, false);
+			if (ret) {
+				atomic_long_inc(&ft->disable_failures);
+				dev_warn(ft->ppe_dev->dev,
+					 "failed to disable stale flow %d: %d\n",
+					 flow->index, ret);
+			}
+			if (fib_stale)
+				atomic_long_inc(&ft->fib_invalidations);
+			else
+				atomic_long_inc(&ft->neigh_invalidations);
+			flow_offload_teardown(flow->nf_flow);
+		}
+		rhashtable_walk_stop(&iter);
+		rhashtable_walk_exit(&iter);
+		mutex_unlock(&ft->lock);
+	}
+}
+
+static int ppe_ft_fib_event(struct notifier_block *nb, unsigned long event,
+			    void *ptr)
+{
+	struct ppe_flowtable *ft = container_of(nb, struct ppe_flowtable,
+						      fib_nb);
+
+	if (!READ_ONCE(ft->notifiers_ready) || READ_ONCE(ft->stopping))
+		return NOTIFY_DONE;
+
+	atomic_long_inc(&ft->fib_events);
+	atomic_long_inc(&ft->route_generation);
+	set_bit(PPE_FT_ROUTE_EVENT_FIB, &ft->route_events);
+	schedule_work(&ft->route_work);
+
+	return NOTIFY_DONE;
+}
+
+static int ppe_ft_netevent(struct notifier_block *nb, unsigned long event,
+			   void *ptr)
+{
+	struct ppe_flowtable *ft = container_of(nb, struct ppe_flowtable,
+						      netevent_nb);
+	struct neighbour *neigh = ptr;
+
+	if (event != NETEVENT_NEIGH_UPDATE ||
+	    !READ_ONCE(ft->notifiers_ready) || READ_ONCE(ft->stopping) ||
+	    !neigh->dev || dev_net(neigh->dev) != &init_net)
+		return NOTIFY_DONE;
+
+	atomic_long_inc(&ft->neigh_events);
+	atomic_long_inc(&ft->route_generation);
+	set_bit(PPE_FT_ROUTE_EVENT_NEIGH, &ft->route_events);
+	schedule_work(&ft->route_work);
+
+	return NOTIFY_DONE;
+}
