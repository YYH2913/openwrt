+int ppe_vp_ds_peer_set(struct ppe_device *ppe_dev, int port, int node,
+		       const u8 *addr, bool enable)
+{
+	struct ppe_vp *vp = ppe_dev->vp;
+	struct ppe_vp_peer *peer;
+	int i = port - PPE_VP_PORT_BASE;
+	int ret = 0;
+
+	if (!vp || i < 0 || i >= PPE_VP_SLOTS || node < 0 ||
+	    node >= PPE_VP_DS_NODES || !is_valid_ether_addr(addr))
+		return -EINVAL;
+
+	mutex_lock(&vp->lock);
+	peer = ppe_vp_ds_peer_find(vp, port, addr);
+	if (!enable) {
+		if (!peer || !peer->node_refs[node])
+			goto out;
+		peer->node_refs[node]--;
+		if (peer->node == node && !peer->node_refs[node])
+			ppe_vp_ds_peer_select_node(peer);
+		if (peer->node == PPE_VP_DS_NODE_NONE) {
+			list_del(&peer->list);
+			kfree(peer);
+		}
+		goto out;
+	}
+
+	if (!vp->slots[i].direct ||
+	    !rcu_access_pointer(vp->slots[i].dev) ||
+	    !vp->slots[i].ds_node_refs[node]) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (peer && peer->node_refs[node] == U16_MAX) {
+		ret = -EOVERFLOW;
+		goto out;
+	}
+	if (!peer) {
+		peer = kzalloc(sizeof(*peer), GFP_KERNEL);
+		if (!peer) {
+			ret = -ENOMEM;
+			goto out;
+		}
+		peer->vp = port;
+		peer->node = PPE_VP_DS_NODE_NONE;
+		ether_addr_copy(peer->addr, addr);
+		list_add_tail(&peer->list, &vp->peers);
+	}
+	peer->node_refs[node]++;
+	peer->node = node;
+out:
+	mutex_unlock(&vp->lock);
+	return ret;
+}
+
+int ppe_vp_ds_node_get(struct ppe_device *ppe_dev, int port, const u8 *addr)
+{
+	struct ppe_vp *vp = ppe_dev->vp;
+	struct ppe_vp_peer *peer;
+	int i = port - PPE_VP_PORT_BASE;
+	int node;
+
+	if (!vp || i < 0 || i >= PPE_VP_SLOTS)
+		return -EOPNOTSUPP;
+
+	mutex_lock(&vp->lock);
+	if (!vp->slots[i].direct) {
+		node = -EOPNOTSUPP;
+		goto out;
+	}
+
+	peer = ppe_vp_ds_peer_find(vp, port, addr);
+	node = peer ? peer->node : vp->slots[i].ds_node;
+	if (node < 0 || node >= PPE_VP_DS_NODES ||
+	    !vp->slots[i].ds_node_refs[node] || !vp->ds_node_up[node])
+		node = -ENETDOWN;
+out:
+	mutex_unlock(&vp->lock);
+	return node;
+}
+
+unsigned int ppe_vp_ds_peer_count(struct ppe_device *ppe_dev, int node)
+{
+	struct ppe_vp *vp = ppe_dev->vp;
+	struct ppe_vp_peer *peer;
+	unsigned int count = 0;
+
+	if (!vp || node < 0 || node >= PPE_VP_DS_NODES)
+		return 0;
+
+	mutex_lock(&vp->lock);
+	list_for_each_entry(peer, &vp->peers, list)
+		if (peer->node_refs[node])
+			count++;
+	mutex_unlock(&vp->lock);
+
+	return count;
+}
