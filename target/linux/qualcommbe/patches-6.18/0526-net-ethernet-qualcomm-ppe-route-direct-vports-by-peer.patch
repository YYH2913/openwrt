 #define PPE_VP_DS_NODES		3
 
 #define PPE_VP_DS_NODE_NONE	-1
+#define PPE_VP_DS_PRI_PROFILE(node)	((node) + 1)
+
+struct ppe_vp_peer {
+	struct list_head list;
+	u8 addr[ETH_ALEN];
+	u16 node_refs[PPE_VP_DS_NODES];
+	int vp;
+	int node;
+};
 
