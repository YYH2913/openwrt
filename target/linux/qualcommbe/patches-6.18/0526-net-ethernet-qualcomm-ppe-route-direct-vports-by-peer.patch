 	struct ppe_vp_slot slots[PPE_VP_SLOTS];
 };
 
+static struct ppe_vp_peer *
+ppe_vp_ds_peer_find(struct ppe_vp *vp, int port, const u8 *addr)
+{
+	struct ppe_vp_peer *peer;
+
+	list_for_each_entry(peer, &vp->peers, list)
+		if (peer->vp == port && ether_addr_equal(peer->addr, addr))
+			return peer;
+
+	return NULL;
+}
+
+static void ppe_vp_ds_peer_select_node(struct ppe_vp_peer *peer)
+{
+	int node;
+
+	for (node = 0; node < PPE_VP_DS_NODES; node++)
+		if (peer->node_refs[node]) {
+			peer->node = node;
+			return;
+		}
+
+	peer->node = PPE_VP_DS_NODE_NONE;
+}
+
+static void ppe_vp_ds_peers_purge(struct ppe_vp *vp, int port, int node)
+{
+	struct ppe_vp_peer *peer, *tmp;
+
+	list_for_each_entry_safe(peer, tmp, &vp->peers, list) {
+		if (peer->vp != port)
+			continue;
+		if (node >= 0) {
+			peer->node_refs[node] = 0;
+			if (peer->node == node)
+				ppe_vp_ds_peer_select_node(peer);
+			if (peer->node != PPE_VP_DS_NODE_NONE)
+				continue;
+		}
+		list_del(&peer->list);
+		kfree(peer);
+	}
+}
