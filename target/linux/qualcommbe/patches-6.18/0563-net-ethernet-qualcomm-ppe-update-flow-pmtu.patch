From: Yanghan Ye <yyh94306@gmail.com>
Date: Thu, 6 Aug 2026 04:08:00 +0800
Subject: [PATCH] net: ethernet: qualcomm: ppe: update flow PMTU in place

The PPE flow PMTU is split across two table words.  An EIP rekey can
change the encapsulation overhead while retaining the same hardware
flow, so the driver needs to update that PMTU without deleting and
reinstalling the row.

Add a serialized update which snapshots the row, clears VALID while
writing both PMTU fragments, restores the old validity, and verifies
the result.  Roll back the complete row state on an access failure; a
failed field restore deliberately leaves the row disabled.

The CodeLinaro nss-ppe branches do not provide a runtime flow-PMTU
update, and no external correction for this case could be identified.

Link: https://git.codelinaro.org/clo/qsdk/oss/lklm/nss-ppe/-/tree/87bb9b326dfe7ddafb2cc8bc588e74d552a2a9b5
Assisted-by: Codex:GPT-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
@@ -274,6 +274,142 @@ int ppe_flow_entry_enable(struct ppe_device *ppe_dev, int index, bool enable)
 	return ret;
 }
 
+static int ppe_flow_entry_pmtu_restore(struct ppe_device *ppe_dev, u32 reg,
+				       unsigned int lo_word,
+				       unsigned int hi_word,
+				       u32 old_valid, u32 old_lo, u32 old_hi)
+{
+	int err = 0, ret;
+
+	ret = regmap_write(ppe_dev->regmap, reg,
+			   old_valid & ~PPE_FLOW_W0_VALID);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(ppe_dev->regmap, reg + lo_word * sizeof(u32),
+			   old_lo);
+	if (ret && !err)
+		err = ret;
+
+	ret = regmap_write(ppe_dev->regmap, reg + hi_word * sizeof(u32),
+			   old_hi);
+	if (ret && !err)
+		err = ret;
+
+	/* A failed field restore must leave the row disabled. */
+	if (err)
+		return err;
+
+	ret = regmap_write(ppe_dev->regmap, reg, old_valid);
+	if (ret)
+		err = ret;
+
+	return err;
+}
+
+int ppe_flow_entry_pmtu_set(struct ppe_device *ppe_dev, int index,
+			    bool ipv6, bool is_3tuple, u16 pmtu)
+{
+	u32 reg = PPE_FLOW_TBL_ADDR + PPE_FLOW_TBL_INC * index;
+	unsigned int lo_word, hi_word;
+	u32 lo_mask, hi_mask, lo_pmtu, hi_pmtu;
+	u32 old_valid, old_lo, old_hi;
+	u32 val, verify_lo, verify_hi;
+	int ret, rollback;
+
+	if (pmtu > PPE_FLOW_PMTU_MAX)
+		return -ERANGE;
+
+	if (ipv6) {
+		lo_word = 2;
+		hi_word = 3;
+		lo_mask = PPE_FLOW_V6_W2_PMTU_LO;
+		hi_mask = PPE_FLOW_V6_W3_PMTU_HI;
+		lo_pmtu = FIELD_PREP(PPE_FLOW_V6_W2_PMTU_LO,
+				     pmtu & GENMASK(10, 0));
+		hi_pmtu = FIELD_PREP(PPE_FLOW_V6_W3_PMTU_HI, pmtu >> 11);
+	} else if (is_3tuple) {
+		lo_word = 3;
+		hi_word = 4;
+		lo_mask = PPE_FLOW_V4_3T_W3_PMTU_LO;
+		hi_mask = PPE_FLOW_V4_3T_W4_PMTU_HI;
+		lo_pmtu = FIELD_PREP(PPE_FLOW_V4_3T_W3_PMTU_LO,
+				     pmtu & GENMASK(2, 0));
+		hi_pmtu = FIELD_PREP(PPE_FLOW_V4_3T_W4_PMTU_HI, pmtu >> 3);
+	} else {
+		lo_word = 4;
+		hi_word = 5;
+		lo_mask = PPE_FLOW_V4_W4_PMTU_LO;
+		hi_mask = PPE_FLOW_V4_W5_PMTU_HI;
+		lo_pmtu = FIELD_PREP(PPE_FLOW_V4_W4_PMTU_LO,
+				     pmtu & GENMASK(10, 0));
+		hi_pmtu = FIELD_PREP(PPE_FLOW_V4_W5_PMTU_HI, pmtu >> 11);
+	}
+
+	mutex_lock(&ppe_dev->flow_lock);
+	ret = regmap_read(ppe_dev->regmap, reg, &old_valid);
+	if (ret)
+		goto out;
+	ret = regmap_read(ppe_dev->regmap, reg + lo_word * sizeof(u32),
+			  &old_lo);
+	if (ret)
+		goto out;
+	ret = regmap_read(ppe_dev->regmap, reg + hi_word * sizeof(u32),
+			  &old_hi);
+	if (ret)
+		goto out;
+
+	ret = regmap_write(ppe_dev->regmap, reg,
+			   old_valid & ~PPE_FLOW_W0_VALID);
+	if (ret)
+		goto out;
+
+	val = (old_lo & ~lo_mask) | lo_pmtu;
+	ret = regmap_write(ppe_dev->regmap, reg + lo_word * sizeof(u32), val);
+	if (ret)
+		goto restore;
+
+	val = (old_hi & ~hi_mask) | hi_pmtu;
+	ret = regmap_write(ppe_dev->regmap, reg + hi_word * sizeof(u32), val);
+	if (ret)
+		goto restore;
+
+	ret = regmap_write(ppe_dev->regmap, reg, old_valid);
+	if (ret)
+		goto restore;
+
+	ret = regmap_read(ppe_dev->regmap, reg, &val);
+	if (ret)
+		goto restore;
+	ret = regmap_read(ppe_dev->regmap, reg + lo_word * sizeof(u32),
+			  &verify_lo);
+	if (ret)
+		goto restore;
+	ret = regmap_read(ppe_dev->regmap, reg + hi_word * sizeof(u32),
+			  &verify_hi);
+	if (ret)
+		goto restore;
+
+	if ((val & PPE_FLOW_W0_VALID) != (old_valid & PPE_FLOW_W0_VALID) ||
+	    (verify_lo & lo_mask) != lo_pmtu ||
+	    (verify_hi & hi_mask) != hi_pmtu) {
+		ret = -EIO;
+		goto restore;
+	}
+
+	goto out;
+
+restore:
+	rollback = ppe_flow_entry_pmtu_restore(ppe_dev, reg, lo_word, hi_word,
+					       old_valid, old_lo, old_hi);
+	if (rollback)
+		dev_err(ppe_dev->dev,
+			"failed to restore flow %d PMTU: %d\n", index, rollback);
+out:
+	mutex_unlock(&ppe_dev->flow_lock);
+	return ret;
+}
+
 static int
 ppe_flow_entry_profile_restore(struct ppe_device *ppe_dev, u32 reg,
 			       const u32 old[3])
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
@@ -102,6 +102,8 @@ int ppe_host_entry_del(struct ppe_device *ppe_dev, int index);
 int ppe_flow_entry_add(struct ppe_device *ppe_dev,
 		       const struct ppe_flow_entry *flow);
 int ppe_flow_entry_enable(struct ppe_device *ppe_dev, int index, bool enable);
+int ppe_flow_entry_pmtu_set(struct ppe_device *ppe_dev, int index,
+			    bool ipv6, bool is_3tuple, u16 pmtu);
 int ppe_flow_entry_profile_set(struct ppe_device *ppe_dev, int index,
 			       u8 profile, bool enable);
 int ppe_flow_entry_del(struct ppe_device *ppe_dev, int index);
