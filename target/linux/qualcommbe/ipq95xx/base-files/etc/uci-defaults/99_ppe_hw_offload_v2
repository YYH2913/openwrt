case "$(board_name)" in
askey,sbe1v1k)
	changed=0

	if ! uci -q get firewall.@defaults[0].flow_offloading >/dev/null; then
		uci -q set firewall.@defaults[0].flow_offloading='1'
		changed=1
	fi

	if ! uci -q get firewall.@defaults[0].flow_offloading_hw >/dev/null; then
		uci -q set firewall.@defaults[0].flow_offloading_hw='1'
		changed=1
	fi

	[ "$changed" = 0 ] || uci commit firewall
	;;
esac

exit 0
