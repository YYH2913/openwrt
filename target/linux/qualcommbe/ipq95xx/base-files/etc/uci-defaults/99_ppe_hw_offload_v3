case "$(board_name)" in
askey,sbe1v1k)
	changed=0

	if ! uci -q get firewall.@defaults[0] >/dev/null; then
		uci -q add firewall defaults >/dev/null
		changed=1
	fi

	# A sysupgrade keeps /etc/config/firewall.  Earlier images wrote these
	# options as disabled, so merely filling missing values leaves PPE
	# flowtable offload inactive after an upgrade.
	if [ "$(uci -q get firewall.@defaults[0].flow_offloading)" != '1' ]; then
		uci -q set firewall.@defaults[0].flow_offloading='1'
		changed=1
	fi

	if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" != '1' ]; then
		uci -q set firewall.@defaults[0].flow_offloading_hw='1'
		changed=1
	fi

	[ "$changed" = 0 ] || uci commit firewall
	;;
esac

exit 0
