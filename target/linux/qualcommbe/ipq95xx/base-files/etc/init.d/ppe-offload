#!/bin/sh /etc/rc.common

# Keep PPE flowtable defaults present across sysupgrades.  UCI defaults
# scripts are removed after first boot and may be hidden by an overlay
# whiteout, while this target requires hardware offload before firewall
# starts.
START=11

boot()
{
	case "$(board_name)" in
	askey,sbe1v1k) ;;
	*) return 0 ;;
	esac

	local changed=0

	if ! uci -q get firewall.@defaults[0] >/dev/null; then
		uci -q add firewall defaults >/dev/null || return 0
		changed=1
	fi

	if [ "$(uci -q get firewall.@defaults[0].flow_offloading)" != "1" ]; then
		uci -q set firewall.@defaults[0].flow_offloading=1
		changed=1
	fi

	if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" != "1" ]; then
		uci -q set firewall.@defaults[0].flow_offloading_hw=1
		changed=1
	fi

	if [ "$changed" = "1" ]; then
		uci -q commit firewall
		logger -t ppe-offload "enabled PPE flowtable hardware offload defaults"
	fi
}
