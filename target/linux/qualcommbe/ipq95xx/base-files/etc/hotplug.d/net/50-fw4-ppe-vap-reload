#!/bin/sh

# fw4 starts before hostapd creates the AP VAPs. Refresh its flowtable after
# the VAPs are forwarding so resolve_lower_devices() can include them.
[ "$ACTION" = "add" ] || exit 0
[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = "1" ] || exit 0
[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ] || exit 0

case "$DEVICENAME" in
	wl*-ap*|phy*-ap*|ap-mld*) ;;
	*) exit 0 ;;
esac

pending=/var/run/fw4-ppe-vap-reload.pending

log()
{
	logger -t ppe-flowtable "$*"
}

trigger_vap_ready()
{
	local state="/sys/class/net/$DEVICENAME/brport/state"

	[ -r "$state" ] && [ "$(cat "$state" 2>/dev/null)" = "3" ]
}

vap_ports_ready()
{
	local state found=0

	# A disabled AP VAP can remain attached to br-lan indefinitely.  It has no
	# direct-switch endpoint and must not hold up the active VAP which caused
	# this event.  Later VAP add events refresh the flowtable as each one enters
	# forwarding.
	for state in /sys/class/net/wl*-ap*/brport/state \
		     /sys/class/net/phy*-ap*/brport/state \
		     /sys/class/net/ap-mld*/brport/state; do
		[ -r "$state" ] || continue
		[ "$(cat "$state" 2>/dev/null)" = "3" ] || continue
		found=1
	done

	[ "$found" = "1" ]
}

flowtable_ready()
{
	local table path current

	table="$(nft list flowtable inet fw4 ft 2>/dev/null)" || return 1
	printf '%s\n' "$table" | grep -Fq 'flags offload' || return 1

	for path in /sys/class/net/wl*-ap*/brport/state \
		    /sys/class/net/phy*-ap*/brport/state \
		    /sys/class/net/ap-mld*/brport/state; do
		[ -r "$path" ] || continue
		[ "$(cat "$path" 2>/dev/null)" = "3" ] || continue
		current=${path%/brport/state}
		current=${current##*/}
		printf '%s\n' "$table" | grep -Fq "$current" || return 1
	done
}

# Coalesce the burst of add events emitted while hostapd brings up the three
# radios.  The latest event owns the deferred reload worker.
token="$$"
printf '%s\n' "$token" > "$pending"

(
	# Allow hostapd and ath12k to finish vdev start before inspecting bridge
	# state.  A VAP can briefly enter forwarding before it is immediately
	# disabled again during firmware recovery, hence the later stable check.
	sleep 3
	[ "$(cat "$pending" 2>/dev/null)" = "$token" ] || exit 0

	exec 9>/var/lock/fw4-ppe-vap-reload.lock
	flock 9 || exit 0
	[ "$(cat "$pending" 2>/dev/null)" = "$token" ] || exit 0

	# Direct-switch VPs are allocated just before the AP bridge port enters
	# forwarding.  Do not make an intentionally disabled sibling VAP block the
	# active one: it has no endpoint for fw4 to bind at this point.
	tries=120
	while ! trigger_vap_ready && [ "$tries" -gt 0 ]; do
		sleep 1
		tries=$((tries - 1))
	done
	if ! trigger_vap_ready; then
		log "$DEVICENAME did not reach bridge forwarding"
		exit 0
	fi
	sleep 2
	if ! trigger_vap_ready || ! vap_ports_ready; then
		log "$DEVICENAME left bridge forwarding before PPE flowtable bind"
		exit 0
	fi

	if flowtable_ready; then
		log "$DEVICENAME already present in the hardware flowtable"
		exit 0
	fi

	# fw4 performs the hardware capability probe and atomically falls back to
	# software when an endpoint is unavailable.  A short, bounded retry covers
	# the final PPEDS setup race without disturbing DHCP for tens of seconds.
	tries=3
	while [ "$tries" -gt 0 ]; do
		[ "$(cat "$pending" 2>/dev/null)" = "$token" ] || exit 0
		if flowtable_ready; then
			log "$DEVICENAME bound to the hardware flowtable"
			exit 0
		fi
		log "$DEVICENAME requesting hardware flowtable reload ($tries remaining)"
		/etc/init.d/firewall reload >/dev/null 2>&1 || true
		sleep 5
		tries=$((tries - 1))
	done

	log "$DEVICENAME could not be bound to the hardware flowtable"
) &

exit 0
