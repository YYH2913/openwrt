#!/bin/sh

# fw4 starts before hostapd creates the AP VAPs. Refresh its flowtable once
# a VAP is attached so resolve_lower_devices() can include the bridge port.
[ "$ACTION" = "add" ] || exit 0
[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ] || exit 0

case "$DEVICENAME" in
	wl*-ap*|phy*-ap*|ap-mld*) ;;
	*) exit 0 ;;
esac

dev="$DEVICENAME"

(
	# A net hotplug add event can arrive before netifd enslaves the VAP to
	# br-lan. This is especially common while the three QCN9274 radios start.
	tries=15
	while [ ! -d "/sys/class/net/$dev/brport" ] && [ "$tries" -gt 0 ]; do
		sleep 1
		tries=$((tries - 1))
	done
	[ -d "/sys/class/net/$dev/brport" ] || exit 0

	exec 9>/var/lock/fw4-ppe-vap-reload.lock
	# Serialize events instead of dropping a later VAP while an earlier VAP
	# reload is in progress. Each waiter verifies its own interface afterwards.
	flock 9 || exit 0

	# netifd can publish the bridge member just after the net hotplug event.
	# Verify both the rendered VAP and hardware-offload flag. A VAP can be
	# present in a temporarily software-only table while ath12k direct-switch
	# setup is still settling; keep retrying in that case.
	tries=10
	while [ "$tries" -gt 0 ]; do
		if nft list flowtable inet fw4 ft 2>/dev/null | grep -Fq "$dev" &&
		   nft list flowtable inet fw4 ft 2>/dev/null | grep -Fq 'flags offload'; then
			exit 0
		fi
		/etc/init.d/firewall reload >/dev/null 2>&1 || true
		sleep 1
		tries=$((tries - 1))
	done
) &

exit 0
