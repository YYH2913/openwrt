#!/bin/sh

section()
{
	printf '\n=== %s ===\n' "$1"
}

show_file()
{
	if [ -r "$1" ]; then
		cat "$1"
	else
		printf 'unavailable: %s\n' "$1"
	fi
}

show_named_file()
{
	printf '\n-- %s --\n' "$1"
	show_file "$2"
}

show_ppe_counters()
{
	show_named_file cpu_code /sys/kernel/debug/ppe/cpu_code
	show_named_file port_rx /sys/kernel/debug/ppe/port_rx
	show_named_file port_tx /sys/kernel/debug/ppe/port_tx
	show_named_file edma_err_stats /sys/kernel/debug/ppe/edma/stats/err_stats
	show_named_file edma_rx_ring_stats /sys/kernel/debug/ppe/edma/stats/rx_ring_stats
	show_named_file edma_tx_ring_stats /sys/kernel/debug/ppe/edma/stats/tx_ring_stats
}

section SYSTEM
ubus call system board 2>/dev/null || true
uname -a

section CONFIG
printf 'flow_offloading=%s\n' "$(uci -q get firewall.@defaults[0].flow_offloading || printf missing)"
printf 'flow_offloading_hw=%s\n' "$(uci -q get firewall.@defaults[0].flow_offloading_hw || printf missing)"

section MODULES
if command -v lsmod >/dev/null 2>&1; then
	lsmod | grep -E '(^| )qcom_ppe|nf_flow_table|nft_flow_offload|nft_flow_table' || true
else
	printf 'unavailable: lsmod\n'
fi

section PPEDS_ABI
if [ -r /proc/kallsyms ]; then
	if grep -qw qcom_ppe_ds_start /proc/kallsyms; then
		printf 'qcom_ppe_ds_start=present\n'
	else
		printf 'qcom_ppe_ds_start=missing\n'
	fi
	if grep -qw qcom_ppe_ds_vp_alloc /proc/kallsyms; then
		printf 'qcom_ppe_ds_vp_alloc=present\n'
	else
		printf 'qcom_ppe_ds_vp_alloc=missing\n'
	fi
	if grep -qw qcom_ppe_ds_queue_start /proc/kallsyms; then
		printf 'legacy_qcom_ppe_ds_queue_start=present\n'
	else
		printf 'legacy_qcom_ppe_ds_queue_start=absent\n'
	fi
else
	printf 'unavailable: /proc/kallsyms\n'
fi

section FW4
if command -v fw4 >/dev/null 2>&1; then
	fw4 print 2>&1
else
	printf 'unavailable: fw4\n'
fi

section FLOWTABLE
if command -v nft >/dev/null 2>&1; then
	nft list flowtable inet fw4 ft 2>&1
else
	printf 'unavailable: nft\n'
fi

section NFT
if command -v nft >/dev/null 2>&1; then
	nft list ruleset 2>&1
else
	printf 'unavailable: nft\n'
fi

section INTERFACES
ip address show 2>&1

section NETDEV_STATE
for path in /sys/class/net/*; do
	[ -e "$path" ] || continue
	dev=${path##*/}
	master=$(readlink "$path/master" 2>/dev/null)
	master=${master##*/}
	[ -n "$master" ] || master=none
	printf '\n-- %s --\n' "$dev"
	printf 'address=%s carrier=%s operstate=%s mtu=%s master=%s\n' \
		"$(cat "$path/address" 2>/dev/null || printf unknown)" \
		"$(cat "$path/carrier" 2>/dev/null || printf unknown)" \
		"$(cat "$path/operstate" 2>/dev/null || printf unknown)" \
		"$(cat "$path/mtu" 2>/dev/null || printf unknown)" \
		"$master"
done

section BRIDGE
if command -v bridge >/dev/null 2>&1; then
	bridge link show 2>&1
	bridge fdb show 2>&1
else
	printf 'unavailable: bridge\n'
	for path in /sys/class/net/*/brport; do
		[ -d "$path" ] || continue
		dev=${path%/brport}
		dev=${dev##*/}
		printf '%s state=%s hairpin=%s isolated=%s\n' "$dev" \
			"$(cat "$path/state" 2>/dev/null || printf unknown)" \
			"$(cat "$path/hairpin_mode" 2>/dev/null || printf unknown)" \
			"$(cat "$path/isolated" 2>/dev/null || printf unknown)"
	done
fi

section QDISC
if command -v tc >/dev/null 2>&1; then
	tc -s qdisc show 2>&1
else
	printf 'unavailable: tc\n'
fi

section LINKS
for path in /sys/class/net/*/speed; do
	[ -r "$path" ] || continue
	dev=${path%/speed}
	dev=${dev##*/}
	printf '\n-- %s --\n' "$dev"
	if [ -r "/sys/class/net/$dev/carrier" ]; then
		printf 'carrier=%s speed=%s duplex=%s\n' \
			"$(cat "/sys/class/net/$dev/carrier")" \
			"$(cat "/sys/class/net/$dev/speed" 2>/dev/null || printf unknown)" \
			"$(cat "/sys/class/net/$dev/duplex" 2>/dev/null || printf unknown)"
	fi
	if command -v ethtool >/dev/null 2>&1; then
		ethtool "$dev" 2>&1
	else
		printf 'unavailable: ethtool\n'
	fi
done

if ! grep -qs ' /sys/kernel/debug debugfs ' /proc/mounts; then
	mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true
fi

section DIRECT_SWITCH_BEFORE
show_file /sys/kernel/debug/ppe/direct_switch

section VIRTUAL_PORTS_BEFORE
show_file /sys/kernel/debug/ppe/virtual_ports

section FLOWS_BEFORE
show_file /sys/kernel/debug/ppe/flows

section PPE_COUNTERS_BEFORE
show_ppe_counters

section SOFTIRQS_BEFORE
grep -E 'NET_RX|NET_TX' /proc/softirqs 2>/dev/null || true

sleep 5

section DIRECT_SWITCH_AFTER
show_file /sys/kernel/debug/ppe/direct_switch

section VIRTUAL_PORTS_AFTER
show_file /sys/kernel/debug/ppe/virtual_ports

section FLOWS_AFTER
show_file /sys/kernel/debug/ppe/flows

section PPE_COUNTERS_AFTER
show_ppe_counters

section SOFTIRQS_AFTER
grep -E 'NET_RX|NET_TX' /proc/softirqs 2>/dev/null || true

section FLOW_ROWS
show_file /sys/kernel/debug/ppe/flow_rows

section PIPELINE
show_file /sys/kernel/debug/ppe/pipeline_state

section REASONS
show_file /sys/kernel/debug/ppe/reason_counters

section CONNTRACK
if [ -r /proc/net/nf_conntrack ]; then
	printf 'HW_OFFLOAD=%s\n' "$(grep -c '\[HW_OFFLOAD\]' /proc/net/nf_conntrack)"
	printf 'OFFLOAD=%s\n' "$(grep -c '\[OFFLOAD\]' /proc/net/nf_conntrack)"
else
	printf 'unavailable: /proc/net/nf_conntrack\n'
fi

section INTERRUPTS
grep -Ei 'ppe|edma|reo2ppe|ppe2tcl|rxfill|txcmpl' /proc/interrupts 2>/dev/null || true

section PROCESSES
ps w 2>&1 | grep -E '[d]nsmasq|[h]ostapd|[n]etifd|[o]dhcpd' || true

section DHCP_CONFIG
uci -q show dhcp 2>&1 || true

section WIRELESS_CONFIG
uci -q show wireless 2>&1 || true

section LOG
if command -v logread >/dev/null 2>&1; then
	logread 2>&1 | grep -Ei 'dhcp|dnsmasq|hostapd|sta-|associated|authorized|qcom_ppe|ppe direct|ppe-ds|ath12k.*ppe|reo2ppe|ppe2tcl|rxfill|txcmpl|usxgmii|10gbase|link is' | tail -n 500
else
	dmesg | grep -Ei 'qcom_ppe|ppe direct|ppe-ds|ath12k.*ppe|reo2ppe|ppe2tcl|rxfill|txcmpl|usxgmii|10gbase|link is' | tail -n 300
fi
