#!/bin/sh

. /lib/functions.sh
. /lib/functions/system.sh

[ "$(board_name)" = "gemtek,xr1710g-ubi" ] || exit 0

migrated=0
legacy_names=0
migration_failed=0

xr1710g_uci() {
	uci "$@" || {
		migration_failed=1
		return 1
	}
}

detect_xr1710g_legacy_names() {
	local config="$1"
	local option values value

	for option in name device ports ifname; do
		config_get values "$config" "$option"
		for value in $values; do
			case "$value" in
			eth0|eth0.1|eth0.2|eth0.8|\
			eth1|eth1.*|eth1:*|eth2|eth2.*|eth2:*|\
			ae_wan|ae_wan.*|ae_wan:*|lan1|lan1.*|lan1:*)
				legacy_names=1
				;;
			esac
		done
	done
}

normalize_xr1710g_netdev() {
	local value="$1"
	local base="${value%%[.:]*}"
	local suffix="${value#"$base"}"

	[ "$legacy_names" -eq 1 ] || {
		printf '%s' "$value"
		return
	}

	# Transform the old physical layout once, not successive substitutions:
	# eth2 (10G) -> lan2; old lan2/lan3 (1G) -> lan3/lan4.
	case "$base" in
	ae_wan|eth0|eth1) base=wan ;;
	eth2|lan1) base=lan2 ;;
	lan2) base=lan3 ;;
	lan3) base=lan4 ;;
	esac
	printf '%s%s' "$base" "$suffix"
}

migrate_xr1710g_list() {
	local config="$1"
	local option="$2"
	local value values normalized new_values="" changed=0

	config_get values "$config" "$option"
	[ -n "$values" ] || return 0

	for value in $values; do
		normalized="$(normalize_xr1710g_netdev "$value")"
		[ "$normalized" = "$value" ] || changed=1
		new_values="${new_values}${new_values:+ }$normalized"
	done

	[ "$changed" -eq 1 ] || return 0

	xr1710g_uci -q delete "network.$config.$option"
	for value in $new_values; do
		xr1710g_uci add_list "network.$config.$option=$value"
	done
	migrated=1
}

migrate_xr1710g_words() {
	local config="$1"
	local option="$2"
	local value values normalized new_values="" changed=0

	config_get values "$config" "$option"
	[ -n "$values" ] || return 0

	for value in $values; do
		normalized="$(normalize_xr1710g_netdev "$value")"
		[ "$normalized" = "$value" ] || changed=1
		new_values="${new_values}${new_values:+ }$normalized"
	done

	[ "$changed" -eq 1 ] || return 0

	xr1710g_uci set "network.$config.$option=$new_values"
	migrated=1
}

migrate_xr1710g_device() {
	local config="$1"
	local name type ports ifname normalized

	config_get type "$config" type
	config_get name "$config" name
	config_get ports "$config" ports
	config_get ifname "$config" ifname

	if [ "$type" = "bridge" ] && [ "$name" = "br-lan" ]; then
		case " $ports $ifname " in
		*" eth0.8 "*|*" eth0.1 "*|*" eth0.2 "*)
			uci -q delete "network.$config.ifname"
			uci -q delete "network.$config.ports"
			xr1710g_uci add_list "network.$config.ports=lan2"
			xr1710g_uci add_list "network.$config.ports=lan3"
			xr1710g_uci add_list "network.$config.ports=lan4"
			migrated=1
			return 0
			;;
		esac
	fi

	normalized="$(normalize_xr1710g_netdev "$name")"
	if [ -n "$name" ] && [ "$normalized" != "$name" ]; then
		xr1710g_uci set "network.$config.name=$normalized"
		migrated=1
	fi

	migrate_xr1710g_list "$config" ports
	migrate_xr1710g_words "$config" ifname
}

migrate_xr1710g_interface() {
	local config="$1"
	local device normalized

	config_get device "$config" device
	normalized="$(normalize_xr1710g_netdev "$device")"

	if [ -n "$device" ] && [ "$normalized" != "$device" ]; then
		xr1710g_uci set "network.$config.device=$normalized"
		migrated=1
	fi

	migrate_xr1710g_words "$config" ifname
}

set_xr1710g_wan_clientid_default() {
	local clientid proto sendclientid

	config_get proto wan proto
	[ "$proto" = "dhcp" ] || return 0

	config_get clientid wan clientid
	config_get sendclientid wan sendclientid
	[ -z "$clientid" ] || return 0

	case "$sendclientid" in
	''|none)
		# "none" suppresses option 61; "hardware" keeps the MAC-based ID.
		xr1710g_uci set network.wan.sendclientid='hardware'
		;;
	*)
		return 0
		;;
	esac
	migrated=1
}

config_load network
config_get port_names globals xr1710g_port_names
[ "$port_names" = "pr26296" ] && exit 0

config_foreach detect_xr1710g_legacy_names device
config_foreach detect_xr1710g_legacy_names interface
config_foreach detect_xr1710g_legacy_names bridge-vlan
config_foreach migrate_xr1710g_device device
config_foreach migrate_xr1710g_interface interface
config_foreach migrate_xr1710g_list bridge-vlan ports
set_xr1710g_wan_clientid_default

# A saved PR-style configuration must not have its lan2/lan3 shifted again.
uci -q get network.globals >/dev/null || xr1710g_uci set network.globals=globals
xr1710g_uci set network.globals.xr1710g_port_names='pr26296'

[ "$migration_failed" -eq 0 ] || {
	uci -q revert network
	logger -t xr1710g-network 'Port name migration failed; configuration unchanged'
	exit 1
}

uci commit network || exit 1

exit 0
