From: OpenWrt XPON integration
Subject: [PATCH] net: pcs: airoha: verify the XPON mode profile

The EN7581 SDK gives 10G/1G EPON a different receive-front-end profile from
the three other 10G PON modes.  Program that distinction instead of leaving
the receive gain at the generic SerDes value.

Do not publish PMA readiness merely because bringup returned.  Read back the
SDK-defining clock, transmit-rate, delay, receive-window and receive-front-end
registers first.  A missing or stale write then leaves the shared PCS
quiesced, allowing the runtime XPON transaction to restore the old mode while
optical TX remains disabled.

--- a/drivers/net/pcs/airoha/pcs-an7581.c
+++ b/drivers/net/pcs/airoha/pcs-an7581.c
@@ -1196,6 +1196,7 @@ static void an7581_pcs_rx_bringup(struct
 	bool cdr_pr_cap_en;
 	u32 sigdet_vth_sel;
 	u32 rx_rate_ctrl;
+	u32 rx_fe_gain_ctrl, rx_rev_0;
 	u32 xfi_rx_mode;
 	u32 osr;
 
@@ -1213,6 +1214,14 @@ static void an7581_pcs_rx_bringup(struct
 		sigdet_vth_sel = downstream_10g ?
 				   BIT(1) : BIT(2) | BIT(1);
 		phyck_div = 0x0;
+		if (priv->pon_mode == AIROHA_PCS_PON_MODE_GPON ||
+		    priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_10G_1G) {
+			rx_fe_gain_ctrl = 0x3;
+			rx_rev_0 = 0x18b0;
+		} else {
+			rx_fe_gain_ctrl = 0x1;
+			rx_rev_0 = 0x1030;
+		}
 		phyck_sel = 0x0;
 		xfi_rx_mode = downstream_10g ?
 			      AIROHA_PCS_PMA_XFI_RX_MODE_10G3 :
@@ -1228,6 +1236,8 @@ static void an7581_pcs_rx_bringup(struct
 			phyck_div = BIT(5) | BIT(3) | BIT(0);
 			phyck_sel = BIT(0);
 			xfi_rx_mode = AIROHA_PCS_PMA_XFI_TX_MODE_1G25;
+			rx_fe_gain_ctrl = 0x0;
+			rx_rev_0 = 0x0;
 			break;
 		case PHY_INTERFACE_MODE_2500BASEX:
 			osr = BIT(0); /* 2.5G */
@@ -1240,6 +1250,8 @@ static void an7581_pcs_rx_bringup(struct
 			phyck_div = BIT(3) | BIT(1) | BIT(0);
 			phyck_sel = BIT(0);
 			xfi_rx_mode = AIROHA_PCS_PMA_XFI_RX_MODE_3G12;
+			rx_fe_gain_ctrl = 0x0;
+			rx_rev_0 = 0x0;
 			break;
 		case PHY_INTERFACE_MODE_USXGMII:
 		case PHY_INTERFACE_MODE_10GBASER:
@@ -1253,6 +1265,8 @@ static void an7581_pcs_rx_bringup(struct
 			phyck_div = BIT(6) | BIT(1);
 			phyck_sel = BIT(1);
 			xfi_rx_mode = AIROHA_PCS_PMA_XFI_RX_MODE_10G3;
+			rx_fe_gain_ctrl = 0x0;
+			rx_rev_0 = 0x0;
 			break;
 		default:
 			return;
@@ -1353,7 +1367,14 @@ static void an7581_pcs_rx_bringup(struct
 	regmap_update_bits(pcs_pma, AIROHA_PCS_PMA_PXP_FE_GAIN_CTRL,
 			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_FE_GAIN_CTRL |
 			   AIROHA_PCS_PMA_FORCE_DA_RX_FE_GAIN_CTRL,
-			   FIELD_PREP(AIROHA_PCS_PMA_FORCE_DA_RX_FE_GAIN_CTRL, 0x0));
+			   (priv->pon_mode != AIROHA_PCS_PON_MODE_NONE ?
+			    AIROHA_PCS_PMA_FORCE_SEL_DA_RX_FE_GAIN_CTRL : 0) |
+			   FIELD_PREP(AIROHA_PCS_PMA_FORCE_DA_RX_FE_GAIN_CTRL,
+				      rx_fe_gain_ctrl));
+	if (priv->pon_mode != AIROHA_PCS_PON_MODE_NONE)
+		regmap_update_bits(priv->pcs_ana, AIROHA_PCS_ANA_PXP_RX_REV_0,
+				   AIROHA_PCS_ANA_RX_REV_0,
+				   FIELD_PREP(AIROHA_PCS_ANA_RX_REV_0, rx_rev_0));
 
 	regmap_update_bits(pcs_pma, AIROHA_PCS_PMA_PXP_JCPLL_SDM_SCAN,
 			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_FE_PEAKING_CTRL |
--- a/drivers/net/pcs/airoha/pcs-airoha-common.c
+++ b/drivers/net/pcs/airoha/pcs-airoha-common.c
@@ -1110,6 +1110,172 @@ static enum airoha_pcs_xpon_mode
 	}
 }
 
+struct airoha_pcs_xpon_profile {
+	u32 txpll_pcw;
+	u32 hrdds_pcw;
+	u32 tx_rate_ctrl;
+	u32 ckin_divisor;
+	u32 tx_delay_ben;
+	u32 tx_delay_data;
+	u32 rx_target_begin;
+	u32 rx_target_end;
+	u32 rx_fe_gain_ctrl;
+	u32 rx_rev_0;
+};
+
+static int
+airoha_pcs_xpon_profile(enum airoha_pcs_pon_mode mode,
+			 struct airoha_pcs_xpon_profile *profile)
+{
+	profile->txpll_pcw = 0x07f66e86;
+	profile->hrdds_pcw = 0x0fecdd0c;
+	profile->rx_target_begin = 0xa436;
+	profile->rx_target_end = 0xa4ff;
+	profile->rx_fe_gain_ctrl = 0x1;
+	profile->rx_rev_0 = 0x1030;
+
+	switch (mode) {
+	case AIROHA_PCS_PON_MODE_GPON:
+		profile->tx_rate_ctrl = 0x0;
+		profile->ckin_divisor = 0x2;
+		profile->tx_delay_ben = 0x0;
+		profile->tx_delay_data = 0x4;
+		profile->rx_fe_gain_ctrl = 0x3;
+		profile->rx_rev_0 = 0x18b0;
+		break;
+	case AIROHA_PCS_PON_MODE_XGPON:
+		profile->tx_rate_ctrl = 0x0;
+		profile->ckin_divisor = 0x3;
+		profile->tx_delay_ben = 0x0;
+		profile->tx_delay_data = 0x8;
+		break;
+	case AIROHA_PCS_PON_MODE_XGSPON:
+		profile->tx_rate_ctrl = 0x2;
+		profile->ckin_divisor = 0x5;
+		profile->tx_delay_ben = 0xd;
+		profile->tx_delay_data = 0x30;
+		break;
+	case AIROHA_PCS_PON_MODE_EPON_10G_1G:
+		profile->txpll_pcw = 0x08400000;
+		profile->hrdds_pcw = 0x10800000;
+		profile->tx_rate_ctrl = 0x1;
+		profile->ckin_divisor = 0x1;
+		profile->tx_delay_ben = 0x2;
+		profile->tx_delay_data = 0x6;
+		profile->rx_target_begin = 0x9e7a;
+		profile->rx_target_end = 0x9f43;
+		profile->rx_fe_gain_ctrl = 0x3;
+		profile->rx_rev_0 = 0x18b0;
+		break;
+	case AIROHA_PCS_PON_MODE_EPON_10G_10G:
+		profile->txpll_pcw = 0x08400000;
+		profile->hrdds_pcw = 0x10800000;
+		profile->tx_rate_ctrl = 0x2;
+		profile->ckin_divisor = 0x5;
+		profile->tx_delay_ben = 0xd;
+		profile->tx_delay_data = 0x30;
+		profile->rx_target_begin = 0x9e7a;
+		profile->rx_target_end = 0x9f43;
+		break;
+	case AIROHA_PCS_PON_MODE_NONE:
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int airoha_pcs_xpon_verify_register(struct regmap *map, u32 reg,
+					    u32 mask, u32 expected)
+{
+	u32 value;
+	int ret;
+
+	ret = regmap_read(map, reg, &value);
+	if (ret)
+		return ret;
+
+	return (value & mask) == expected ? 0 : -EIO;
+}
+
+static int
+airoha_pcs_xpon_verify_mode(struct airoha_pcs_priv *priv, int index,
+			    enum airoha_pcs_pon_mode mode)
+{
+	struct airoha_pcs_xpon_profile profile;
+	struct regmap *pma = priv->pcs_pma[index];
+	u32 mask, expected;
+	int ret;
+
+	ret = airoha_pcs_xpon_profile(mode, &profile);
+	if (ret)
+		return ret;
+
+#define AIROHA_XPON_VERIFY(_map, _reg, _mask, _expected) do { \
+	ret = airoha_pcs_xpon_verify_register((_map), (_reg), (_mask), \
+					       (_expected)); \
+	if (ret) \
+		return ret; \
+} while (0)
+
+	AIROHA_XPON_VERIFY(pma, AIROHA_PCS_PMA_PXP_TXPLL_SDM_PCW,
+		AIROHA_PCS_PMA_FORCE_DA_TXPLL_SDM_PCW,
+		profile.txpll_pcw);
+	AIROHA_XPON_VERIFY(pma, AIROHA_PCS_PMA_LCPLL_TDC_PCW_1,
+		AIROHA_PCS_PMA_LCPLL_PON_HRDDS_PCW_NCPO_GPON,
+		profile.hrdds_pcw);
+	AIROHA_XPON_VERIFY(pma, AIROHA_PCS_PMA_LCPLL_TDC_PCW_2,
+		AIROHA_PCS_PMA_LCPLL_PON_HRDDS_PCW_NCPO_EPON,
+		profile.hrdds_pcw);
+	mask = AIROHA_PCS_PMA_PON_TX_RATE_CTRL;
+	expected = FIELD_PREP(mask, profile.tx_rate_ctrl);
+	AIROHA_XPON_VERIFY(pma, AIROHA_PCS_PMA_XPON_TX_RATE_CTRL,
+		mask, expected);
+	mask = AIROHA_PCS_PMA_FORCE_SEL_DA_TX_CKIN_DIVISOR |
+	       AIROHA_PCS_PMA_FORCE_DA_TX_CKIN_DIVISOR;
+	expected = AIROHA_PCS_PMA_FORCE_SEL_DA_TX_CKIN_DIVISOR |
+		   FIELD_PREP(AIROHA_PCS_PMA_FORCE_DA_TX_CKIN_DIVISOR,
+			      profile.ckin_divisor);
+	AIROHA_XPON_VERIFY(pma, AIROHA_PCS_PMA_PXP_TX_TERM_SEL,
+		mask, expected);
+	mask = AIROHA_PCS_PMA_TX_DLY_BEN_FTUNE |
+	       AIROHA_PCS_PMA_TX_DLY_DATA_FTUNE;
+	expected = FIELD_PREP(AIROHA_PCS_PMA_TX_DLY_BEN_FTUNE,
+			      profile.tx_delay_ben) |
+		   FIELD_PREP(AIROHA_PCS_PMA_TX_DLY_DATA_FTUNE,
+			      profile.tx_delay_data);
+	AIROHA_XPON_VERIFY(pma, AIROHA_PCS_PMA_TX_DLY_CTRL, mask, expected);
+	mask = AIROHA_PCS_PMA_LOCK_TARGET_END |
+	       AIROHA_PCS_PMA_LOCK_TARGET_BEG;
+	expected = FIELD_PREP(AIROHA_PCS_PMA_LOCK_TARGET_END,
+			      profile.rx_target_end) |
+		   FIELD_PREP(AIROHA_PCS_PMA_LOCK_TARGET_BEG,
+			      profile.rx_target_begin);
+	AIROHA_XPON_VERIFY(pma, AIROHA_PCS_PMA_SS_RX_FREQ_DET_2,
+		mask, expected);
+	mask = AIROHA_PCS_PMA_UNLOCK_TARGET_END |
+	       AIROHA_PCS_PMA_UNLOCK_TARGET_BEG;
+	expected = FIELD_PREP(AIROHA_PCS_PMA_UNLOCK_TARGET_END,
+			      profile.rx_target_end) |
+		   FIELD_PREP(AIROHA_PCS_PMA_UNLOCK_TARGET_BEG,
+			      profile.rx_target_begin);
+	AIROHA_XPON_VERIFY(pma, AIROHA_PCS_PMA_SS_RX_FREQ_DET_3,
+		mask, expected);
+	mask = AIROHA_PCS_PMA_FORCE_SEL_DA_RX_FE_GAIN_CTRL |
+	       AIROHA_PCS_PMA_FORCE_DA_RX_FE_GAIN_CTRL;
+	expected = AIROHA_PCS_PMA_FORCE_SEL_DA_RX_FE_GAIN_CTRL |
+		   FIELD_PREP(AIROHA_PCS_PMA_FORCE_DA_RX_FE_GAIN_CTRL,
+			      profile.rx_fe_gain_ctrl);
+	AIROHA_XPON_VERIFY(pma, AIROHA_PCS_PMA_PXP_FE_GAIN_CTRL,
+		mask, expected);
+	expected = FIELD_PREP(AIROHA_PCS_ANA_RX_REV_0, profile.rx_rev_0);
+	AIROHA_XPON_VERIFY(priv->pcs_ana, AIROHA_PCS_ANA_PXP_RX_REV_0,
+		AIROHA_PCS_ANA_RX_REV_0, expected);
+
+#undef AIROHA_XPON_VERIFY
+	return 0;
+}
+
 static int airoha_pcs_xpon_wan_sel(enum airoha_pcs_pon_mode mode,
 				    u32 *wan_sel)
 {
@@ -1274,8 +1440,10 @@ int airoha_pcs_xpon_set_mode(struct phyl
 	priv->pon_pma_ready = false;
 	ret = priv->data->bringup(priv, port->index,
 		priv->interface == PHY_INTERFACE_MODE_NA ?
-		PHY_INTERFACE_MODE_2500BASEX : priv->interface);
+		PHY_INTERFACE_MODE_2500BASEX : priv->interface);
+	if (!ret)
+		ret = airoha_pcs_xpon_verify_mode(priv, port->index, internal);
 	if (!ret)
 		priv->pon_pma_ready = true;
 unlock:
 	mutex_unlock(&priv->recovery_lock);
