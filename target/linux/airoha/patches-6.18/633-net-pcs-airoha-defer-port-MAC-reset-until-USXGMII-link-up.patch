From 3431fc8df46d83dcc13c0c76e835a8650adb4599 Mon Sep 17 00:00:00 2001
From: Yanghan Ye <yyh94306@gmail.com>
Date: Sun, 11 Oct 2026 04:56:43 -0700
Subject: [PATCH] net: pcs: airoha: defer pending port MAC reset until USXGMII
 link up

A MAC logic reset at link-down can precede several seconds of copper
renegotiation. A cold-boot XR1710G test still reproduced the one-way
failure after that sequence, despite correct PHY/PCS speed registers.

Mark the reset pending only for a previously running AN7581 Ethernet
USXGMII port. Apply the existing local reset after the next resolved
speed has been programmed, while MPI/MBI remain stopped, and then open
the interfaces. Preserve pending state across repeated link-down calls
and clear it when pre_config has already reset and reinitialized the
port. Initial link-up does not get an additional reset.

This is a private hardware-validation candidate. It changes only the
phase of the port MAC reset, without touching PHY, AN, PMA, PLL, bit7
fault policy, MAC counters or shared DMA resets.

Assisted-by: Codex:GPT-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 drivers/net/pcs/airoha/pcs-airoha-common.c | 45 +++++++++++++---------
 drivers/net/pcs/airoha/pcs-airoha.h        |  1 +
 2 files changed, 27 insertions(+), 19 deletions(-)

diff --git a/drivers/net/pcs/airoha/pcs-airoha-common.c b/drivers/net/pcs/airoha/pcs-airoha-common.c
index 9a34319..a520dc8 100644
--- a/drivers/net/pcs/airoha/pcs-airoha-common.c
+++ b/drivers/net/pcs/airoha/pcs-airoha-common.c
@@ -987,6 +987,7 @@ static void airoha_pcs_link_up(struct phylink_pcs *pcs, unsigned int neg_mode,
 	const struct airoha_pcs_match_data *data;
 	struct airoha_pcs_maps *maps;
 	int ret = 0;
+	u32 cfg;
 
 	maps = &priv->maps[port->index];
 	data = priv->data;
@@ -1031,6 +1032,28 @@ static void airoha_pcs_link_up(struct phylink_pcs *pcs, unsigned int neg_mode,
 	if (data->link_up)
 		data->link_up(priv, port->index);
 
+	if (port->mac_reset_pending && !ret &&
+	    interface == PHY_INTERFACE_MODE_USXGMII) {
+		regmap_set_bits(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG,
+				AIROHA_PCS_XFI_RXMPI_STOP |
+				AIROHA_PCS_XFI_RXMBI_STOP |
+				AIROHA_PCS_XFI_TXMPI_STOP |
+				AIROHA_PCS_XFI_TXMBI_STOP);
+		if (!regmap_read(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG, &cfg)) {
+			/* Copper negotiation can outlast link-down. Reset the port
+			 * MAC only after the next resolved speed has been applied.
+			 */
+			usleep_range(1000, 2000);
+			regmap_clear_bits(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_LOGIC_RST,
+					  AIROHA_PCS_XFI_MAC_LOGIC_RST);
+			regmap_set_bits(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_LOGIC_RST,
+					AIROHA_PCS_XFI_MAC_LOGIC_RST);
+			usleep_range(1000, 2000);
+			regmap_write(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG, cfg);
+			port->mac_reset_pending = false;
+		}
+	}
+
 	/* BPI BMI enable */
 	regmap_clear_bits(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG,
 			  AIROHA_PCS_XFI_RXMPI_STOP |
@@ -1048,13 +1071,14 @@ static void airoha_pcs_link_down(struct phylink_pcs *pcs)
 	struct airoha_pcs_priv *priv = port->priv;
 	struct airoha_pcs_maps *maps;
 	bool reset_mac;
-	u32 cfg;
 
 	maps = &priv->maps[port->index];
 	reset_mac = port->initialized &&
 		    port->interface == PHY_INTERFACE_MODE_USXGMII &&
 		    READ_ONCE(port->usxgmii_speed) != SPEED_UNKNOWN &&
 		    device_is_compatible(priv->dev, "airoha,an7581-pcs-eth");
+	if (reset_mac)
+		port->mac_reset_pending = true;
 	WRITE_ONCE(port->usxgmii_speed, SPEED_UNKNOWN);
 
 	/* MPI MBI disable */
@@ -1064,24 +1088,6 @@ static void airoha_pcs_link_down(struct phylink_pcs *pcs)
 			AIROHA_PCS_XFI_TXMPI_STOP |
 			AIROHA_PCS_XFI_TXMBI_STOP);
 
-	if (!reset_mac)
-		return;
-
-	if (regmap_read(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG, &cfg))
-		return;
-
-	/* Flush the port MAC logic after stopping its interfaces, as in the
-	 * AN7581 SDK link-down hook. Leave PHY/PCS negotiation and PLLs alone.
-	 */
-	usleep_range(1000, 2000);
-	regmap_clear_bits(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_LOGIC_RST,
-			  AIROHA_PCS_XFI_MAC_LOGIC_RST);
-	regmap_set_bits(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_LOGIC_RST,
-			AIROHA_PCS_XFI_MAC_LOGIC_RST);
-	usleep_range(1000, 2000);
-
-	/* Keep configuration and stop state until the next link-up. */
-	regmap_write(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG, cfg);
 }
 
 static void airoha_pcs_pre_config(struct phylink_pcs *pcs,
@@ -1093,6 +1099,7 @@ static void airoha_pcs_pre_config(struct phylink_pcs *pcs,
 
 	maps = &priv->maps[port->index];
 	port->initialized = false;
+	port->mac_reset_pending = false;
 	WRITE_ONCE(port->usxgmii_speed, SPEED_UNKNOWN);
 
 	/* Select HSGMII or USXGMII in SCU regs */
diff --git a/drivers/net/pcs/airoha/pcs-airoha.h b/drivers/net/pcs/airoha/pcs-airoha.h
index 0be3c4b..eabeb00 100644
--- a/drivers/net/pcs/airoha/pcs-airoha.h
+++ b/drivers/net/pcs/airoha/pcs-airoha.h
@@ -1675,6 +1675,7 @@ struct airoha_pcs_port {
 	phy_interface_t interface;
 	bool initialized;
 	int usxgmii_speed;
+	bool mac_reset_pending;
 
 	struct phylink_pcs pcs;
 };
-- 
