From d6b07d31678f4bb07ea25e5659f09958c0ced3c1 Mon Sep 17 00:00:00 2001
From: Yanghan Ye <yyh94306@gmail.com>
Date: Thu, 6 Aug 2026 13:28:11 +0800
Subject: [PATCH] net: airoha: npu: recover stalled firmware cores

The NPU watchdog currently captures a coredump but leaves the affected
firmware core stalled. Any mailbox user then waits for the full timeout,
and wireless offload cannot recover without rebooting the system.

Port the recovery sequence from the Airoha vendor SDK heartbeat monitor in
private/npu/host/npu_rv32.c. Preserve the enabled-core mask, set the reboot
bit for the affected core, and trigger the reboot twice with a 100 ms delay
to clear possible stale bus state. Set MIB0 to all ones before restarting
core 0 so firmware preserves BSS, PLIC and timer state, as required by the
SDK implementation.

Serialize recovery and reject mailbox requests while it is running. Always
attempt recovery after a watchdog interrupt even if coredump allocation
fails, and expose a synchronous core 0 recovery helper to NPU consumers.

Assisted-by: Codex:gpt-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_npu.c  | 77 ++++++++++++++++++++---
 include/linux/soc/airoha/airoha_offload.h | 10 +++
 2 files changed, 77 insertions(+), 10 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_npu.c b/drivers/net/ethernet/airoha/airoha_npu.c
index b58e478..63f3b2d 100644
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -174,6 +174,10 @@ static int airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 		return ret;
 
 	spin_lock_bh(&npu->cores[core].lock);
+	if (npu->recovering) {
+		ret = -EAGAIN;
+		goto unlock;
+	}
 
 	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(0) + offset, dma_addr);
 	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(1) + offset, size);
@@ -189,6 +193,7 @@ static int airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 	if (!ret && FIELD_GET(MBOX_MSG_STATUS, val) != NPU_MBOX_SUCCESS)
 		ret = -EINVAL;
 
+unlock:
 	spin_unlock_bh(&npu->cores[core].lock);
 
 	dma_unmap_single(npu->dev, dma_addr, size, DMA_BIDIRECTIONAL);
@@ -290,6 +295,54 @@ static irqreturn_t airoha_npu_mbox_handler(int irq, void *npu_instance)
 	return IRQ_HANDLED;
 }
 
+static int airoha_npu_restart_core(struct airoha_npu *npu, int core)
+{
+	int i, err = 0;
+	u32 val;
+
+	if (core < 0 || core >= ARRAY_SIZE(npu->cores))
+		return -EINVAL;
+
+	mutex_lock(&npu->recovery_lock);
+
+	spin_lock_bh(&npu->cores[0].lock);
+	npu->recovering = true;
+	err = regmap_read(npu->regmap, REG_CR_BOOT_CONFIG, &val);
+	spin_unlock_bh(&npu->cores[0].lock);
+	if (err)
+		goto out;
+
+	val = (val & GENMASK(7, 0)) | BIT(8 + core);
+	for (i = 0; i < 2; i++) {
+		spin_lock_bh(&npu->cores[0].lock);
+		err = regmap_write(npu->regmap, REG_CR_BOOT_CONFIG, val);
+		if (!err && !core)
+			err = regmap_write(npu->regmap, REG_CR_NPU_MIB(0),
+					   U32_MAX);
+		if (!err)
+			err = regmap_write(npu->regmap, REG_CR_BOOT_TRIGGER, 2);
+		spin_unlock_bh(&npu->cores[0].lock);
+		if (err)
+			break;
+
+		msleep(100);
+	}
+
+out:
+	spin_lock_bh(&npu->cores[0].lock);
+	npu->recovering = false;
+	spin_unlock_bh(&npu->cores[0].lock);
+	mutex_unlock(&npu->recovery_lock);
+
+	return err;
+}
+
+int airoha_npu_recover(struct airoha_npu *npu)
+{
+	return airoha_npu_restart_core(npu, 0);
+}
+EXPORT_SYMBOL_GPL(airoha_npu_recover);
+
 static void airoha_npu_wdt_work(struct work_struct *work)
 {
 	struct airoha_npu_core *core;
@@ -301,16 +354,20 @@ static void airoha_npu_wdt_work(struct work_struct *work)
 	core = container_of(work, struct airoha_npu_core, wdt_work);
 	npu = core->npu;
 
-	dump = vzalloc(NPU_DUMP_SIZE);
-	if (!dump)
-		return;
-
 	c = core - &npu->cores[0];
-	regmap_bulk_read(npu->regmap, REG_PC_DBG(c), val, ARRAY_SIZE(val));
-	snprintf(dump, NPU_DUMP_SIZE, "PC: %08x SP: %08x LR: %08x\n",
-		 val[0], val[1], val[2]);
+	dump = vzalloc(NPU_DUMP_SIZE);
+	if (dump) {
+		regmap_bulk_read(npu->regmap, REG_PC_DBG(c), val,
+				 ARRAY_SIZE(val));
+		snprintf(dump, NPU_DUMP_SIZE,
+			 "PC: %08x SP: %08x LR: %08x\n",
+			 val[0], val[1], val[2]);
+		dev_coredumpv(npu->dev, dump, NPU_DUMP_SIZE, GFP_KERNEL);
+	}
 
-	dev_coredumpv(npu->dev, dump, NPU_DUMP_SIZE, GFP_KERNEL);
+	dev_warn(npu->dev, "restarting NPU core %d after watchdog timeout\n", c);
+	if (airoha_npu_restart_core(npu, c))
+		dev_err(npu->dev, "failed to restart NPU core %d\n", c);
 }
 
 static irqreturn_t airoha_npu_wdt_handler(int irq, void *core_instance)
@@ -708,6 +765,7 @@ static int airoha_npu_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	npu->dev = dev;
+	mutex_init(&npu->recovery_lock);
 	npu->ops.ppe_init = airoha_npu_ppe_init;
 	npu->ops.ppe_deinit = airoha_npu_ppe_deinit;
 	npu->ops.ppe_init_stats = airoha_npu_ppe_stats_setup;
@@ -744,6 +802,7 @@ static int airoha_npu_probe(struct platform_device *pdev)
 
 		spin_lock_init(&core->lock);
 		core->npu = npu;
+		INIT_WORK(&core->wdt_work, airoha_npu_wdt_work);
 
 		irq = platform_get_irq(pdev, i + 1);
 		if (irq < 0)
@@ -753,8 +812,6 @@ static int airoha_npu_probe(struct platform_device *pdev)
 				       IRQF_SHARED, "airoha-npu-wdt", core);
 		if (err)
 			return err;
-
-		INIT_WORK(&core->wdt_work, airoha_npu_wdt_work);
 	}
 
 	/* wlan IRQ lines */
diff --git a/include/linux/soc/airoha/airoha_offload.h b/include/linux/soc/airoha/airoha_offload.h
index 7589fcc..b601096 100644
--- a/include/linux/soc/airoha/airoha_offload.h
+++ b/include/linux/soc/airoha/airoha_offload.h
@@ -6,6 +6,7 @@
 #ifndef AIROHA_OFFLOAD_H
 #define AIROHA_OFFLOAD_H
 
+#include <linux/mutex.h>
 #include <linux/skbuff.h>
 #include <linux/spinlock.h>
 #include <linux/workqueue.h>
@@ -167,6 +168,9 @@ struct airoha_npu {
 #if (IS_BUILTIN(CONFIG_NET_AIROHA_NPU) || IS_MODULE(CONFIG_NET_AIROHA_NPU))
 	struct device *dev;
 	struct regmap *regmap;
+	/* serialize NPU core recovery */
+	struct mutex recovery_lock;
+	bool recovering;
 
 	struct airoha_npu_core {
 		struct airoha_npu *npu;
@@ -211,6 +215,7 @@ struct airoha_npu {
 #if (IS_BUILTIN(CONFIG_NET_AIROHA_NPU) || IS_MODULE(CONFIG_NET_AIROHA_NPU))
 struct airoha_npu *airoha_npu_get(struct device *dev);
 void airoha_npu_put(struct airoha_npu *npu);
+int airoha_npu_recover(struct airoha_npu *npu);
 
 static inline int airoha_npu_wlan_init_reserved_memory(struct airoha_npu *npu)
 {
@@ -268,6 +273,11 @@ static inline void airoha_npu_put(struct airoha_npu *npu)
 {
 }
 
+static inline int airoha_npu_recover(struct airoha_npu *npu)
+{
+	return -EOPNOTSUPP;
+}
+
 static inline int airoha_npu_wlan_init_reserved_memory(struct airoha_npu *npu)
 {
 	return -EOPNOTSUPP;
-- 
2.43.0

