From: OpenWrt XPON integration
Subject: [PATCH] net: pcs: airoha: handle an unlocked PON receiver

The generic AN7581 CDR search subtracts two unsigned frequency samples and
passes the result to abs().  A sample below the target therefore wraps before
abs() sees it and can make the search prefer the value furthest from the
target.  Use an explicit unsigned distance helper, including for the search
deadline calculation.

Unlike a point-to-point SerDes, a PON receiver normally starts with no
downstream optical signal.  The vendor PON flow treats that condition as an
unplugged receiver, keeps the transmitter disabled and waits for a later
plug/sync event.  Do the same after one calibration retry instead of rejecting
PCS configuration after fifty retries.  The protocol owner still requires
LOS clear, RX sync and PHYA ready before authorizing any traffic or optical
transmission.

--- a/drivers/net/pcs/airoha/pcs-an7581.c
+++ b/drivers/net/pcs/airoha/pcs-an7581.c
@@ -1652,6 +1652,12 @@ static unsigned int an7581_pcs_apply_cdr
 	return FIELD_GET(AIROHA_PCS_PMA_FL_OUT, val);
 }
 
+static unsigned int an7581_pcs_fl_out_diff(unsigned int fl_out,
+					    unsigned int target)
+{
+	return fl_out > target ? fl_out - target : target - fl_out;
+}
+
 static u32 an7581_pcs_rx_prcal_idac_major(struct airoha_pcs_priv *priv,
 					  int index, u32 target_fl_out)
 {
@@ -1670,7 +1677,8 @@ static u32 an7581_pcs_rx_prcal_idac_majo
 		fl_out = an7581_pcs_apply_cdr_pr_idac(priv, index, cdr_pr_idac_tmp);
 
 		/* Use absolute values to find the closest one to target */
-		fl_out_diff_new = abs(fl_out - target_fl_out);
+		fl_out_diff_new = an7581_pcs_fl_out_diff(fl_out,
+						       target_fl_out);
 		dev_dbg(priv->dev, "Tested CDR Pr Idac: %x Fl Out: %x Diff: %u\n",
 			cdr_pr_idac_tmp, fl_out, fl_out_diff_new);
 		if (fl_out_diff_new < fl_out_diff) {
@@ -1692,7 +1700,7 @@ static u32 an7581_pcs_rx_prcal_idac_mino
 	int prcal_search_bit;
 
 	fl_out = an7581_pcs_apply_cdr_pr_idac(priv, index, cdr_pr_idac);
-	fl_out_diff = abs(fl_out - target_fl_out);
+	fl_out_diff = an7581_pcs_fl_out_diff(fl_out, target_fl_out);
 
 	/* Deadline search part.
 	 * We start from top bits to bottom as we progressively decrease the
@@ -1706,7 +1714,8 @@ static u32 an7581_pcs_rx_prcal_idac_mino
 		fl_out = an7581_pcs_apply_cdr_pr_idac(priv, index, cdr_pr_idac_tmp);
 
 		/* Use absolute values to find the closest one to target */
-		fl_out_diff_new = abs(fl_out - target_fl_out);
+		fl_out_diff_new = an7581_pcs_fl_out_diff(fl_out,
+						       target_fl_out);
 		dev_dbg(priv->dev, "Tested CDR Pr Idac: %x Fl Out: %x Diff: %u\n",
 			cdr_pr_idac_tmp, fl_out, fl_out_diff_new);
 		if (fl_out_diff_new < fl_out_diff) {
@@ -1736,7 +1745,8 @@ static u32 an7581_pcs_rx_prcal_idac_mino
 		fl_out = an7581_pcs_apply_cdr_pr_idac(priv, index, cdr_pr_idac_tmp);
 
 		/* Use absolute values to find the closest one to target */
-		fl_out_diff_new = abs(fl_out - target_fl_out);
+		fl_out_diff_new = an7581_pcs_fl_out_diff(fl_out,
+						       target_fl_out);
 		/* Assume we found the deadline when the new absolue signal difference
 		 * from target is greater than the previous and the difference is at
 		 * least 10% greater between the old and new value.
@@ -1747,7 +1757,9 @@ static u32 an7581_pcs_rx_prcal_idac_mino
 		dev_dbg(priv->dev, "Tested CDR Pr Idac: %x Fl Out: %x Diff: %u\n",
 			cdr_pr_idac_tmp, fl_out, fl_out_diff_new);
 		if (fl_out_diff_new > fl_out_diff &&
-		    (abs(fl_out_diff_new - fl_out_diff) * 100) / fl_out_diff > 10) {
+		    (!fl_out_diff ||
+		     (an7581_pcs_fl_out_diff(fl_out_diff_new, fl_out_diff) * 100) /
+		     fl_out_diff > 10)) {
 			/* Exit early if we are already at the deadline */
 			if (prcal_search_bit == 0)
 				break;
@@ -1897,7 +1909,7 @@ static void an7581_pcs_rx_prcal(struct a
 						     target_fl_out, cdr_pr_idac_major);
 
 	fl_out = an7581_pcs_apply_cdr_pr_idac(priv, index, cdr_pr_idac);
-	fl_out_diff = abs(fl_out - target_fl_out);
+	fl_out_diff = an7581_pcs_fl_out_diff(fl_out, target_fl_out);
 	if (fl_out_diff > 100) {
 		u32 pr_idac_major = FIELD_GET(AIROHA_PCS_PMA_FORCE_CDR_PR_IDAC_MAJOR,
 					      cdr_pr_idac_major);
@@ -1917,7 +1929,8 @@ static void an7581_pcs_rx_prcal(struct a
 
 			fl_out_tmp = an7581_pcs_apply_cdr_pr_idac(priv, index,
 								  cdr_pr_idac_tmp);
-			fl_out_diff_tmp = abs(fl_out_tmp - target_fl_out);
+			fl_out_diff_tmp = an7581_pcs_fl_out_diff(fl_out_tmp,
+								       target_fl_out);
 			if (fl_out_diff_tmp < fl_out_diff) {
 				fl_out = fl_out_tmp;
 				fl_out_diff = fl_out_diff_tmp;
@@ -1925,6 +1938,10 @@ static void an7581_pcs_rx_prcal(struct a
 			}
 		}
 	}
+	if (priv->pon_mode != AIROHA_PCS_PON_MODE_NONE)
+		dev_info_ratelimited(priv->dev,
+			"PON CDR calibration: idac=%#x fl_out=%#x target=%#x diff=%u\n",
+			cdr_pr_idac, fl_out, target_fl_out, fl_out_diff);
 	dev_dbg(priv->dev, "Selected CDR Pr Idac: %x Fl Out: %x\n", cdr_pr_idac, fl_out);
 	if (fl_out_diff > 100)
 		dev_dbg(priv->dev, "Fl Out is %d far from target %d on intermediate calibration.\n",
@@ -2220,6 +2237,18 @@ retry_calibration:
 	 */
 	regmap_read(pcs_pma, AIROHA_PCS_PMA_RX_FREQDET, &val);
 	if (!(val & AIROHA_PCS_PMA_FBCK_LOCK)) {
+		if (priv->pon_mode != AIROHA_PCS_PON_MODE_NONE) {
+			if (!calibration_try) {
+				calibration_try++;
+				goto retry_calibration;
+			}
+
+			dev_info_ratelimited(priv->dev,
+				"PON receiver has no downstream FBCK lock (RX_FREQDET=%#x); keeping TX gated until optical sync\n",
+				val);
+			return 0;
+		}
+
 		if (calibration_try > AIROHA_PCS_MAX_CALIBRATION_TRY) {
 			dev_err(priv->dev, "No FBCK Lock from FreqDet module after %d calibration try. PCS won't work.\n",
 				AIROHA_PCS_MAX_CALIBRATION_TRY);
