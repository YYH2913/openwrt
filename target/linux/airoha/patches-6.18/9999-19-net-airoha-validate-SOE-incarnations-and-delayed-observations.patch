+u64 airoha_ppe_soe_register_sa(struct airoha_ppe *ppe, u8 sa_index)
+{
+	u64 cookie = 0;
+
+	if (!ppe || sa_index >= ARRAY_SIZE(ppe->soe_sa_cookie))
+		return 0;
+
+	spin_lock_bh(&ppe_lock);
+#if IS_ENABLED(CONFIG_NET_AIROHA_SOE)
