From: Yanghan Ye <yyh94306@gmail.com>
Date: Tue, 03 Nov 2026 13:41:52 +0000
Subject: [PATCH] net: airoha: npu: retain unfinished mailboxes across teardown

A timed-out mailbox caller releases its CPU locks while firmware may still
use the coherent bounce buffer. Draining those locks during provider
removal therefore cannot justify returning that buffer to the reserved
coherent pool.

Use a custom managed release action after IRQ/work teardown and software
stop. Consume the original DONE through the existing mailbox check and
DMA read barrier; retain each unresolved buffer instead of freeing it.
Keep core 0's first pool slot whenever any mailbox remains unresolved.

Require a new provider to allocate that same first slot before activating
firmware or submitting another mailbox command. The non-reusable reserved
coherent pool keeps its bitmap across device detach and module reload, so
a retained anchor prevents a fresh instance from confusing a late DONE
with its own completion. Validate the named pool layout and use the same
physical-to-DMA conversion as the coherent allocator. Keep the existing
per-core allocation sizes and remaining pool capacity for consumer queues.

This is same-kernel buffer and rebind containment. It does not provide a
hardware cancellation fence or make consumer ring DMA teardown safe. A
permanently unresolved callback keeps provider service unavailable.

The extracted actual provider/transport and coherent-pool bitmap fixture
passes 93 lifecycle checks, including 57 fixture probe failure stages; the
original source fails unresolved-slot retention. The existing 23 transport
cases and the target ARM64 object build with -Werror also pass.

Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
--- npu-mailbox-quarantine-fix.orig/drivers/net/ethernet/airoha/airoha_npu.c
+++ npu-mailbox-quarantine-fix/drivers/net/ethernet/airoha/airoha_npu.c
@@ -6,6 +6,7 @@
 
 #include <linux/devcoredump.h>
 #include <linux/sizes.h>
+#include <linux/dma-direct.h>
 #include <linux/dma-mapping.h>
 #include <linux/devm-helpers.h>
 #include <linux/firmware.h>
@@ -1118,6 +1119,106 @@ static void airoha_npu_release_mbox_pool
 	of_reserved_mem_device_release(data);
 }
 
+static void airoha_npu_release_mboxes(void *data)
+{
+	struct airoha_npu *npu = data;
+	struct airoha_npu_priv *priv = airoha_npu_priv(npu);
+	unsigned long pending = 0;
+	int i;
+
+	/* Software users and IRQ/work producers have already been drained. */
+	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
+		struct airoha_npu_core *core = &npu->cores[i];
+
+		if (!core->buf)
+			continue;
+		spin_lock_bh(&core->lock);
+		if (!i) {
+			if (priv->mbox_active || priv->mbox_reserved ||
+			    airoha_npu_check_mbox(npu))
+				pending |= BIT(i);
+		}
+		if (core->mbox_pending)
+			pending |= BIT(i);
+		spin_unlock_bh(&core->lock);
+	}
+
+	/* Keep the first pool slot as a persistent gate against provider rebind. */
+	if (pending)
+		pending |= BIT(0);
+	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
+		struct airoha_npu_core *core = &npu->cores[i];
+
+		if (core->buf && !(pending & BIT(i)))
+			dma_free_coherent(npu->dev, NPU_MBOX_SIZE, core->buf,
+					  core->addr);
+		core->buf = NULL;
+	}
+	if (pending)
+		dev_err(npu->dev,
+			"retaining NPU mailbox slots %#lx; provider rebind disabled\n",
+			pending);
+}
+
+static int airoha_npu_init_mboxes(struct airoha_npu *npu)
+{
+	struct device *dev = npu->dev;
+	struct device_node *mem;
+	struct resource res;
+	int i, index, err;
+
+	index = of_property_match_string(dev->of_node, "memory-region-names",
+					 "mbox");
+	if (index < 0)
+		return index;
+	mem = of_parse_phandle(dev->of_node, "memory-region", index);
+	if (!mem)
+		return -EINVAL;
+	err = of_device_is_compatible(mem, "shared-dma-pool") &&
+	      of_property_read_bool(mem, "no-map") &&
+	      !of_property_read_bool(mem, "reusable") ? 0 : -EINVAL;
+	of_node_put(mem);
+	if (err)
+		return dev_err_probe(dev, err,
+				     "NPU mailbox requires a reserved coherent pool\n");
+
+	err = of_reserved_mem_region_to_resource(dev->of_node, index, &res);
+	if (err)
+		return err;
+	if (!IS_ALIGNED(res.start, PAGE_SIZE) ||
+	    !IS_ALIGNED(resource_size(&res), PAGE_SIZE) ||
+	    resource_size(&res) < ARRAY_SIZE(npu->cores) * NPU_MBOX_SIZE)
+		return -EINVAL;
+
+	err = of_reserved_mem_device_init_by_idx(dev, dev->of_node, index);
+	if (err)
+		return err;
+	err = devm_add_action_or_reset(dev, airoha_npu_release_mbox_pool, dev);
+	if (err)
+		return err;
+	err = devm_add_action_or_reset(dev, airoha_npu_release_mboxes, npu);
+	if (err)
+		return err;
+
+	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
+		struct airoha_npu_core *core = &npu->cores[i];
+
+		core->buf = dma_alloc_coherent(dev, NPU_MBOX_SIZE, &core->addr,
+					       GFP_KERNEL);
+		if (!core->buf)
+			return -ENOMEM;
+		/* A retained first slot must survive even a module unload/reload. */
+		if (!i && core->addr != phys_to_dma(dev, res.start))
+			return dev_err_probe(dev, -EBUSY,
+					     "NPU mailbox anchor is unavailable\n");
+		if (core->addr > NPU_DMA_ADDR_MAX ||
+		    NPU_MBOX_SIZE - 1 > NPU_DMA_ADDR_MAX - core->addr)
+			return -ERANGE;
+	}
+
+	return 0;
+}
+
 static void airoha_npu_stop_recovery(void *data)
 {
 	struct airoha_npu *npu = data;
@@ -1126,7 +1227,7 @@ static void airoha_npu_stop_recovery(voi
 	mutex_lock(&npu->recovery_lock);
 	WRITE_ONCE(npu->stopping, true);
 
-	/* Drain mailbox requests before their buffers can be released. */
+	/* Drain CPU mailbox users before deciding whether storage can retire. */
 	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
 		spin_lock_bh(&npu->cores[i].lock);
 		spin_unlock_bh(&npu->cores[i].lock);
@@ -1196,31 +1297,11 @@ static int airoha_npu_probe(struct platf
 	if (err)
 		return err;
 
-	err = of_reserved_mem_device_init_by_name(dev, dev->of_node, "mbox");
+	err = airoha_npu_init_mboxes(npu);
 	if (err)
 		return dev_err_probe(dev, err,
 				     "failed to initialize NPU mailbox pool\n");
 
-	err = devm_add_action_or_reset(dev, airoha_npu_release_mbox_pool, dev);
-	if (err)
-		return err;
-
-	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
-		struct airoha_npu_core *core = &npu->cores[i];
-
-		core->buf = dmam_alloc_coherent(dev, NPU_MBOX_SIZE,
-						&core->addr, GFP_KERNEL);
-		if (!core->buf)
-			return dev_err_probe(dev, -ENOMEM,
-					     "failed to allocate NPU core %d mailbox\n",
-					     i);
-
-		if (core->addr + NPU_MBOX_SIZE - 1 > NPU_DMA_ADDR_MAX)
-			return dev_err_probe(dev, -ERANGE,
-					     "NPU core %d mailbox address %pad is out of range\n",
-					     i, &core->addr);
-	}
-
 	err = devm_add_action_or_reset(dev, airoha_npu_stop_recovery, npu);
 	if (err)
 		return err;
