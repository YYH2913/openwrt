 	bool gpon_mode;
 	bool gpon_tx_ready;
+	bool gpon_omcc_ready;
 	u16 gpon_gem;
+	u16 gpon_omcc_gem;
 	u8 gpon_channel;
 
 	DECLARE_BITMAP(qos_sq_bmap, AIROHA_NUM_QOS_CHANNELS);
@@ -715,6 +718,7 @@ bool airoha_is_valid_gdm_dev(struct airo
 
 int airoha_gpon_set_gem(struct device_node *np, u16 gem, u8 channel,
 			bool valid);
+int airoha_gpon_set_omcc(struct device_node *np, u16 gem, bool valid);
 extern struct mutex flow_offload_mutex;
 
 static inline struct airoha_qdma *
