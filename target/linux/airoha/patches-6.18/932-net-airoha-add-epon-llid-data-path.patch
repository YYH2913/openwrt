 	spin_unlock_irqrestore(&dev->xgs_service_state_lock, flags);
 	if (ret)
 		goto out;
+	spin_lock_irqsave(&dev->epon_service_state_lock, flags);
+	if (count && dev->epon_llid_mask)
+		ret = -EBUSY;
+	spin_unlock_irqrestore(&dev->epon_service_state_lock, flags);
+	if (ret)
+		goto out;
 
 	spin_lock_irqsave(&dev->gpon_lock, flags);
 	dev->gpon_tx_ready = false;
@@ -5299,6 +5518,12 @@
 	spin_unlock_irqrestore(&dev->xgs_service_state_lock, flags);
 	if (err)
 		goto out;
+	spin_lock_irqsave(&dev->epon_service_state_lock, flags);
+	if (count && dev->epon_llid_mask)
+		err = -EBUSY;
+	spin_unlock_irqrestore(&dev->epon_service_state_lock, flags);
+	if (err)
+		goto out;
 
 	qdma = airoha_qdma_deref(dev);
 	bitmap_zero(acquired, AIROHA_GPON_QOS_CHANNELS);
@@ -5425,6 +5650,12 @@
 		ret = -EBUSY;
 		goto unlock;
 	}
+	spin_lock_irqsave(&dev->epon_service_state_lock, flags);
+	if (valid && dev->epon_llid_mask)
+		ret = -EBUSY;
+	spin_unlock_irqrestore(&dev->epon_service_state_lock, flags);
+	if (ret)
+		goto unlock;
 	spin_lock_irqsave(&dev->gpon_lock, flags);
 	dev->gpon_omcc_ready = false;
 	dev->gpon_omcc_gem = gem;
--- a/drivers/net/ethernet/airoha/airoha_eth.h
