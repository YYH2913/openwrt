+int airoha_epon_qdma_llids_apply(struct device_node *np, u32 llid_mask,
+				 u32 report_fec_mask)
+{
+	struct airoha_gdm_dev *dev;
+	struct airoha_qdma *qdma;
+	struct net_device *netdev;
+	unsigned long flags, channel;
+	u32 acquired = 0, old_mask, old_report_fec, old_txchn, new_txchn;
+	bool conflict = false;
+	int ret = 0;
+
+	if (!np || (report_fec_mask & ~llid_mask))
+		return -EINVAL;
+	netdev = of_find_net_device_by_node(np);
+	if (!netdev)
+		return -ENODEV;
+	dev = netdev_priv(netdev);
+	if (!dev->gpon_mode) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+
+	mutex_lock(&flow_offload_mutex);
+	mutex_lock(&dev->epon_service_lock);
+	spin_lock_irqsave(&dev->gpon_lock, flags);
+	if (llid_mask && (dev->gpon_tx_ready || dev->gpon_omcc_ready))
+		ret = -EBUSY;
+	spin_unlock_irqrestore(&dev->gpon_lock, flags);
+	if (ret)
+		goto unlock;
+	spin_lock_irqsave(&dev->xgs_service_state_lock, flags);
+	if (llid_mask && dev->xgs_service_active)
+		ret = -EBUSY;
+	spin_unlock_irqrestore(&dev->xgs_service_state_lock, flags);
+	if (ret)
+		goto unlock;
+	mutex_lock(&dev->xgs_omcc_lock);
+	if (llid_mask && rcu_access_pointer(dev->xgs_omcc_consumer))
+		ret = -EBUSY;
+	mutex_unlock(&dev->xgs_omcc_lock);
+	if (ret)
+		goto unlock;
+
+	spin_lock_irqsave(&dev->epon_service_state_lock, flags);
+	old_mask = dev->epon_llid_mask;
+	old_report_fec = dev->epon_report_fec_mask;
+	spin_unlock_irqrestore(&dev->epon_service_state_lock, flags);
+	if (old_mask == llid_mask && old_report_fec == report_fec_mask)
+		goto unlock;
+
+	old_txchn = airoha_fe_rr(dev->eth,
+				 REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX));
+	if (!dev->epon_resource_baseline_valid) {
+		if (!llid_mask)
+			goto unlock;
+		dev->epon_gdm2_txchn_baseline = old_txchn;
+		for (channel = 0; channel < AIROHA_EPON_LLID_COUNT; channel++)
+			dev->epon_pse_rsv_baseline[channel] =
+				airoha_fe_get_pse_queue_rsv_pages(
+					dev->eth, FE_PSE_PORT_GDM2, channel);
+	}
+
+	qdma = airoha_qdma_deref(dev);
+	if (!qdma) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	for (channel = 0; channel < AIROHA_EPON_LLID_COUNT; channel++) {
+		if (!(llid_mask & BIT(channel)))
+			continue;
+		if (old_mask & BIT(channel))
+			continue;
+		if (test_and_set_bit(channel, qdma->qos_channel_map)) {
+			conflict = true;
+			break;
+		}
+		acquired |= BIT(channel);
+	}
+	if (conflict) {
+		ret = -EBUSY;
+		goto release_acquired;
+	}
+
+	new_txchn = dev->epon_gdm2_txchn_baseline | llid_mask;
+	for (channel = 0; channel < AIROHA_EPON_LLID_COUNT; channel++) {
+		u32 reserve = llid_mask & BIT(channel) ?
+			PSE_QUEUE_RSV_PAGES :
+			dev->epon_pse_rsv_baseline[channel];
+
+		if ((old_txchn ^ new_txchn) & BIT(channel))
+			airoha_fe_rmw(dev->eth,
+				REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX), BIT(channel),
+				new_txchn & BIT(channel));
+		ret = airoha_fe_set_pse_oq_rsv(dev->eth, FE_PSE_PORT_GDM2,
+						 channel, reserve);
+		if (ret)
+			goto restore_resources;
+	}
+	airoha_qdma_wr(qdma, QDMA_EPON_REPORT_FEC, report_fec_mask);
+
+	spin_lock_irqsave(&dev->epon_service_state_lock, flags);
+	dev->epon_llid_mask = llid_mask;
+	dev->epon_report_fec_mask = report_fec_mask;
+	spin_unlock_irqrestore(&dev->epon_service_state_lock, flags);
+	for (channel = 0; channel < AIROHA_EPON_LLID_COUNT; channel++)
+		if ((old_mask & BIT(channel)) && !(llid_mask & BIT(channel)))
+			clear_bit(channel, qdma->qos_channel_map);
+	dev->epon_resource_baseline_valid = llid_mask != 0;
+	goto unlock;
+
+restore_resources:
+	airoha_fe_wr(dev->eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX), old_txchn);
+	for (channel = 0; channel < AIROHA_EPON_LLID_COUNT; channel++)
+		if (airoha_fe_set_pse_oq_rsv(dev->eth, FE_PSE_PORT_GDM2,
+						channel,
+			old_mask & BIT(channel) ? PSE_QUEUE_RSV_PAGES :
+			dev->epon_pse_rsv_baseline[channel]))
+			netdev_err(netdev,
+				   "failed to restore EPON PSE channel %lu\n",
+				   channel);
+release_acquired:
+	for (channel = 0; channel < AIROHA_EPON_LLID_COUNT; channel++)
+		if (acquired & BIT(channel))
+			clear_bit(channel, qdma->qos_channel_map);
+unlock:
+	mutex_unlock(&dev->epon_service_lock);
+	mutex_unlock(&flow_offload_mutex);
+out:
+	put_device(&netdev->dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_epon_qdma_llids_apply);
+
+int airoha_epon_qdma_llids_clear(struct device_node *np)
+{
+	return airoha_epon_qdma_llids_apply(np, 0, 0);
+}
+EXPORT_SYMBOL_GPL(airoha_epon_qdma_llids_clear);
