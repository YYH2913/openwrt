 struct airoha_xgs_service_tcont {
 	u8 index;
 	u8 valid;
@@ -669,6 +673,13 @@
 	bool xgs_resource_baseline_valid;
 	u32 xgs_gdm2_txchn_baseline;
 	u16 xgs_pse_rsv_baseline[AIROHA_XGS_SERVICE_MAX_TCONTS];
+	struct mutex epon_service_lock;
+	spinlock_t epon_service_state_lock;
+	u32 epon_llid_mask;
+	u32 epon_report_fec_mask;
+	bool epon_resource_baseline_valid;
+	u32 epon_gdm2_txchn_baseline;
+	u16 epon_pse_rsv_baseline[AIROHA_EPON_LLID_COUNT];
 	bool gpon_mode;
 	bool gpon_tx_ready;
 	bool gpon_omcc_ready;
@@ -853,6 +864,9 @@
 int airoha_xgs_qdma_service_apply(struct device_node *np,
 				  const struct airoha_xgs_service_config *config);
 int airoha_xgs_qdma_service_clear(struct device_node *np);
+int airoha_epon_qdma_llids_apply(struct device_node *np, u32 llid_mask,
+				 u32 report_fec_mask);
+int airoha_epon_qdma_llids_clear(struct device_node *np);
 extern struct mutex flow_offload_mutex;
 
 static inline struct airoha_qdma *
