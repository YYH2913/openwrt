+static void airoha_epon_oam_receive(struct airoha_gdm_dev *dev,
+				    struct sk_buff *skb, u8 llid_index,
+				    u16 llid, bool no_mic)
+{
+	struct airoha_epon_oam_metadata metadata = {
+		.llid_index = llid_index,
+		.llid = llid,
+		.no_mic = no_mic,
+	};
+	struct airoha_epon_oam_consumer *consumer;
+
+	rcu_read_lock();
+	consumer = rcu_dereference(dev->epon_oam_consumer);
+	if (consumer)
+		consumer->ops->receive(consumer->context, skb, &metadata);
+	else
+		dev_kfree_skb_any(skb);
+	rcu_read_unlock();
+}
+
