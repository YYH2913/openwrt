+static bool airoha_epon_oam_consumer_present(struct airoha_gdm_dev *dev)
+{
+	bool present;
+
+	rcu_read_lock();
+	present = rcu_access_pointer(dev->epon_oam_consumer);
+	rcu_read_unlock();
+
+	return present;
+}
+
 static void airoha_xgs_omcc_receive(struct airoha_gdm_dev *dev,
 				    struct sk_buff *skb, u16 gem,
 				    bool no_mic)
@@ -74,6 +86,26 @@
