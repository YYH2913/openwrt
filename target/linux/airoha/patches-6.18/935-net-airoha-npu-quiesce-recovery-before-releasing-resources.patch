From 757446193f8bc473a3733e88b5e25c03a010674b Mon Sep 17 00:00:00 2001
From: Yanghan Ye <yyh94306@gmail.com>
Date: Sat, 10 Oct 2026 19:57:28 -0700
Subject: [PATCH] net: airoha: npu: quiesce recovery before releasing resources

The downstream watchdog recovery can still reboot firmware while provider
devres teardown is releasing coherent mailbox buffers. The buffers and pool
are allocated after the WDT IRQ and autocancel actions, so reverse-order
release retires them before synchronizing the IRQ and cancelling its work.
Recovery can also enter while later core locks are still being initialized
if firmware already running during probe raises a watchdog interrupt.

Initialize all core locks before IRQ registration and gate recovery until
firmware boot completes. Register IRQ/work resources after coherent buffers
so IRQ producers and work finish before those buffers are reclaimed.
Gate new work, recovery and mailbox requests once remove starts, serialize
that transition with recovery, and drain requests which already passed the
mailbox check. A devm action also covers probe-error cleanup.

This only stops software recovery and mailbox users. It does not establish
that firmware or hardware DMA has stopped after a failed consumer detach.

Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_npu.c  | 106 +++++++++++++++-------
 include/linux/soc/airoha/airoha_offload.h |   1 +
 2 files changed, 75 insertions(+), 32 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_npu.c b/drivers/net/ethernet/airoha/airoha_npu.c
index 35dddf2..aa16ecd 100644
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -188,6 +188,10 @@ static int __airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 	 * foe_commit under atomic context).
 	 */
 	spin_lock_bh(&core->lock);
+	if (READ_ONCE(npu->stopping)) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
 	if (atomic_read(&npu->recovering)) {
 		ret = -EAGAIN;
 		goto unlock;
@@ -332,6 +336,10 @@ static int airoha_npu_restart_core(struct airoha_npu *npu, int core)
 		return -EINVAL;
 
 	mutex_lock(&npu->recovery_lock);
+	if (npu->stopping) {
+		err = -ESHUTDOWN;
+		goto unlock;
+	}
 	atomic_set(&npu->recovering, 1);
 
 	/* Drain mailbox requests which passed the recovery check. */
@@ -361,6 +369,7 @@ static int airoha_npu_restart_core(struct airoha_npu *npu, int core)
 out:
 	npu->recovery_err = err;
 	atomic_set(&npu->recovering, 0);
+unlock:
 	mutex_unlock(&npu->recovery_lock);
 
 	return err;
@@ -377,7 +386,7 @@ int airoha_npu_wait_recovery(struct airoha_npu *npu)
 	int err;
 
 	mutex_lock(&npu->recovery_lock);
-	err = npu->recovery_err;
+	err = npu->stopping ? -ESHUTDOWN : npu->recovery_err;
 	mutex_unlock(&npu->recovery_lock);
 
 	return err;
@@ -394,6 +403,8 @@ static void airoha_npu_wdt_work(struct work_struct *work)
 
 	core = container_of(work, struct airoha_npu_core, wdt_work);
 	npu = core->npu;
+	if (READ_ONCE(npu->stopping))
+		return;
 
 	c = core - &npu->cores[0];
 	dump = vzalloc(NPU_DUMP_SIZE);
@@ -419,7 +430,8 @@ static irqreturn_t airoha_npu_wdt_handler(int irq, void *core_instance)
 	u32 val;
 
 	regmap_set_bits(npu->regmap, REG_WDT_TIMER_CTRL(c), WDT_INTR_MASK);
-	if (!regmap_read(npu->regmap, REG_WDT_TIMER_CTRL(c), &val) &&
+	if (!READ_ONCE(npu->stopping) &&
+	    !regmap_read(npu->regmap, REG_WDT_TIMER_CTRL(c), &val) &&
 	    FIELD_GET(WDT_EN_MASK, val))
 		schedule_work(&core->wdt_work);
 
@@ -812,6 +824,22 @@ static void airoha_npu_release_mbox_pool(void *data)
 	of_reserved_mem_device_release(data);
 }
 
+static void airoha_npu_stop_recovery(void *data)
+{
+	struct airoha_npu *npu = data;
+	int i;
+
+	mutex_lock(&npu->recovery_lock);
+	WRITE_ONCE(npu->stopping, true);
+
+	/* Drain mailbox requests before their buffers can be released. */
+	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
+		spin_lock_bh(&npu->cores[i].lock);
+		spin_unlock_bh(&npu->cores[i].lock);
+	}
+	mutex_unlock(&npu->recovery_lock);
+}
+
 static int airoha_npu_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -832,6 +860,11 @@ static int airoha_npu_probe(struct platform_device *pdev)
 	npu->dev = dev;
 	mutex_init(&npu->recovery_lock);
 	atomic_set(&npu->recovering, 0);
+	npu->stopping = true;
+	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
+		spin_lock_init(&npu->cores[i].lock);
+		npu->cores[i].npu = npu;
+	}
 	npu->ops.ppe_init = airoha_npu_ppe_init;
 	npu->ops.ppe_deinit = airoha_npu_ppe_deinit;
 	npu->ops.ppe_init_stats = airoha_npu_ppe_stats_setup;
@@ -854,36 +887,6 @@ static int airoha_npu_probe(struct platform_device *pdev)
 	if (err)
 		return err;
 
-	irq = platform_get_irq(pdev, 0);
-	if (irq < 0)
-		return irq;
-
-	err = devm_request_irq(dev, irq, airoha_npu_mbox_handler,
-			       IRQF_SHARED, "airoha-npu-mbox", npu);
-	if (err)
-		return err;
-
-	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
-		struct airoha_npu_core *core = &npu->cores[i];
-
-		spin_lock_init(&core->lock);
-		core->npu = npu;
-
-		irq = platform_get_irq(pdev, i + 1);
-		if (irq < 0)
-			return irq;
-
-		err = devm_work_autocancel(dev, &core->wdt_work,
-					   airoha_npu_wdt_work);
-		if (err)
-			return err;
-
-		err = devm_request_irq(dev, irq, airoha_npu_wdt_handler,
-				       IRQF_SHARED, "airoha-npu-wdt", core);
-		if (err)
-			return err;
-	}
-
 	/* wlan IRQ lines */
 	for (i = 0; i < ARRAY_SIZE(npu->irqs); i++) {
 		irq = platform_get_irq(pdev, i + ARRAY_SIZE(npu->cores) + 1);
@@ -922,6 +925,38 @@ static int airoha_npu_probe(struct platform_device *pdev)
 					     i, &core->addr);
 	}
 
+	err = devm_add_action_or_reset(dev, airoha_npu_stop_recovery, npu);
+	if (err)
+		return err;
+
+	/* Release IRQ producers and watchdog work before the mailbox buffers. */
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	err = devm_request_irq(dev, irq, airoha_npu_mbox_handler,
+			       IRQF_SHARED, "airoha-npu-mbox", npu);
+	if (err)
+		return err;
+
+	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
+		struct airoha_npu_core *core = &npu->cores[i];
+
+		irq = platform_get_irq(pdev, i + 1);
+		if (irq < 0)
+			return irq;
+
+		err = devm_work_autocancel(dev, &core->wdt_work,
+					   airoha_npu_wdt_work);
+		if (err)
+			return err;
+
+		err = devm_request_irq(dev, irq, airoha_npu_wdt_handler,
+				       IRQF_SHARED, "airoha-npu-wdt", core);
+		if (err)
+			return err;
+	}
+
 	err = airoha_npu_run_firmware(dev, base, &res);
 	if (err)
 		return err;
@@ -942,6 +977,7 @@ static int airoha_npu_probe(struct platform_device *pdev)
 	regmap_write(npu->regmap, REG_CR_BOOT_CONFIG, 0xff);
 	regmap_write(npu->regmap, REG_CR_BOOT_TRIGGER, 0x1);
 	msleep(100);
+	WRITE_ONCE(npu->stopping, false);
 
 	if (!airoha_npu_wlan_msg_get(npu, 0, WLAN_FUNC_GET_WAIT_NPU_VERSION,
 				     &val, sizeof(val), GFP_KERNEL))
@@ -953,8 +989,14 @@ static int airoha_npu_probe(struct platform_device *pdev)
 	return 0;
 }
 
+static void airoha_npu_remove(struct platform_device *pdev)
+{
+	airoha_npu_stop_recovery(platform_get_drvdata(pdev));
+}
+
 static struct platform_driver airoha_npu_driver = {
 	.probe = airoha_npu_probe,
+	.remove = airoha_npu_remove,
 	.driver = {
 		.name = "airoha-npu",
 		.of_match_table = of_airoha_npu_match,
diff --git a/include/linux/soc/airoha/airoha_offload.h b/include/linux/soc/airoha/airoha_offload.h
index 211f6e2..3d0a387 100644
--- a/include/linux/soc/airoha/airoha_offload.h
+++ b/include/linux/soc/airoha/airoha_offload.h
@@ -178,6 +178,7 @@ struct airoha_npu {
 	struct mutex recovery_lock;
 	atomic_t recovering;
 	int recovery_err;
+	bool stopping;
 
 	struct airoha_npu_core {
 		struct airoha_npu *npu;
-- 
2.43.0

