From 96ae3610d7bc280107e4b393d4ab054a4432b4bd Mon Sep 17 00:00:00 2001
From: Yanghan Ye <yyh94306@gmail.com>
Date: Sat, 10 Oct 2026 19:54:27 -0700
Subject: [PATCH 1/2] net: airoha: serialize delayed SOE metadata and flush
 cached flows

Serialize the complete delayed metadata record and its consumption with
PPE commits. Clear pending CPU staging and unlink matching cached flow
templates when retiring an SA, so hardware invalidation cannot be undone
by a later cached rebind. SA incarnation and late completion validation
require the following cookie change.

Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.h |   1 +
 drivers/net/ethernet/airoha/airoha_ppe.c | 105 +++++++++++++++--------
 2 files changed, 69 insertions(+), 37 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
index 4ab62da..9db7041 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -498,6 +498,7 @@ struct airoha_foe_stats64 {
 	u64 packets;
 };
 
+/* All fields are protected by ppe_lock in airoha_ppe.c. */
 struct airoha_ppe_soe_meta {
 	unsigned long expires;
 	u32 key_hash;
diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
index 5935aaa..d52cd02 100644
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1304,22 +1304,23 @@ static void airoha_ppe_soe_meta_store(struct airoha_ppe_soe_meta *meta,
 {
 	u8 seen = 1;
 
-	if (READ_ONCE(meta->valid) &&
-	    READ_ONCE(meta->key_hash) == key_hash &&
-	    READ_ONCE(meta->foe_hash) == foe_hash &&
-	    READ_ONCE(meta->sa_index) == sa_index &&
-	    READ_ONCE(meta->hop) == hop &&
-	    time_before_eq(jiffies, READ_ONCE(meta->expires)))
-		seen = min_t(u8, READ_ONCE(meta->seen) + 1, U8_MAX);
-
-	WRITE_ONCE(meta->key_hash, key_hash);
-	WRITE_ONCE(meta->foe_hash, foe_hash);
-	WRITE_ONCE(meta->sa_index, sa_index);
-	WRITE_ONCE(meta->hop, hop);
-	WRITE_ONCE(meta->seen, seen);
-	WRITE_ONCE(meta->expires,
-		   jiffies + msecs_to_jiffies(AIROHA_PPE_SOE_META_TIMEOUT_MS));
-	WRITE_ONCE(meta->valid, 1);
+	lockdep_assert_held(&ppe_lock);
+
+	if (meta->valid &&
+	    meta->key_hash == key_hash &&
+	    meta->foe_hash == foe_hash &&
+	    meta->sa_index == sa_index &&
+	    meta->hop == hop &&
+	    time_before_eq(jiffies, meta->expires))
+		seen = min_t(u8, meta->seen + 1, U8_MAX);
+
+	meta->key_hash = key_hash;
+	meta->foe_hash = foe_hash;
+	meta->sa_index = sa_index;
+	meta->hop = hop;
+	meta->seen = seen;
+	meta->expires = jiffies + msecs_to_jiffies(AIROHA_PPE_SOE_META_TIMEOUT_MS);
+	meta->valid = 1;
 }
 
 void airoha_ppe_soe_mark_skb(struct airoha_ppe_dev *dev, struct sk_buff *skb,
@@ -1344,9 +1345,11 @@ void airoha_ppe_soe_mark_skb(struct airoha_ppe_dev *dev, struct sk_buff *skb,
 	 * hash and SA hop briefly on the skb so airoha_dev_xmit() can finish
 	 * the PPE entry once the final egress descriptor is known.
 	 */
+	spin_lock_bh(&ppe_lock);
 	airoha_ppe_soe_meta_store(&ppe->soe_meta[hash], hash, hash, sa_index,
 				  hop);
 	ppe->foe_check_time[hash] = 0;
+	spin_unlock_bh(&ppe_lock);
 
 	skb->mark &= ~(AIROHA_PPE_SOE_MARK_MAGIC_MASK |
 		       AIROHA_PPE_SOE_MARK_HASH_MASK);
@@ -1391,41 +1394,41 @@ void airoha_ppe_soe_xmit_skb(struct airoha_ppe_dev *dev, struct sk_buff *skb,
 	if (key_hash > ppe_hash_mask)
 		goto clear_mark;
 
-	meta = &ppe->soe_meta[key_hash];
-	if (!READ_ONCE(meta->valid))
+	err = airoha_ppe_soe_fill_inner_ipv4_data(skb, &data, &type, &l4proto);
+	if (err)
 		goto clear_mark;
 
-	if (READ_ONCE(meta->key_hash) != key_hash)
-		goto clear_mark;
+	spin_lock_bh(&ppe_lock);
 
-	expires = READ_ONCE(meta->expires);
+	meta = &ppe->soe_meta[key_hash];
+	if (!meta->valid)
+		goto unlock;
+
+	if (meta->key_hash != key_hash)
+		goto unlock;
+
+	expires = meta->expires;
 	if (time_after(jiffies, expires)) {
-		WRITE_ONCE(meta->valid, 0);
-		goto clear_mark;
+		meta->valid = 0;
+		goto unlock;
 	}
 
-	hash = READ_ONCE(meta->foe_hash);
+	hash = meta->foe_hash;
 	if (hash > ppe_hash_mask) {
-		WRITE_ONCE(meta->valid, 0);
-		goto clear_mark;
+		meta->valid = 0;
+		goto unlock;
 	}
 
-	seen = READ_ONCE(meta->seen);
+	seen = meta->seen;
 	/* Wait for two CPU-visible packets so the normal egress path is proven
 	 * before the decrypt FOE entry is bound to hardware.
 	 */
 	if (seen <= 2)
-		goto clear_mark;
-
-	err = airoha_ppe_soe_fill_inner_ipv4_data(skb, &data, &type, &l4proto);
-	if (err)
-		goto clear_mark;
-
-	sa_index = READ_ONCE(meta->sa_index);
-	hop = READ_ONCE(meta->hop);
-	WRITE_ONCE(meta->valid, 0);
+		goto unlock;
 
-	spin_lock_bh(&ppe_lock);
+	sa_index = meta->sa_index;
+	hop = meta->hop;
+	meta->valid = 0;
 
 	hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
 	if (!hwe)
@@ -1512,6 +1515,34 @@ void airoha_ppe_soe_flush_sa(struct airoha_ppe *ppe, u8 sa_index)
 	num_entries = airoha_ppe_get_total_num_entries(ppe);
 
 	spin_lock_bh(&ppe_lock);
+	/* Remove CPU staging and cached flow templates under the same lock as
+	 * all commits. Invalidating only hardware leaves both able to rebind.
+	 */
+	for (hash = 0; hash < num_entries; hash++) {
+		struct airoha_flow_table_entry *e;
+		struct hlist_node *n;
+
+		if (ppe->soe_meta && ppe->soe_meta[hash].valid &&
+		    ppe->soe_meta[hash].sa_index == sa_index)
+			ppe->soe_meta[hash].valid = 0;
+
+		hlist_for_each_entry_safe(e, n, &ppe->foe_flow[hash], list) {
+			u32 type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE,
+					     e->data.ib1);
+
+			if (type != PPE_PKT_TYPE_IPV4_HNAPT &&
+			    type != PPE_PKT_TYPE_IPV4_ROUTE)
+				continue;
+			if (!(e->data.ipv4.data & AIROHA_FOE_TUNNEL) ||
+			    FIELD_GET(AIROHA_FOE_ACTDP, e->data.ipv4.data) != sa_index)
+				continue;
+
+			/* The flowtable still owns e; its destroy callback frees it. */
+			hlist_del_init(&e->list);
+			e->hash = 0xffff;
+		}
+	}
+
 	for (hash = 0; hash < num_entries; hash++) {
 		struct airoha_foe_entry *hwe;
 		u32 state, type;
-- 
2.43.0

