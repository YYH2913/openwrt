+static int airoha_pcs_xgspon_rx_update(struct phylink_pcs *pcs, bool recover)
+{
+	struct airoha_pcs_port *port;
+	struct airoha_pcs_priv *priv;
+	int ret;
+
+	if (!pcs || pcs->ops != &airoha_pcs_ops)
+		return -EINVAL;
+
+	port = to_airoha_pcs_port(pcs);
+	priv = port->priv;
+	if (priv->data->port_type != AIROHA_PCS_PON ||
+	    priv->pon_mode != AIROHA_PCS_PON_MODE_XGSPON)
+		return -EINVAL;
+
+	rtnl_lock();
+	mutex_lock(&priv->recovery_lock);
+	ret = recover ? an7581_pcs_xgspon_rx_recover(priv, port->index) :
+			an7581_pcs_xgspon_rx_quiesce(priv, port->index);
+	mutex_unlock(&priv->recovery_lock);
+	rtnl_unlock();
+
+	return ret;
+}
+
+int airoha_pcs_xgspon_rx_quiesce(struct phylink_pcs *pcs)
+{
+	return airoha_pcs_xgspon_rx_update(pcs, false);
+}
+EXPORT_SYMBOL_GPL(airoha_pcs_xgspon_rx_quiesce);
+
+int airoha_pcs_xgspon_rx_recover(struct phylink_pcs *pcs)
+{
+	return airoha_pcs_xgspon_rx_update(pcs, true);
+}
+EXPORT_SYMBOL_GPL(airoha_pcs_xgspon_rx_recover);
