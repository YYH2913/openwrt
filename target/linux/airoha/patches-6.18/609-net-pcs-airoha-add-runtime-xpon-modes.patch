+static int airoha_pcs_xpon_port(struct phylink_pcs *pcs,
+				struct airoha_pcs_port **port)
+{
+	if (!pcs || pcs->ops != &airoha_pcs_ops)
+		return -EINVAL;
+
+	*port = to_airoha_pcs_port(pcs);
+	if ((*port)->priv->data->port_type != AIROHA_PCS_PON ||
+	    (*port)->priv->pon_mode == AIROHA_PCS_PON_MODE_NONE)
+		return -EINVAL;
+
+	return 0;
+}
+
+static int
+airoha_pcs_xpon_mode_from_public(enum airoha_pcs_xpon_mode mode,
+				 enum airoha_pcs_pon_mode *internal)
+{
+	switch (mode) {
+	case AIROHA_PCS_XPON_MODE_GPON:
+		*internal = AIROHA_PCS_PON_MODE_GPON;
+		break;
+	case AIROHA_PCS_XPON_MODE_XGPON:
+		*internal = AIROHA_PCS_PON_MODE_XGPON;
+		break;
+	case AIROHA_PCS_XPON_MODE_XGSPON:
+		*internal = AIROHA_PCS_PON_MODE_XGSPON;
+		break;
+	case AIROHA_PCS_XPON_MODE_EPON_10G_1G:
+		*internal = AIROHA_PCS_PON_MODE_EPON_10G_1G;
+		break;
+	case AIROHA_PCS_XPON_MODE_EPON_10G_10G:
+		*internal = AIROHA_PCS_PON_MODE_EPON_10G_10G;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static enum airoha_pcs_xpon_mode
+airoha_pcs_xpon_mode_to_public(enum airoha_pcs_pon_mode mode)
+{
+	switch (mode) {
+	case AIROHA_PCS_PON_MODE_GPON:
+		return AIROHA_PCS_XPON_MODE_GPON;
+	case AIROHA_PCS_PON_MODE_XGPON:
+		return AIROHA_PCS_XPON_MODE_XGPON;
+	case AIROHA_PCS_PON_MODE_XGSPON:
+		return AIROHA_PCS_XPON_MODE_XGSPON;
+	case AIROHA_PCS_PON_MODE_EPON_10G_1G:
+		return AIROHA_PCS_XPON_MODE_EPON_10G_1G;
+	case AIROHA_PCS_PON_MODE_EPON_10G_10G:
+		return AIROHA_PCS_XPON_MODE_EPON_10G_10G;
+	case AIROHA_PCS_PON_MODE_NONE:
+	default:
+		return AIROHA_PCS_XPON_MODE_GPON;
+	}
+}
+
+int airoha_pcs_xpon_get_mode(struct phylink_pcs *pcs,
+			     enum airoha_pcs_xpon_mode *mode)
+{
+	struct airoha_pcs_port *port;
+	int ret;
+
+	if (!mode)
+		return -EINVAL;
+	ret = airoha_pcs_xpon_port(pcs, &port);
+	if (ret)
+		return ret;
+
+	mutex_lock(&port->priv->recovery_lock);
+	*mode = airoha_pcs_xpon_mode_to_public(port->priv->pon_mode);
+	mutex_unlock(&port->priv->recovery_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_pcs_xpon_get_mode);
+
+int airoha_pcs_xpon_quiesce(struct phylink_pcs *pcs)
+{
+	struct airoha_pcs_port *port;
+	struct airoha_pcs_priv *priv;
+	struct airoha_pcs_maps *maps;
+	int ret;
+
+	ret = airoha_pcs_xpon_port(pcs, &port);
+	if (ret)
+		return ret;
+	priv = port->priv;
+	maps = &priv->maps[port->index];
+
+	rtnl_lock();
+	mutex_lock(&priv->recovery_lock);
+	if (priv->pon_quiesced) {
+		ret = 0;
+		goto unlock;
+	}
+
+	regmap_set_bits(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG,
+			AIROHA_PCS_XFI_RXMPI_STOP |
+			AIROHA_PCS_XFI_RXMBI_STOP |
+			AIROHA_PCS_XFI_TXMPI_STOP |
+			AIROHA_PCS_XFI_TXMBI_STOP);
+	ret = an7581_pcs_xpon_quiesce(priv, port->index);
+	if (!ret) {
+		priv->pon_quiesced = true;
+		priv->pon_pma_ready = false;
+	}
+unlock:
+	mutex_unlock(&priv->recovery_lock);
+	rtnl_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_pcs_xpon_quiesce);
+
+int airoha_pcs_xpon_set_mode(struct phylink_pcs *pcs,
+			     enum airoha_pcs_xpon_mode mode)
+{
+	struct airoha_pcs_port *port;
+	struct airoha_pcs_priv *priv;
+	enum airoha_pcs_pon_mode internal;
+	phy_interface_t interface;
+	int ret;
+
+	ret = airoha_pcs_xpon_mode_from_public(mode, &internal);
+	if (ret)
+		return ret;
+	ret = airoha_pcs_xpon_port(pcs, &port);
+	if (ret)
+		return ret;
+	priv = port->priv;
+
+	rtnl_lock();
+	mutex_lock(&priv->recovery_lock);
+	if (!priv->pon_quiesced) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+
+	priv->pon_pma_ready = false;
+	priv->pon_mode = internal;
+	interface = priv->interface == PHY_INTERFACE_MODE_NA ?
+		    PHY_INTERFACE_MODE_2500BASEX : priv->interface;
+	ret = airoha_pcs_setup_scu(priv, port->index, interface);
+	if (ret)
+		goto unlock;
+	ret = priv->data->bringup(priv, port->index, interface);
+	if (!ret)
+		priv->pon_pma_ready = true;
+unlock:
+	mutex_unlock(&priv->recovery_lock);
+	rtnl_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_pcs_xpon_set_mode);
+
+int airoha_pcs_xpon_recover(struct phylink_pcs *pcs)
+{
+	struct airoha_pcs_port *port;
+	struct airoha_pcs_priv *priv;
+	struct airoha_pcs_maps *maps;
+	int ret;
+
+	ret = airoha_pcs_xpon_port(pcs, &port);
+	if (ret)
+		return ret;
+	priv = port->priv;
+	maps = &priv->maps[port->index];
+
+	rtnl_lock();
+	mutex_lock(&priv->recovery_lock);
+	if (!priv->pon_quiesced || !priv->pon_pma_ready) {
+		ret = -EAGAIN;
+		goto unlock;
+	}
+
+	regmap_clear_bits(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG,
+			  AIROHA_PCS_XFI_RXMPI_STOP |
+			  AIROHA_PCS_XFI_RXMBI_STOP |
+			  AIROHA_PCS_XFI_TXMPI_STOP |
+			  AIROHA_PCS_XFI_TXMBI_STOP);
+	priv->pon_quiesced = false;
+	priv->pon_pma_ready = false;
+	ret = 0;
+unlock:
+	mutex_unlock(&priv->recovery_lock);
+	rtnl_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_pcs_xpon_recover);
