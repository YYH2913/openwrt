+				    struct airoha_foe_entry *hwe)
 {
@@ -942,8 +1072,7 @@ airoha_ppe_foe_prepare_wdma_subflow(struct airoha_ppe *ppe,
 	if (!master)
 		return false;
 
-	if (airoha_ppe_foe_prepare_wdma_subflow_dev(ppe, master, &data,
-						    hwe)) {
