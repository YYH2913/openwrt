+static int airoha_xgs_omcc_transmit_skb(
+				      struct net_device *netdev,
+				      struct sk_buff *skb,
+				      const struct airoha_xgs_omcc_tx_metadata *metadata)
+{
+	struct airoha_gdm_dev *dev = netdev_priv(netdev);
+	struct airoha_qdma *qdma;
+	struct airoha_queue_entry *entry, *next_entry;
+	struct airoha_queue *q;
+	struct netdev_queue *txq;
+	dma_addr_t addr;
+	u32 msg0, msg1;
+	u16 qid, index, next_index;
+
+	if (!metadata || !skb->len ||
+	    skb->len > FIELD_MAX(QDMA_DESC_LEN_MASK) ||
+	    metadata->channel > 0x1f || metadata->nboq > 0x1f ||
+	    metadata->mic_idx > 1)
+		return -ERANGE;
+	if (!dev->gpon_mode)
+		return -EOPNOTSUPP;
+
+	rcu_read_lock();
+	qdma = rcu_dereference(dev->qdma);
+	if (!qdma) {
+		rcu_read_unlock();
+		return -ENODEV;
+	}
+	qid = airoha_qdma_get_txq(qdma, AIROHA_NUM_QOS_QUEUES - 1);
+	q = &qdma->q_tx[qid];
+	if (WARN_ON_ONCE(!q->ndesc)) {
+		rcu_read_unlock();
+		return -ENODEV;
+	}
+
+	msg0 = FIELD_PREP(QDMA_ETH_TXMSG_CHAN_MASK, metadata->channel) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_QUEUE_MASK,
+			  qid % AIROHA_NUM_QOS_QUEUES) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_SP_TAG_MASK, metadata->xgem_id) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_MIC_IDX_MASK, metadata->mic_idx) |
+	       QDMA_ETH_TXMSG_OAM_MASK;
+	msg1 = QDMA_ETH_TXMSG_NO_DROP |
+	       FIELD_PREP(QDMA_ETH_TXMSG_NBOQ_MASK, metadata->nboq) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_FPORT_MASK, airoha_get_fe_port(dev)) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_METER_MASK, 0x7f);
+
+	spin_lock_bh(&q->lock);
+	/* Account the skb on the parent queue that maps to QDMA queue 7 so
+	 * completion and shared-QDMA wakeups use the same queue. */
+	skb_set_queue_mapping(skb, AIROHA_NUM_QOS_QUEUES - 1);
+	txq = skb_get_tx_queue(netdev, skb);
+	if (q->queued >= q->ndesc - 1) {
+		netif_tx_stop_queue(txq);
+		q->txq_stopped = true;
+		spin_unlock_bh(&q->lock);
+		rcu_read_unlock();
+		return -EAGAIN;
+	}
+	entry = list_first_entry(&q->tx_list, struct airoha_queue_entry, list);
+	index = entry - q->entry;
+	addr = dma_map_single(netdev->dev.parent, skb->data, skb->len,
+				      DMA_TO_DEVICE);
+	if (dma_mapping_error(netdev->dev.parent, addr)) {
+		spin_unlock_bh(&q->lock);
+		rcu_read_unlock();
+		return -ENOMEM;
+	}
+	list_move_tail(&entry->list, &q->tx_list);
+	next_entry = list_first_entry(&q->tx_list,
+				      struct airoha_queue_entry, list);
+	next_index = next_entry - q->entry;
+	entry->skb = skb;
+	entry->dma_addr = addr;
+	entry->dma_len = skb->len;
+	WRITE_ONCE(q->desc[index].ctrl,
+			   cpu_to_le32(FIELD_PREP(QDMA_DESC_LEN_MASK, skb->len)));
+	WRITE_ONCE(q->desc[index].addr, cpu_to_le32(addr));
+	WRITE_ONCE(q->desc[index].data,
+			   cpu_to_le32(FIELD_PREP(QDMA_DESC_NEXT_ID_MASK,
+						next_index)));
+	WRITE_ONCE(q->desc[index].msg0, cpu_to_le32(msg0));
+	WRITE_ONCE(q->desc[index].msg1, cpu_to_le32(msg1));
+	WRITE_ONCE(q->desc[index].msg2, cpu_to_le32(0xffff));
+	q->queued++;
+	skb_tx_timestamp(skb);
+	netdev_tx_sent_queue(txq, skb->len);
+	if (q->ndesc - q->queued < q->free_thr) {
+		netif_tx_stop_queue(txq);
+		q->txq_stopped = true;
+	}
+	airoha_qdma_rmw(qdma, REG_TX_CPU_IDX(qid), TX_RING_CPU_IDX_MASK,
+			FIELD_PREP(TX_RING_CPU_IDX_MASK, next_index));
+	spin_unlock_bh(&q->lock);
+	rcu_read_unlock();
+	return 0;
+}
+
+int airoha_xgs_omcc_transmit(struct device_node *np, const u8 *data,
+			     size_t len,
+			     const struct airoha_xgs_omcc_tx_metadata *metadata)
+{
+	struct net_device *netdev;
+	struct airoha_gdm_dev *dev;
+	struct sk_buff *skb;
+	int ret;
+
+	if (!np || !data || !metadata || !len ||
+	    len > FIELD_MAX(QDMA_DESC_LEN_MASK))
+		return -EINVAL;
+	netdev = of_find_net_device_by_node(np);
+	if (!netdev)
+		return -ENODEV;
+	dev = netdev_priv(netdev);
+	rcu_read_lock();
+	if (!rcu_access_pointer(dev->xgs_omcc_consumer))
+		ret = -ENODEV;
+	else {
+		rcu_read_unlock();
+		skb = alloc_skb(len, GFP_KERNEL);
+		if (!skb) {
+			put_device(&netdev->dev);
+			return -ENOMEM;
+		}
+		skb_put_data(skb, data, len);
+		skb->dev = netdev;
+		ret = airoha_xgs_omcc_transmit_skb(netdev, skb, metadata);
+		if (ret)
+			dev_kfree_skb_any(skb);
+		put_device(&netdev->dev);
+		return ret;
+	}
+	rcu_read_unlock();
+	put_device(&netdev->dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_xgs_omcc_transmit);
+bool airoha_xgs_omcc_tx_available(struct device_node *np)
+{
+	struct net_device *netdev;
+	struct airoha_gdm_dev *dev;
+	struct airoha_qdma *qdma;
+	struct airoha_queue *q;
+	bool available = false;
+
+	if (!np)
+		return false;
+	netdev = of_find_net_device_by_node(np);
+	if (!netdev)
+		return false;
+	dev = netdev_priv(netdev);
+	rcu_read_lock();
+	if (rcu_access_pointer(dev->xgs_omcc_consumer)) {
+		qdma = rcu_dereference(dev->qdma);
+		if (qdma) {
+			q = &qdma->q_tx[airoha_qdma_get_txq(
+				qdma, AIROHA_NUM_QOS_QUEUES - 1)];
+			spin_lock_bh(&q->lock);
+			available = q->ndesc && q->queued < q->ndesc - 1;
+			spin_unlock_bh(&q->lock);
+		}
+	}
+	rcu_read_unlock();
+	put_device(&netdev->dev);
+	return available;
+}
+EXPORT_SYMBOL_GPL(airoha_xgs_omcc_tx_available);
+int airoha_xgs_omcc_register(struct device_node *np,
+			     const struct airoha_xgs_omcc_ops *ops,
+			     void *context)
+{
+	struct airoha_xgs_omcc_consumer *consumer;
+	struct airoha_gdm_dev *dev;
+	struct net_device *netdev;
+	unsigned long flags;
+	bool gpon_ready;
+	int ret = 0;
+
+	if (!np || !ops || !ops->receive || !context)
+		return -EINVAL;
+
+	consumer = kzalloc(sizeof(*consumer), GFP_KERNEL);
+	if (!consumer)
+		return -ENOMEM;
+	consumer->ops = ops;
+	consumer->context = context;
+
+	netdev = of_find_net_device_by_node(np);
+	if (!netdev) {
+		ret = -ENODEV;
+		goto free;
+	}
+	dev = netdev_priv(netdev);
+	if (!dev->gpon_mode) {
+		ret = -EOPNOTSUPP;
+		goto put;
+	}
+
+	mutex_lock(&dev->xgs_omcc_lock);
+	spin_lock_irqsave(&dev->gpon_lock, flags);
+	gpon_ready = dev->gpon_omcc_ready;
+	spin_unlock_irqrestore(&dev->gpon_lock, flags);
+	if (rcu_access_pointer(dev->xgs_omcc_consumer))
+		ret = -EBUSY;
+	else if (gpon_ready)
+		ret = -EBUSY;
+	else
+		rcu_assign_pointer(dev->xgs_omcc_consumer, consumer);
+	mutex_unlock(&dev->xgs_omcc_lock);
+put:
+	put_device(&netdev->dev);
+free:
+	if (ret)
+		kfree(consumer);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_xgs_omcc_register);
+
+void airoha_xgs_omcc_unregister(struct device_node *np, void *context)
+{
+	struct airoha_xgs_omcc_consumer *consumer = NULL;
+	struct airoha_gdm_dev *dev;
+	struct net_device *netdev;
+
+	if (!np || !context)
+		return;
+	netdev = of_find_net_device_by_node(np);
+	if (!netdev)
+		return;
+	dev = netdev_priv(netdev);
+
+	mutex_lock(&dev->xgs_omcc_lock);
+	consumer = rcu_dereference_protected(dev->xgs_omcc_consumer,
+					     lockdep_is_held(&dev->xgs_omcc_lock));
+	if (consumer && consumer->context == context)
+		RCU_INIT_POINTER(dev->xgs_omcc_consumer, NULL);
+	else
+		consumer = NULL;
+	mutex_unlock(&dev->xgs_omcc_lock);
+	put_device(&netdev->dev);
+
+	if (consumer) {
+		synchronize_net();
+		kfree(consumer);
+	}
+}
