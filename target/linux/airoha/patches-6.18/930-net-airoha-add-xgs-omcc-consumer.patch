From: XG2010G OpenWrt maintainers <xg2010g@example.invalid>
Date: Fri, 14 Aug 2026 01:20:00 +0800
Subject: [PATCH] net: airoha: add XGS-PON service/QDMA data path

Add the XGS-PON OMCC consumer and the native XGEM/T-CONT/QDMA service
backend. Keep XGS state separate from GPON GEM/QoS state, preserve the
full 16-bit XGEM Port-ID in RX/TX metadata, and provide transactional
service provisioning for OMCI.

Signed-off-by: XG2010G OpenWrt maintainers <xg2010g@example.invalid>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -21,6 +21,84 @@
 #include "airoha_regs.h"
 #include "airoha_eth.h"
 
+/* SDK RX descriptor MSG0 bit 30: hardware did not consume an OMCI MIC. */
+#define QDMA_ETH_RXMSG_NO_MIC_MASK	BIT(30)
+
+struct airoha_gdm_dev;
+
+static u32 airoha_gpon_qos_rate(u32 bytes_per_second);
+static int airoha_gpon_program_qos(
+	struct net_device *netdev, const struct airoha_gpon_qos_config *cfg);
+static int airoha_gpon_disable_qos(struct net_device *netdev, u8 channel);
+
+struct airoha_pon_rx_cb {
+	struct airoha_gdm_dev *dev;
+	bool omcc;
+	bool xgs_omcc;
+	bool no_mic;
+	u16 gem;
+};
+
+#define AIROHA_PON_RX_CB(_skb) ((struct airoha_pon_rx_cb *)((_skb)->cb))
+
+static bool airoha_xgs_omcc_consumer_present(struct airoha_gdm_dev *dev)
+{
+	bool present;
+
+	rcu_read_lock();
+	present = rcu_access_pointer(dev->xgs_omcc_consumer);
+	rcu_read_unlock();
+
+	return present;
+}
+
+static void airoha_xgs_omcc_receive(struct airoha_gdm_dev *dev,
+				    struct sk_buff *skb, u16 gem,
+				    bool no_mic)
+{
+	struct airoha_xgs_omcc_metadata metadata = {
+		.xgem_id = gem,
+		.no_mic = no_mic,
+	};
+	struct airoha_xgs_omcc_consumer *consumer;
+
+	rcu_read_lock();
+	consumer = rcu_dereference(dev->xgs_omcc_consumer);
+	if (consumer)
+		consumer->ops->receive(consumer->context, skb, &metadata);
+	else
+		dev_kfree_skb_any(skb);
+	rcu_read_unlock();
+}
+
+static void airoha_xgs_omcc_detach(struct airoha_gdm_dev *dev)
+{
+	struct airoha_xgs_omcc_consumer *consumer;
+
+	mutex_lock(&dev->xgs_omcc_lock);
+	consumer = rcu_dereference_protected(dev->xgs_omcc_consumer,
+					     lockdep_is_held(&dev->xgs_omcc_lock));
+	RCU_INIT_POINTER(dev->xgs_omcc_consumer, NULL);
+	mutex_unlock(&dev->xgs_omcc_lock);
+	if (consumer) {
+		synchronize_net();
+		kfree(consumer);
+	}
+}
+
+static const struct airoha_xgs_service_xgem *
+airoha_xgs_find_xgem(struct airoha_gdm_dev *dev, u16 xgem_id,
+		     u8 direction)
+{
+	unsigned int i;
+
+	for (i = 0; i < dev->xgs_xgem_count; i++)
+		if (dev->xgs_xgems[i].xgem_id == xgem_id &&
+		    (dev->xgs_xgems[i].direction & direction))
+			return &dev->xgs_xgems[i];
+	return NULL;
+}
