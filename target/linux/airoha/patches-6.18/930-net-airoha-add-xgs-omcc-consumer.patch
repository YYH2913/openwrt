+static int airoha_xgs_validate_service(
+	const struct airoha_xgs_service_config *config,
+	unsigned long *channels)
+{
+	unsigned int i, j;
+
+	if (!config || config->version != AIROHA_XGS_SERVICE_ABI_VERSION ||
+	    config->tcont_count >= AIROHA_XGS_SERVICE_MAX_TCONTS ||
+	    config->xgem_count > AIROHA_XGS_SERVICE_MAX_XGEMS ||
+	    (config->tcont_count && !config->tconts) ||
+	    (config->xgem_count && !config->xgems))
+		return -EINVAL;
+	bitmap_zero(channels, AIROHA_XGS_SERVICE_MAX_TCONTS);
+	for (i = 0; i < config->tcont_count; i++) {
+		const struct airoha_xgs_service_tcont *t = &config->tconts[i];
+		bool have_weight = false;
+
+		if (!t->valid || !t->index ||
+		    t->index > AIROHA_XGS_SERVICE_MAX_CHANNEL ||
+		    t->alloc_id > AIROHA_XGS_SERVICE_MAX_ALLOC_ID ||
+		    t->scheduler > 2 || (t->pir && t->cir > t->pir) ||
+		    (t->cir && !airoha_gpon_qos_rate(t->cir)) ||
+		    (t->pir && !airoha_gpon_qos_rate(t->pir)) ||
+		    test_and_set_bit(t->index, channels))
+			return -ERANGE;
+		for (j = 0; j < ARRAY_SIZE(t->queue_weights); j++)
+			have_weight |= t->queue_weights[j] != 0;
+		if (t->scheduler == 2 && !have_weight)
+			return -EINVAL;
+		for (j = 0; j < i; j++)
+			if (config->tconts[j].alloc_id == t->alloc_id)
+				return -EEXIST;
+	}
+	for (i = 0; i < config->xgem_count; i++) {
+		const struct airoha_xgs_service_xgem *x = &config->xgems[i];
+		bool have_tcont = false;
+
+		if (!x->valid || !x->xgem_id ||
+		    x->xgem_id > AIROHA_XGS_SERVICE_MAX_XGEM_ID ||
+		    x->direction < AIROHA_XGS_SERVICE_DIRECTION_DOWNSTREAM ||
+		    x->direction > AIROHA_XGS_SERVICE_DIRECTION_BIDIRECTIONAL ||
+		    x->channel > AIROHA_XGS_SERVICE_MAX_CHANNEL ||
+		    x->nboq > AIROHA_XGS_SERVICE_MAX_NBOQ || x->mic_idx > 1 ||
+		    !x->tcont_index || x->tcont_index > AIROHA_XGS_SERVICE_MAX_CHANNEL)
+			return -ERANGE;
+		for (j = 0; j < config->tcont_count; j++)
+			if (config->tconts[j].index == x->tcont_index)
+				have_tcont = true;
+		if (!have_tcont)
+			return -ENOENT;
+		for (j = 0; j < i; j++)
+			if (config->xgems[j].xgem_id == x->xgem_id)
+				return -EEXIST;
+	}
+	return 0;
+}
+
+static int airoha_xgs_program_qos(struct net_device *netdev,
+				  const struct airoha_xgs_service_tcont *t)
+{
+	struct airoha_gpon_qos_config cfg = {
+		.channel = t->index,
+		.scheduler = t->scheduler,
+		.cir = t->cir,
+		.pir = t->pir,
+		.cbs = t->cbs,
+		.pbs = t->pbs,
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cfg.weights); i++)
+		cfg.weights[i] = t->queue_weights[i];
+	return airoha_gpon_program_qos(netdev, &cfg);
+}
+
+static int airoha_xgs_restore_qos(
+	struct net_device *netdev,
+	const struct airoha_xgs_service_tcont *old,
+	const unsigned long *oldmap, const unsigned long *wanted)
+{
+	unsigned long channel;
+	int first = 0, ret;
+
+	for (channel = 0; channel < AIROHA_XGS_SERVICE_MAX_TCONTS; channel++) {
+		if (test_bit(channel, oldmap))
+			ret = airoha_xgs_program_qos(netdev, &old[channel]);
+		else if (test_bit(channel, wanted))
+			ret = airoha_gpon_disable_qos(netdev, channel);
+		else
+			continue;
+		if (ret && !first)
+			first = ret;
+	}
+	return first;
+}
+
+int airoha_xgs_qdma_service_apply(
+	struct device_node *np, const struct airoha_xgs_service_config *config)
+{
+	DECLARE_BITMAP(acquired, AIROHA_XGS_SERVICE_MAX_TCONTS);
+	DECLARE_BITMAP(wanted, AIROHA_XGS_SERVICE_MAX_TCONTS);
+	DECLARE_BITMAP(oldmap, AIROHA_XGS_SERVICE_MAX_TCONTS);
+	struct airoha_xgs_service_tcont old[AIROHA_XGS_SERVICE_MAX_TCONTS];
+	struct airoha_gdm_dev *dev;
+	struct airoha_qdma *qdma;
+	struct net_device *netdev;
+	unsigned long flags, channel;
+	u16 upstream = 0;
+	bool channel_conflict = false;
+	unsigned int i;
+	u32 old_txchn, new_txchn;
+	int ret;
+
+	if (!np)
+		return -EINVAL;
+	ret = airoha_xgs_validate_service(config, wanted);
+	if (ret)
+		return ret;
+	netdev = of_find_net_device_by_node(np);
+	if (!netdev)
+		return -ENODEV;
+	dev = netdev_priv(netdev);
+	if (!dev->gpon_mode) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+
+	/* Keep the selected QDMA stable while programming shared service state. */
+	mutex_lock(&flow_offload_mutex);
+	mutex_lock(&dev->xgs_service_lock);
+	spin_lock_irqsave(&dev->gpon_lock, flags);
+	if (dev->gpon_tx_ready)
+		ret = -EBUSY;
+	spin_unlock_irqrestore(&dev->gpon_lock, flags);
+	if (ret)
+		goto unlock;
+	bitmap_copy(oldmap, dev->xgs_qos, AIROHA_XGS_SERVICE_MAX_TCONTS);
+	memcpy(old, dev->xgs_qos_cfg, sizeof(old));
+	old_txchn = airoha_fe_rr(dev->eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX));
+	if (!dev->xgs_resource_baseline_valid) {
+		dev->xgs_gdm2_txchn_baseline = old_txchn;
+		for (i = 0; i < AIROHA_XGS_SERVICE_MAX_TCONTS; i++)
+			dev->xgs_pse_rsv_baseline[i] =
+				airoha_fe_get_pse_queue_rsv_pages(
+					dev->eth, FE_PSE_PORT_GDM2, i);
+	}
+	bitmap_zero(acquired, AIROHA_XGS_SERVICE_MAX_TCONTS);
+	qdma = airoha_qdma_deref(dev);
+	if (!qdma)
+		channel_conflict = true;
+	else {
+		for_each_set_bit(channel, wanted,
+				 AIROHA_XGS_SERVICE_MAX_TCONTS) {
+			if (test_bit(channel, dev->xgs_qos))
+				continue;
+			if (test_and_set_bit(channel, qdma->qos_channel_map)) {
+				channel_conflict = true;
+				break;
+			}
+			__set_bit(channel, acquired);
+		}
+	}
+	if (channel_conflict) {
+		ret = -EBUSY;
+		goto release_channels;
+	}
+	new_txchn = dev->xgs_gdm2_txchn_baseline;
+	for_each_set_bit(channel, wanted, AIROHA_XGS_SERVICE_MAX_TCONTS)
+		new_txchn |= BIT(channel);
+
+	for (i = 0; i < config->tcont_count; i++) {
+		ret = airoha_xgs_program_qos(netdev, &config->tconts[i]);
+		if (ret)
+			goto restore_qos;
+	}
+	for_each_set_bit(channel, dev->xgs_qos,
+			 AIROHA_XGS_SERVICE_MAX_TCONTS) {
+		if (test_bit(channel, wanted))
+			continue;
+		ret = airoha_gpon_disable_qos(netdev, channel);
+		if (ret)
+			goto restore_qos;
+	}
+
+	for (i = 0; i < AIROHA_XGS_SERVICE_MAX_TCONTS; i++) {
+		bool wanted_channel = test_bit(i, wanted);
+		u32 reserve = wanted_channel ? PSE_QUEUE_RSV_PAGES :
+			dev->xgs_pse_rsv_baseline[i];
+
+		if ((old_txchn ^ new_txchn) & BIT(i))
+			airoha_fe_rmw(dev->eth,
+				REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX), BIT(i),
+				new_txchn & BIT(i));
+		ret = airoha_fe_set_pse_oq_rsv(dev->eth, FE_PSE_PORT_GDM2,
+						 i, reserve);
+		if (ret)
+			goto restore_resources;
+	}
+	for (i = 0; i < config->xgem_count; i++)
+		if (config->xgems[i].direction &
+		    AIROHA_XGS_SERVICE_DIRECTION_UPSTREAM)
+			upstream++;
+
+	spin_lock_irqsave(&dev->xgs_service_state_lock, flags);
+	dev->xgs_service_active = false;
+	memcpy(dev->xgs_xgems, config->xgems,
+	       config->xgem_count * sizeof(*config->xgems));
+	dev->xgs_xgem_count = config->xgem_count;
+	dev->xgs_upstream_count = upstream;
+	dev->xgs_service_active = config->xgem_count != 0;
+	spin_unlock_irqrestore(&dev->xgs_service_state_lock, flags);
+	bitmap_copy(dev->xgs_qos, wanted, AIROHA_XGS_SERVICE_MAX_TCONTS);
+	memset(dev->xgs_qos_cfg, 0, sizeof(dev->xgs_qos_cfg));
+	for (i = 0; i < config->tcont_count; i++)
+		dev->xgs_qos_cfg[config->tconts[i].index] = config->tconts[i];
+	for_each_set_bit(channel, oldmap, AIROHA_XGS_SERVICE_MAX_TCONTS)
+		if (!test_bit(channel, wanted))
+			clear_bit(channel, qdma->qos_channel_map);
+	dev->xgs_resource_baseline_valid = true;
+	goto unlock;
+
+restore_resources:
+	airoha_fe_wr(dev->eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX), old_txchn);
+	for (i = 0; i < AIROHA_XGS_SERVICE_MAX_TCONTS; i++)
+		airoha_fe_set_pse_oq_rsv(dev->eth, FE_PSE_PORT_GDM2, i,
+			test_bit(i, oldmap) ? PSE_QUEUE_RSV_PAGES :
+			dev->xgs_pse_rsv_baseline[i]);
+restore_qos:
+	if (airoha_xgs_restore_qos(netdev, old, oldmap, wanted))
+		netdev_err(netdev, "failed to restore XGS-PON QoS state\n");
+release_channels:
+	if (qdma)
+		for_each_set_bit(channel, acquired, AIROHA_XGS_SERVICE_MAX_TCONTS)
+			clear_bit(channel, qdma->qos_channel_map);
+unlock:
+	mutex_unlock(&dev->xgs_service_lock);
+	mutex_unlock(&flow_offload_mutex);
+out:
+	put_device(&netdev->dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_xgs_qdma_service_apply);
+
+int airoha_xgs_qdma_service_clear(struct device_node *np)
+{
+	struct airoha_xgs_service_config empty = {
+		.version = AIROHA_XGS_SERVICE_ABI_VERSION,
+	};
+
+	return airoha_xgs_qdma_service_apply(np, &empty);
+}
+EXPORT_SYMBOL_GPL(airoha_xgs_qdma_service_clear);
