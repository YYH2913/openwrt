/dts-v1/;

/* The vendor first-stage loader installs ATF here. */
/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "an7581.dtsi"

/ {
	model = "Axon Networks XG2010G (OpenWrt UBI layout)";
	compatible = "axon,xg2010g", "econet,xg2010g",
		     "econet,en7581", "airoha,an7581", "airoha,en7581";

	aliases {
		serial0 = &uart1;
		led-boot = &led_status_red;
		led-failsafe = &led_status_blue;
		led-upgrade = &led_status_white;
		led-running = &led_status_green;
	};

	chosen {
		rootdisk = <&ubi_rootfs>;
		bootargs = "console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait";
		stdout-path = "serial0:115200n8";
		linux,usable-memory-range = <0x0 0x80200000 0x0 0x3fe00000>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};

	gpon: gpon@1fb64000 {
		compatible = "airoha,en7581-gpon";
		reg = <0x0 0x1fb64000 0x0 0x3e8>,
		      <0x0 0x1faf0000 0x0 0x1000>;
		reg-names = "mac", "phy-csr";
		interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "mac", "phy";
		bosa-controller = <&en7572>;
		airoha,xpon-controller = <&xpon_controller>;
		airoha,pcs = <&pon_pcs>;
		airoha,scu = <&scuclk>;
		ethernet = <&gdm2>;
		airoha,idle-gem-threshold = <0x1a>;
		status = "okay";
	};

	xgspon: xgspon@1fb65000 {
		compatible = "airoha,en7581-xgspon";
		reg = <0x0 0x1fb65000 0x0 0xff8>,
		      <0x0 0x1faf0000 0x0 0x1000>;
		reg-names = "mac", "phy-csr";
		interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "mac", "phy";
		bosa-controller = <&en7572>;
		airoha,xpon-controller = <&xpon_controller>;
		airoha,pcs = <&pon_pcs>;
		pcs-handle = <&pon_pcs>;
		ethernet = <&gdm2>;
		status = "okay";
	};

	epon: epon@1fb66000 {
		compatible = "airoha,en7581-epon";
		reg = <0x0 0x1fb66000 0x0 0x700>,
		      <0x0 0x1faf0000 0x0 0x1000>,
		      <0x0 0x1faf1000 0x0 0x1000>;
		reg-names = "mac", "phy-csr", "xepon-pcs";
		interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "mac", "phy";
		bosa-controller = <&en7572>;
		airoha,xpon-controller = <&xpon_controller>;
		airoha,pcs = <&pon_pcs>;
		pcs-handle = <&pon_pcs>;
		airoha,scu = <&scuclk>;
		ethernet = <&gdm2>;
		airoha,llid-mask = <0x1>;
		status = "okay";
	};

	xpon_controller: xpon-controller {
		compatible = "airoha,en7581-xpon-core";
		interrupts = <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "dying-gasp";
		bosa-controller = <&en7572>;
		pcs-handle = <&pon_pcs>;
		airoha,scu = <&scuclk>;
		status = "okay";
	};

	keys {
		compatible = "gpio-keys";

		key-restart {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status_red: led-status-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 43 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led_status_green: led-status-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 44 GPIO_ACTIVE_LOW>;
		};

		led_status_blue: led-status-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 45 GPIO_ACTIVE_LOW>;
		};

		led_status_white: led-status-white {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 33 GPIO_ACTIVE_LOW>;
		};

		led_lan_green: led-lan-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&en7581_pinctrl 46 GPIO_ACTIVE_LOW>;
		};

		led_lan_yellow: led-lan-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_LAN;
			gpios = <&en7581_pinctrl 42 GPIO_ACTIVE_LOW>;
		};

		/* Stock XG2010G assigns GPIO14/15/16 to the PON indicators. */
		led_pon_activity_green: led-pon-activity-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_ACTIVITY;
			gpios = <&en7581_pinctrl 14 GPIO_ACTIVE_LOW>;
		};

		led_pon_link_green: led-pon-link-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
		};

		led_pon_link_red: led-pon-link-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 16 GPIO_ACTIVE_LOW>;
		};

	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 47>;

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};

		conf {
			pins = "gpio2";
			output-high;
		};
	};
};

&snfi {
	status = "okay";
};

&spi_nand {
	/* Match the stock loader's raw NAND ECC settings. */
	nand-ecc-mode = "none";
	nand-ecc-step-size = <2048>;
	nand-ecc-strength = <0>;

	#address-cells = <1>;
	#size-cells = <1>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "vendor";
			reg = <0x00000000 0x00600000>;
			read-only;
		};

		partition@600000 {
			label = "chainloader";
			reg = <0x00600000 0x00100000>;
			read-only;
		};

		partition@700000 {
			label = "ubi";
			reg = <0x00700000 0x1b600000>;
			compatible = "linux,ubi";

			volumes {
				ubi-volume-ubootenv {
					volname = "ubootenv";
					nvmem-layout {
						compatible = "u-boot,env-redundant-bool";
					};
				};

				ubi-volume-ubootenv2 {
					volname = "ubootenv2";
					nvmem-layout {
						compatible = "u-boot,env-redundant-bool";
					};
				};

				ubi-volume-uboot {
					volname = "uboot";
				};

				ubi_rootfs: ubi-volume-fit {
					volname = "fit";
				};
			};
		};

		art: partition@1bd00000 {
			label = "art";
			reg = <0x1bd00000 0x00300000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				en7572_bob_gpon: calibration@51000 {
					reg = <0x51000 0x201>;
				};

				en7572_bob_xgspon: calibration@52000 {
					reg = <0x52000 0x201>;
				};
			};
		};

		/* Keep the final 64 MiB for NAND BMT/BBT data. */
		partition@1c000000 {
			label = "reserved_bmt";
			reg = <0x1c000000 0x04000000>;
			read-only;
		};
	};
};

&npu {
	status = "okay";
};

&i2c0 {
	status = "okay";

	en7572: bosa-controller@50 {
		compatible = "airoha,en7572";
		reg = <0x50>;
		tx-disable-gpios = <&en7581_pinctrl 38 GPIO_ACTIVE_HIGH>;
		airoha,pon-mode = "gpon";
		nvmem-cells = <&en7572_bob_gpon>, <&en7572_bob_xgspon>;
		nvmem-cell-names = "calibration-gpon", "calibration-10g";
		airoha,pm-firmware = "airoha/xg2010g/en7572-A60993.pm";
		airoha,dm-firmware = "airoha/xg2010g/en7572-A60993.dm";
		/* Temporary lab table: A2 optical data is mirrored into A0. */
		airoha,calibration-10g-firmware =
			"airoha/xg2010g/en7572-bob-a2-as-a0.bin";
		airoha,calibration-10g-a2-as-a0;
	};
};

&eth {
	status = "okay";

	gdm3: ethernet@3 {
		compatible = "airoha,eth-mac";
		reg = <3>;
		status = "okay";

		#address-cells = <1>;
		#size-cells = <0>;

		lan2_port: ethernet-port@5 {
			compatible = "airoha,eth-port";
			reg = <5>;
			managed = "in-band-status";
			phy-handle = <&rtl8261_lan2>;
			phy-mode = "usxgmii";
			pcs-handle = <&pcie_pcs 1>;
			openwrt,netdev-name = "lan2";
		};
	};
};

&eth_pcs {
	status = "okay";
};

&pcie_pcs {
	/* WiFi2/PCIe1 Multi-SerDes lane is wired to the second 10G PHY. */
	status = "okay";
};

&usb_pcs {
	/* USB Multi-SerDes lane is used by the 2.5G LAN PHY. */
	status = "okay";
};

&pon_pcs {
	status = "okay";
	airoha,pon-mode = "gpon";
};

&gdm1 {
	status = "okay";
};

&gdm2 {
	status = "okay";
	phy-mode = "2500base-x";
	airoha,gpon-mode;
	openwrt,netdev-name = "pon";

	fixed-link {
		speed = <2500>;
		full-duplex;
	};
};

&gdm4 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	lan1_port: ethernet-port@0 {
		compatible = "airoha,eth-port";
		reg = <0>;
		managed = "in-band-status";
		phy-handle = <&rtl8261_lan1>;
		phy-mode = "usxgmii";
		pcs-handle = <&eth_pcs>;
		openwrt,netdev-name = "lan1";
	};

	lan3_port: ethernet-port@1 {
		compatible = "airoha,eth-port";
		reg = <1>;
		managed = "in-band-status";
		phy-handle = <&en8811h>;
		phy-mode = "2500base-x";
		pcs-handle = <&usb_pcs>;
		openwrt,netdev-name = "lan3";
	};
};

&switch {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
};

&gsw_port1 {
	status = "okay";
	label = "lan4";
};

&gsw_phy1 {
	status = "okay";
	interrupts = <1>;
};

&mdio {
	/* XG2010G LAN1: RTL8261 on the Ethernet Multi-SerDes lane. */
	rtl8261_lan1: ethernet-phy@5 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <5>;
		reset-gpios = <&en7581_pinctrl 29 GPIO_ACTIVE_LOW>;
		reset-assert-us = <200000>;
		reset-deassert-us = <200000>;
	};

	/* XG2010G LAN2: RTL8261 on the WiFi2/PCIe1 Multi-SerDes lane. */
	rtl8261_lan2: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <8>;
		reset-gpios = <&en7581_pinctrl 27 GPIO_ACTIVE_LOW>;
		reset-assert-us = <200000>;
		reset-deassert-us = <200000>;
	};

	/* XG2010G LAN3: Airoha EN8811H on the USB Multi-SerDes lane. */
	en8811h: ethernet-phy@f {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <15>;
		reset-gpios = <&en7581_pinctrl 31 GPIO_ACTIVE_LOW>;
		reset-assert-us = <1000000>;
		reset-deassert-us = <150000>;
	};

	en8811h_aux1: ethernet-phy@d {
		reg = <13>;
		status = "disabled";
	};

	en8811h_aux2: ethernet-phy@e {
		reg = <14>;
		status = "disabled";
	};
};
