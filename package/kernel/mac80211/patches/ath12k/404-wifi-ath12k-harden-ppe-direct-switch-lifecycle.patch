-	u32 config = 0;
+	u32 refcount;
+	int bank_id = DP_INVALID_BANK_ID;
+	int released_search = -1, released_bank = DP_INVALID_BANK_ID;
 	int profile, search_idx;
-	int vp;
+	int ret, vp;
 
 	if (!ppe->started || !wdev || !wdev->netdev)
 		return 0;
@@ -747,14 +846,14 @@ int ath12k_ppe_ds_vif_attach(struct ath1
 	    vif->type != NL80211_IFTYPE_STATION)
 		return 0;
 	if (arvif->ppe_vp >= 64)
-		return 0;
+		return ath12k_ppe_ds_vif_program(arvif);
 
 	vp = qcom_ppe_ds_vp_alloc(ppe->node, wdev->netdev);
 	if (vp < 0)
 		return vp;
 
 	profile = ath12k_ppe_ds_vp_profile_alloc(ppe, vp, vif->type,
-						 &search_idx);
+						 &search_idx, &refcount);
 	if (profile < 0) {
 		qcom_ppe_ds_vp_free(ppe->node, vp);
 		return profile;
@@ -763,13 +862,34 @@ int ath12k_ppe_ds_vif_attach(struct ath1
 	arvif->ppe_vp = vp;
 	arvif->ppe_vp_profile = profile;
 	arvif->ppe_search_idx = search_idx;
-	config |= u32_encode_bits(vp, ATH12K_PPE_VP_NUM) |
-		  u32_encode_bits(arvif->ar->lmac_id, ATH12K_PPE_VP_PMAC_ID) |
-		  u32_encode_bits(arvif->bank_id, ATH12K_PPE_VP_BANK_ID) |
-		  u32_encode_bits(arvif->vdev_id, ATH12K_PPE_VP_VDEV_ID) |
-		  u32_encode_bits(search_idx, ATH12K_PPE_VP_SEARCH_IDX);
-	ath12k_ppe_ds_vp_write(arvif, profile, config);
+	if (refcount > 1) {
+		bank_id = ath12k_ppe_ds_vp_shared_bank(arvif, profile);
+		if (bank_id == DP_INVALID_BANK_ID) {
+			ret = -ENOSPC;
+			goto err_profile;
+		}
+	}
+
+	ret = ath12k_ppe_ds_vif_program(arvif);
+	if (ret)
+		goto err_profile;
+
+	ath12k_info(ab,
+		    "PPE direct-switch vdev %u attached: netdev=%s vp=%d profile=%d bank=%d refs=%u\n",
+		    arvif->vdev_id, wdev->netdev->name, vp, profile,
+		    refcount > 1 ? bank_id : arvif->bank_id, refcount);
 	return 0;
+
+err_profile:
+	ath12k_ppe_ds_vp_profile_put(ppe, profile, &released_search,
+				     &released_bank);
+	if (released_bank != DP_INVALID_BANK_ID)
+		ath12k_dp_tx_put_bank_profile(&ab->dp, released_bank);
+	qcom_ppe_ds_vp_free(ppe->node, vp);
+	arvif->ppe_vp = -1;
+	arvif->ppe_vp_profile = -1;
+	arvif->ppe_search_idx = -1;
+	return ret;
 }
 
