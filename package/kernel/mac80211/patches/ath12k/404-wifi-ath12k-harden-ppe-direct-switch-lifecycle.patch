+static int
+ath12k_ppe_ds_vp_shared_bank(struct ath12k_link_vif *arvif, int idx)
+{
+	struct ath12k_base *ab = arvif->ar->ab;
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct ath12k_ppe_ds_vp_profile *profile;
+	int allocated, bank_id, vp;
+
+	spin_lock_bh(&ppe->vp_lock);
+	profile = &ppe->vp_profiles[idx];
+	vp = profile->vp;
+	bank_id = profile->bank_id;
+	spin_unlock_bh(&ppe->vp_lock);
+	if (vp != arvif->ppe_vp)
+		return -ENOENT;
+	if (bank_id != DP_INVALID_BANK_ID)
+		return bank_id;
+
+	allocated = ath12k_dp_tx_get_ppe_ds_bank_profile(ab, arvif, &ab->dp);
+	if (allocated == DP_INVALID_BANK_ID)
+		return allocated;
+
+	spin_lock_bh(&ppe->vp_lock);
+	if (!test_bit(idx, &ppe->vp_profile_map) || profile->vp != vp) {
+		bank_id = DP_INVALID_BANK_ID;
+	} else if (profile->bank_id == DP_INVALID_BANK_ID) {
+		profile->bank_id = allocated;
+		bank_id = allocated;
+		allocated = DP_INVALID_BANK_ID;
+	} else {
+		bank_id = profile->bank_id;
+	}
+	spin_unlock_bh(&ppe->vp_lock);
+
+	if (allocated != DP_INVALID_BANK_ID)
+		ath12k_dp_tx_put_bank_profile(&ab->dp, allocated);
+	return bank_id;
+}
+
 static bool
 ath12k_ppe_ds_vp_profile_put(struct ath12k_ppe_ds *ppe, int idx,
-			     int *search_idx)
+			     int *search_idx, int *bank_id)
 {
 	struct ath12k_ppe_ds_vp_profile *profile;
 	bool last = false;
@@ -716,30 +767,78 @@ ath12k_ppe_ds_vp_profile_put(struct ath1
 		goto out;
 
 	profile = &ppe->vp_profiles[idx];
+	if (!profile->refcount)
+		goto out;
 	if (--profile->refcount)
 		goto out;
 
 	*search_idx = profile->search_idx;
+	*bank_id = profile->bank_id;
 	if (*search_idx >= 0 && *search_idx < ATH12K_PPE_SEARCH_TABLE_SIZE)
 		__clear_bit(*search_idx, &ppe->search_idx_map);
 	__clear_bit(idx, &ppe->vp_profile_map);
 	profile->vp = -1;
 	profile->search_idx = -1;
+	profile->bank_id = DP_INVALID_BANK_ID;
 	last = true;
 out:
 	spin_unlock_bh(&ppe->vp_lock);
 	return last;
 }
 
+static int ath12k_ppe_ds_vif_program(struct ath12k_link_vif *arvif)
+{
+	struct ath12k_base *ab = arvif->ar->ab;
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct ath12k_ppe_ds_vp_profile *profile;
+	u32 config, refcount;
+	int bank_id;
+	u8 pmac_id;
+
+	if (arvif->ppe_vp_profile < 0 ||
+	    arvif->ppe_vp_profile >= ATH12K_PPE_DS_VP_PROFILES)
+		return -EINVAL;
+
+	spin_lock_bh(&ppe->vp_lock);
+	if (!test_bit(arvif->ppe_vp_profile, &ppe->vp_profile_map)) {
+		spin_unlock_bh(&ppe->vp_lock);
+		return -ENOENT;
+	}
+	profile = &ppe->vp_profiles[arvif->ppe_vp_profile];
+	refcount = profile->refcount;
+	bank_id = profile->bank_id;
+	spin_unlock_bh(&ppe->vp_lock);
+
+	pmac_id = arvif->ar->lmac_id;
+	if (refcount > 1) {
+		if (bank_id == DP_INVALID_BANK_ID)
+			return -EINVAL;
+		pmac_id = ATH12K_PPE_VP_WILDCARD_PMAC_ID;
+	} else {
+		bank_id = arvif->bank_id;
+	}
+
+	config = u32_encode_bits(arvif->ppe_vp, ATH12K_PPE_VP_NUM) |
+		 u32_encode_bits(pmac_id, ATH12K_PPE_VP_PMAC_ID) |
+		 u32_encode_bits(bank_id, ATH12K_PPE_VP_BANK_ID) |
+		 u32_encode_bits(arvif->vdev_id, ATH12K_PPE_VP_VDEV_ID) |
+		 u32_encode_bits(arvif->ppe_search_idx,
+				 ATH12K_PPE_VP_SEARCH_IDX);
+	ath12k_ppe_ds_vp_write(arvif, arvif->ppe_vp_profile, config);
+	return 0;
+}
