From: Pavankumar Nandeshwar <pnandesh@qti.qualcomm.com>
Date: Mon, 4 Aug 2025 19:18:12 +0530
Subject: [PATCH] wifi: ath12k: batch PPE direct-switch completions

WBM cookie conversion returns a PPE TX descriptor virtual address.  Validate
it through the descriptor's cookie and the SPT instead of scanning all 16
descriptor pages for every packet.  Besides making the completion lookup
constant time, the exact pointer comparison rejects unaligned addresses into
the middle of a descriptor.

REO2PPE completion currently acquires the RX refill SRNG lock and performs a
full SRNG access transaction for every packet.  Group completed descriptors
by their WSI source device and return each group in one transaction, matching
the vendor driver's batched refill model.  Mark a descriptor CPU-owned before
queuing it so a duplicate completion cannot insert the same list node twice.

Based-on: 41c027804556a6adc68fa0d79400fb96655a909e
Link: https://git.codelinaro.org/clo/qsdk/oss/system/feeds/wlan-open/-/blob/1ee3a4ab7c59ceaff347c4668fc6c7604a04c323/patches/ath12k/0486-QSDK-DP-wifi-ath12k-Fixes-to-improve-DS-DL-performan.patch
Signed-off-by: Pavankumar Nandeshwar <pnandesh@qti.qualcomm.com>
Assisted-by: Codex:GPT-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 drivers/net/wireless/ath/ath12k/ppe.c | 90 ++++++++++++++++++++++------------
 1 file changed, 60 insertions(+), 30 deletions(-)

--- a/drivers/net/wireless/ath/ath12k/ppe.c
+++ b/drivers/net/wireless/ath/ath12k/ppe.c
@@ -78,18 +78,18 @@ ath12k_ppe_ds_tx_desc_valid(struct ath12
 ath12k_ppe_ds_tx_desc_valid(struct ath12k_base *ab,
 			    struct ath12k_ppe_ds_tx_desc *desc)
 {
-	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
-	int i;
+	u32 cookie;
 
-	if (!desc || !ppe->tx_desc_pages)
+	if (!desc || !virt_addr_valid(desc) ||
+	    !virt_addr_valid((u8 *)desc + sizeof(*desc) - 1) ||
+	    !IS_ALIGNED((uintptr_t)desc, __alignof__(*desc)))
 		return false;
 
-	for (i = 0; i < DP_PPE_DS_TX_SPT_PAGES; i++)
-		if (desc >= ppe->tx_desc_pages[i] &&
-		    desc < ppe->tx_desc_pages[i] + ATH12K_MAX_SPT_ENTRIES)
-			return true;
-
-	return false;
+	/* Cookie lookup both identifies the page in constant time and requires
+	 * the completion address to point at the start of that exact descriptor.
+	 */
+	cookie = READ_ONCE(desc->cookie);
+	return ath12k_ppe_ds_tx_desc_get(ab, cookie) == desc;
 }
 
 static void
@@ -292,46 +292,60 @@ static void ath12k_ppe_ds_ppe2tcl_releas
 	ath12k_ppe_ds_tx_desc_release(ab, desc);
 }
 
-static bool
-ath12k_ppe_ds_rx_requeue(struct ath12k_base *ab,
-			 struct ath12k_rx_desc_info *rx_desc)
+static u32 ath12k_ppe_ds_rx_requeue(struct ath12k_base *ab,
+				    struct list_head *completed)
 {
 	struct dp_rxdma_ring *rx_ring = &ab->dp.rx_refill_buf_ring;
+	struct ath12k_rx_desc_info *rx_desc, *tmp;
 	struct ath12k_buffer_addr *ring_desc;
 	struct hal_srng *srng;
-	struct sk_buff *skb = rx_desc->skb;
+	struct sk_buff *skb;
 	dma_addr_t paddr;
+	u32 done = 0;
 	u32 len;
 
-	if (!skb)
-		return false;
-
-	paddr = ATH12K_SKB_RXCB(skb)->paddr;
-	len = skb->len + skb_tailroom(skb);
 	srng = &ab->hal.srng_list[rx_ring->refill_buf_ring.ring_id];
 
 	spin_lock_bh(&srng->lock);
 	ath12k_hal_srng_access_begin(ab, srng);
-	ring_desc = ath12k_hal_srng_src_get_next_entry(ab, srng);
-	if (ring_desc) {
+	list_for_each_entry_safe(rx_desc, tmp, completed, list) {
+		skb = rx_desc->skb;
+		paddr = ATH12K_SKB_RXCB(skb)->paddr;
+		len = skb->len + skb_tailroom(skb);
+		ring_desc = ath12k_hal_srng_src_get_next_entry(ab, srng);
+		if (!ring_desc)
+			break;
+
 		dma_sync_single_for_device(ab->dev, paddr, len, DMA_FROM_DEVICE);
 		ath12k_hal_rx_buf_addr_info_set(ring_desc, paddr, rx_desc->cookie,
 					       ab->hw_params->hal_params->rx_buf_rbm);
+		rx_desc->in_use = true;
+		list_del_init(&rx_desc->list);
+		done++;
 	}
 	ath12k_hal_srng_access_end(ab, srng);
 	spin_unlock_bh(&srng->lock);
 
-	if (ring_desc)
-		return true;
+	if (list_empty(completed))
+		return done;
 
-	dma_unmap_single(ab->dev, paddr, len, DMA_FROM_DEVICE);
-	dev_kfree_skb_any(skb);
-	rx_desc->skb = NULL;
-	rx_desc->in_use = false;
+	/* A full refill ring cannot retain ownership of the remaining DMA
+	 * buffers.  Release them and return their descriptors to the normal RX
+	 * free list so a later replenish can allocate replacements.
+	 */
+	list_for_each_entry(rx_desc, completed, list) {
+		skb = rx_desc->skb;
+		paddr = ATH12K_SKB_RXCB(skb)->paddr;
+		len = skb->len + skb_tailroom(skb);
+		dma_unmap_single(ab->dev, paddr, len, DMA_FROM_DEVICE);
+		dev_kfree_skb_any(skb);
+		rx_desc->skb = NULL;
+	}
 	spin_lock_bh(&ab->dp.rx_desc_lock);
-	list_add_tail(&rx_desc->list, &ab->dp.rx_desc_free_list);
+	list_splice_tail_init(completed, &ab->dp.rx_desc_free_list);
 	spin_unlock_bh(&ab->dp.rx_desc_lock);
-	return false;
+
+	return done;
 }
 
 static struct ath12k_base *
@@ -345,4 +359,5 @@ ath12k_ppe_ds_rx_desc_owner(struct ath12
 	if (!ab->ag || !rx_desc || !virt_addr_valid(rx_desc) ||
+	    !virt_addr_valid((u8 *)rx_desc + sizeof(*rx_desc) - 1) ||
 	    !IS_ALIGNED((uintptr_t)rx_desc, __alignof__(*rx_desc)))
 		return NULL;
 
@@ -388,25 +403,41 @@ ath12k_ppe_ds_reo2ppe_complete(struct qc
 {
 	struct ath12k_base *ab = ath12k_ppe_ds_ab(node);
 	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct list_head completed[ATH12K_MAX_DEVICES];
+	struct ath12k_base *owners[ATH12K_MAX_DEVICES] = {};
 	struct ath12k_rx_desc_info *rx_desc;
 	struct ath12k_base *src_ab;
-	u32 i;
+	u32 i, requeued = 0;
+
+	for (i = 0; i < ATH12K_MAX_DEVICES; i++)
+		INIT_LIST_HEAD(&completed[i]);
 
 	for (i = 0; i < count; i++) {
 		rx_desc = (void *)(uintptr_t)buffers[i].cookie;
 		src_ab = ath12k_ppe_ds_rx_desc_owner(ab, rx_desc);
 		if (!src_ab || rx_desc->magic != ATH12K_DP_RX_DESC_MAGIC ||
-		    rx_desc->device_id != src_ab->device_id) {
-			atomic64_inc(&ppe->stats.rx_drop);
+		    rx_desc->device_id != src_ab->device_id ||
+		    !rx_desc->in_use || !READ_ONCE(rx_desc->skb))
 			continue;
-		}
 
-		if (!ath12k_ppe_ds_rx_requeue(src_ab, rx_desc))
-			atomic64_inc(&ppe->stats.rx_drop);
-		else
-			atomic64_inc(&ppe->stats.rx_requeue);
+		/* Completion transfers ownership from REO/PPE back to the CPU.
+		 * Clearing in_use also rejects a duplicate cookie in this batch.
+		 */
+		rx_desc->in_use = false;
+		list_add_tail(&rx_desc->list,
+			      &completed[src_ab->device_id]);
+		owners[src_ab->device_id] = src_ab;
 	}
 
+	for (i = 0; i < ab->ag->num_devices; i++) {
+		if (list_empty(&completed[i]))
+			continue;
+		src_ab = owners[i];
+		requeued += ath12k_ppe_ds_rx_requeue(src_ab, &completed[i]);
+	}
+
+	atomic64_add(requeued, &ppe->stats.rx_requeue);
+	atomic64_add(count - requeued, &ppe->stats.rx_drop);
 	atomic64_add(count, &ppe->stats.rx_complete);
 	ath12k_ppe_ds_reo_cons_update(ab);
 }
-- 
