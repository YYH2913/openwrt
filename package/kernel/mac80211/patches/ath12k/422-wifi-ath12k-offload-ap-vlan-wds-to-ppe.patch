+	if (!vlan || !parent || !parent->ar || !vlan->ppe_vlan_peer_valid)
+		return -EINVAL;
+	ab = parent->ar->ab;
+	if (!ab->dp.ppe_ds.started || vlan->ppe_vlan_ab != ab ||
+	    vlan->ppe_vlan_vp < 64)
+		return -ENODEV;
+
+	ret = ath12k_ppe_ds_peer_route_set(parent->ar, parent->vdev_id,
+					   vlan->ppe_vlan_vp,
+					   vlan->ppe_vlan_peer,
+					   vlan->ppe_vlan_link_peer,
+					   true, enable);
+	if (ret) {
+		ath12k_warn(ab,
+			    "failed to %s PPE AP_VLAN route for peer %pM vdev %u VP %d: %d\n",
+			    enable ? "enable" : "disable",
+			    vlan->ppe_vlan_link_peer, parent->vdev_id,
+			    vlan->ppe_vlan_vp, ret);
+		if (enable)
+			vlan->ppe_vlan_route_programmed = false;
+		return ret;
+	}
+
+	vlan->ppe_vlan_route_programmed = enable;
+	return 0;
