 }
 
+#ifdef CPTCFG_ATH12K_PPE_DS_SUPPORT
+static void ath12k_mac_op_sta_set_4addr(struct ieee80211_hw *hw,
+					struct ieee80211_vif *vif,
+					struct ieee80211_sta *sta,
+					bool enabled)
+{
+	struct ath12k_vif *vlan = ath12k_vif_to_ahvif(vif);
