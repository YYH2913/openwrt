+void ath12k_ppe_ds_vlan_sta_remove(struct ath12k_sta *ahsta)
+{
+	struct ath12k_vif *vlan = ahsta->ppe_vlan;
+	struct ath12k_link_sta *arsta = &ahsta->deflink;
+	struct ath12k_link_vif *parent;
