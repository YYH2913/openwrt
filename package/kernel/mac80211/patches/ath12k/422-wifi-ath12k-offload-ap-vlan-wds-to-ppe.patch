+		link_ret = qcom_ppe_ds_vp_peer_set(ppe->node, vp, link_peer,
+						   false);
+		if (!map_ret)
+			map_ret = link_ret;
+	}
+	return ret ?: map_ret;
+
+disable_wmi:
+	ath12k_wmi_config_peer_ppeds_routing(ar, link_peer, vdev_id, vp,
+					     false);
+	return map_ret;
