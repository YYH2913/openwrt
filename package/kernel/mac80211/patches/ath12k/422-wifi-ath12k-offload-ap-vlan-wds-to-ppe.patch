+	if (!vlan)
+		return;
+	parent = vlan->ppe_parent ? &vlan->ppe_parent->deflink : NULL;
+	if (vlan->ppe_vlan_route_programmed && parent && parent->ar &&
+	    arsta->arvif == parent)
+		ath12k_ppe_ds_peer_route(parent->ar, parent, arsta, false);
