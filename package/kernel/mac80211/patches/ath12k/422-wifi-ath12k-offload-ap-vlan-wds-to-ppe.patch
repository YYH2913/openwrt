+	if (enable) {
+		if (ret)
+			return ret;
+		map_ret = qcom_ppe_ds_vp_peer_set(ppe->node, vp, peer, true);
+		if (map_ret)
+			goto disable_wmi;
+		if (!ether_addr_equal(peer, link_peer)) {
+			map_ret = qcom_ppe_ds_vp_peer_set(ppe->node, vp,
+							  link_peer, true);
+			if (map_ret) {
+				qcom_ppe_ds_vp_peer_set(ppe->node, vp, peer, false);
+				goto disable_wmi;
+			}
+		}
+		return 0;
+	}
+
+	map_ret = qcom_ppe_ds_vp_peer_set(ppe->node, vp, peer, false);
+	if (!ether_addr_equal(peer, link_peer)) {
+		int link_ret;
