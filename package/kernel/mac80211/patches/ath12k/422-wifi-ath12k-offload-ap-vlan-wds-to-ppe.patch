+}
+#endif
+
 static int ath12k_mac_op_sta_set_txpwr(struct ieee80211_hw *hw,
 				       struct ieee80211_vif *vif,
 				       struct ieee80211_sta *sta)
@@ -10085,6 +10116,10 @@ static int ath12k_mac_op_add_interface(struct ieee80211_hw *hw,
 {
 	struct ath12k_hw *ah = ath12k_hw_to_ah(hw);
 	struct ath12k_vif *ahvif = ath12k_vif_to_ahvif(vif);
+#ifdef CPTCFG_ATH12K_PPE_DS_SUPPORT
+	struct ieee80211_vif *parent_vif;
+	struct ath12k_vif *parent;
+#endif
 	struct ath12k_reg_info *reg_info;
 	struct ath12k_link_vif *arvif;
 	struct ath12k_base *ab;
@@ -10097,6 +10132,20 @@ static int ath12k_mac_op_add_interface(struct ieee80211_hw *hw,
 
 	ahvif->ah = ah;
 	ahvif->vif = vif;
+#ifdef CPTCFG_ATH12K_PPE_DS_SUPPORT
+	INIT_LIST_HEAD(&ahvif->ppe_vlan_list);
+	INIT_LIST_HEAD(&ahvif->ppe_vlan_node);
+	ahvif->ppe_vlan_vp = -1;
+	ahvif->ppe_vlan_profile = -1;
+
+	if (vif->type == NL80211_IFTYPE_AP_VLAN) {
+		parent_vif = wdev_to_ieee80211_vif_vlan(ieee80211_vif_to_wdev(vif));
+		if (!parent_vif)
+			return -ENODEV;
+		parent = ath12k_vif_to_ahvif(parent_vif);
+		return ath12k_ppe_ds_vlan_add(ahvif, parent);
+	}
+#endif
 	arvif = &ahvif->deflink;
 
 	ath12k_mac_init_arvif(ahvif, arvif, -1);
@@ -10226,6 +10276,13 @@ static void ath12k_mac_op_remove_interface(struct ieee80211_hw *hw,
 
 	lockdep_assert_wiphy(hw->wiphy);
 
+#ifdef CPTCFG_ATH12K_PPE_DS_SUPPORT
+	if (vif->type == NL80211_IFTYPE_AP_VLAN) {
+		ath12k_ppe_ds_vlan_remove(ahvif);
+		return;
+	}
+#endif
+
 	for (link_id = 0; link_id < ATH12K_NUM_MAX_LINKS; link_id++) {
 		/* if we cached some config but never received assign chanctx,
 		 * free the allocated cache.
@@ -13060,6 +13117,9 @@ static const struct ieee80211_ops ath12k_ops = {
 	.set_key                        = ath12k_mac_op_set_key,
 	.set_rekey_data	                = ath12k_mac_op_set_rekey_data,
 	.sta_state                      = ath12k_mac_op_sta_state,
+#ifdef CPTCFG_ATH12K_PPE_DS_SUPPORT
+	.sta_set_4addr                  = ath12k_mac_op_sta_set_4addr,
+#endif
 	.sta_set_txpwr			= ath12k_mac_op_sta_set_txpwr,
 	.link_sta_rc_update		= ath12k_mac_op_link_sta_rc_update,
 	.conf_tx                        = ath12k_mac_op_conf_tx,
@@ -13937,6 +13997,9 @@ static int ath12k_mac_hw_register(struct ath12k_hw *ah)
 		ieee80211_hw_set(hw, MLO_MCAST_MULTI_LINK_TX);
 	}
 
+	if (ath12k_ppe_ds_enabled(ab))
+		ieee80211_hw_set(hw, SUPPORTS_VLAN_DATA_OFFLOAD);
+
 	hw->queues = ATH12K_HW_MAX_QUEUES;
 	wiphy->tx_queue_len = ATH12K_QUEUE_LEN;
 	hw->offchannel_tx_hw_queue = ATH12K_HW_MAX_QUEUES - 1;
diff --git a/drivers/net/wireless/ath/ath12k/ppe.c b/drivers/net/wireless/ath/ath12k/ppe.c
index aa2ce64..0d0a640 100644
--- a/drivers/net/wireless/ath/ath12k/ppe.c
+++ b/drivers/net/wireless/ath/ath12k/ppe.c
@@ -849,11 +849,9 @@ next:
 	return done;
 }
 
-static void ath12k_ppe_ds_vp_write(struct ath12k_link_vif *arvif,
-				   int profile, u32 value)
+static void ath12k_ppe_ds_vp_write(struct ath12k_base *ab, int profile,
+				   u32 value)
 {
-	struct ath12k_base *ab = arvif->ar->ab;
-
 	ath12k_hif_write32(ab, ATH12K_PPE_VP_TABLE_BASE +
 			   profile * ATH12K_PPE_VP_TABLE_STRIDE, value);
 }
@@ -1019,16 +1017,203 @@ static int ath12k_ppe_ds_vif_program(struct ath12k_link_vif *arvif)
 		 u32_encode_bits(arvif->vdev_id, ATH12K_PPE_VP_VDEV_ID) |
 		 u32_encode_bits(arvif->ppe_search_idx,
 				 ATH12K_PPE_VP_SEARCH_IDX);
-	ath12k_ppe_ds_vp_write(arvif, arvif->ppe_vp_profile, config);
+	ath12k_ppe_ds_vp_write(ab, arvif->ppe_vp_profile, config);
+	return 0;
+}
+
+static int
+ath12k_ppe_ds_vlan_route_apply(struct ath12k_vif *vlan,
+			       struct ath12k_link_vif *parent, bool enable);
+
+static int
+ath12k_ppe_ds_vlan_program(struct ath12k_vif *vlan,
+			   struct ath12k_link_vif *parent)
+{
+	struct ath12k_base *ab = parent->ar->ab;
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct ath12k_ppe_ds_vp_profile *profile;
+	u32 config;
+
+	if (vlan->ppe_vlan_profile < 0 ||
+	    vlan->ppe_vlan_profile >= ATH12K_PPE_DS_VP_PROFILES)
+		return -EINVAL;
+
+	spin_lock_bh(&ppe->vp_lock);
+	if (!test_bit(vlan->ppe_vlan_profile, &ppe->vp_profile_map)) {
+		spin_unlock_bh(&ppe->vp_lock);
+		return -ENOENT;
+	}
+	profile = &ppe->vp_profiles[vlan->ppe_vlan_profile];
+	if (profile->vp != vlan->ppe_vlan_vp || profile->refcount != 1) {
+		spin_unlock_bh(&ppe->vp_lock);
+		return -EINVAL;
+	}
+	spin_unlock_bh(&ppe->vp_lock);
+
+	config = u32_encode_bits(vlan->ppe_vlan_vp, ATH12K_PPE_VP_NUM) |
+		 u32_encode_bits(parent->ar->lmac_id, ATH12K_PPE_VP_PMAC_ID) |
+		 u32_encode_bits(parent->bank_id, ATH12K_PPE_VP_BANK_ID) |
+		 u32_encode_bits(parent->vdev_id, ATH12K_PPE_VP_VDEV_ID);
+	ath12k_ppe_ds_vp_write(ab, vlan->ppe_vlan_profile, config);
 	return 0;
 }
 
+static int
+ath12k_ppe_ds_vlan_attach(struct ath12k_vif *vlan,
+			  struct ath12k_link_vif *parent)
+{
+	struct ieee80211_vif *vif = vlan->vif;
+	struct wireless_dev *wdev = ieee80211_vif_to_wdev(vif);
+	struct ath12k_base *ab = parent->ar->ab;
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	u32 refcount;
+	int released_search = -1;
+	int released_bank = DP_INVALID_BANK_ID;
+	int profile, search_idx;
+	int ret, vp;
+
+	if (!ppe->started || !parent->is_started || !wdev || !wdev->netdev ||
+	    !wdev->use_4addr)
+		return 0;
+
+	if (vlan->ppe_vlan_vp >= 64) {
+		ret = ath12k_ppe_ds_vlan_program(vlan, parent);
+		if (!ret)
+			goto restore_route;
+		if (ret != -ENOENT)
+			return ret;
+
+		vlan->ppe_vlan_vp = -1;
+		vlan->ppe_vlan_profile = -1;
+		vlan->ppe_vlan_route_programmed = false;
+	}
+
+	vp = qcom_ppe_ds_vp_alloc(ppe->node, wdev->netdev);
+	if (vp < 0)
+		return vp;
+
+	profile = ath12k_ppe_ds_vp_profile_alloc(ppe, vp,
+						 NL80211_IFTYPE_AP,
+						 &search_idx, &refcount);
+	if (profile < 0) {
+		qcom_ppe_ds_vp_free(ppe->node, vp);
+		return profile;
+	}
+	if (refcount != 1) {
+		ret = -EEXIST;
+		goto err_profile;
+	}
+
+	vlan->ppe_vlan_ab = ab;
+	vlan->ppe_vlan_vp = vp;
+	vlan->ppe_vlan_profile = profile;
+	ret = ath12k_ppe_ds_vlan_program(vlan, parent);
+	if (ret)
+		goto err_profile;
+
+	ath12k_info(ab,
+		    "PPE direct-switch AP_VLAN attached: netdev=%s parent-vdev=%u vp=%d profile=%d bank=%d\n",
+		    wdev->netdev->name, parent->vdev_id, vp, profile,
+		    parent->bank_id);
+
+restore_route:
+	if (vlan->ppe_vlan_route_enabled && vlan->ppe_vlan_peer_valid &&
+	    !vlan->ppe_vlan_route_programmed)
+		ath12k_ppe_ds_vlan_route_apply(vlan, parent, true);
+	return 0;
+
+err_profile:
+	ath12k_ppe_ds_vp_profile_put(ppe, profile, &released_search,
+				     &released_bank);
+	qcom_ppe_ds_vp_free(ppe->node, vp);
+	vlan->ppe_vlan_vp = -1;
+	vlan->ppe_vlan_profile = -1;
+	return ret;
+}
+
+static void
+ath12k_ppe_ds_vlan_detach(struct ath12k_vif *vlan,
+			  struct ath12k_link_vif *parent)
+{
+	struct ath12k_base *ab = vlan->ppe_vlan_ab;
+	struct ath12k_ppe_ds *ppe;
+	int search_idx = -1;
+	int bank_id = DP_INVALID_BANK_ID;
+	bool last;
+
+	if (!ab || vlan->ppe_vlan_vp < 64)
+		return;
+	ppe = &ab->dp.ppe_ds;
+	/* Firmware recovery tears down the PPEDS node before mac80211
+	 * removes AP_VLAN interfaces. The node teardown already releases
+	 * its virtual ports, so avoid accessing the dismantled datapath.
+	 */
+	if (!ppe->node) {
+		vlan->ppe_vlan_vp = -1;
+		vlan->ppe_vlan_profile = -1;
+		vlan->ppe_vlan_route_programmed = false;
+		return;
+	}
+
+	if (vlan->ppe_vlan_route_programmed && parent)
+		ath12k_ppe_ds_vlan_route_apply(vlan, parent, false);
+
+	qcom_ppe_ds_vp_free(ppe->node, vlan->ppe_vlan_vp);
+	last = ath12k_ppe_ds_vp_profile_put(ppe, vlan->ppe_vlan_profile,
+					    &search_idx, &bank_id);
+	if (last)
+		ath12k_ppe_ds_vp_write(ab, vlan->ppe_vlan_profile, 0);
+	vlan->ppe_vlan_vp = -1;
+	vlan->ppe_vlan_profile = -1;
+	vlan->ppe_vlan_route_programmed = false;
+}
+
+int ath12k_ppe_ds_vlan_add(struct ath12k_vif *vlan,
+			   struct ath12k_vif *parent)
+{
+	struct ieee80211_vif *parent_vif;
+	struct ath12k_link_vif *parent_link;
+
+	if (!vlan || !parent)
+		return -EINVAL;
+	parent_vif = parent->vif;
+	if (!parent_vif || ieee80211_vif_is_mld(parent_vif))
+		return -EOPNOTSUPP;
+
+	vlan->ppe_parent = parent;
+	list_add_tail(&vlan->ppe_vlan_node, &parent->ppe_vlan_list);
+	parent_link = &parent->deflink;
+	if (!parent_link->ar || !parent_link->is_created)
+		return 0;
+
+	return ath12k_ppe_ds_vlan_attach(vlan, parent_link);
+}
+
+void ath12k_ppe_ds_vlan_remove(struct ath12k_vif *vlan)
+{
+	struct ath12k_link_vif *parent = NULL;
+
+	if (!vlan)
+		return;
+	if (vlan->ppe_parent)
+		parent = &vlan->ppe_parent->deflink;
+	ath12k_ppe_ds_vlan_detach(vlan, parent);
+	if (!list_empty(&vlan->ppe_vlan_node))
+		list_del_init(&vlan->ppe_vlan_node);
+	vlan->ppe_parent = NULL;
+	vlan->ppe_vlan_ab = NULL;
+	vlan->ppe_vlan_peer_valid = false;
+	vlan->ppe_vlan_route_enabled = false;
+	vlan->ppe_vlan_route_programmed = false;
+}
+
 int ath12k_ppe_ds_vif_attach(struct ath12k_link_vif *arvif)
 {
 	struct ath12k_base *ab = arvif->ar->ab;
 	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
 	struct ieee80211_vif *vif = ath12k_ahvif_to_vif(arvif->ahvif);
 	struct wireless_dev *wdev = ieee80211_vif_to_wdev(vif);
+	struct ath12k_vif *vlan;
 	u32 refcount;
 	int bank_id = DP_INVALID_BANK_ID;
 	int released_search = -1, released_bank = DP_INVALID_BANK_ID;
@@ -1043,7 +1227,7 @@ int ath12k_ppe_ds_vif_attach(struct ath12k_link_vif *arvif)
 	if (arvif->ppe_vp >= 64) {
 		ret = ath12k_ppe_ds_vif_program(arvif);
 		if (!ret)
-			return 0;
+			goto attach_vlans;
 		if (ret != -ENOENT)
 			return ret;
 
@@ -1082,6 +1266,18 @@ int ath12k_ppe_ds_vif_attach(struct ath12k_link_vif *arvif)
 		    "PPE direct-switch vdev %u attached: netdev=%s vp=%d profile=%d bank=%d refs=%u\n",
 		    arvif->vdev_id, wdev->netdev->name, vp, profile,
 		    refcount > 1 ? bank_id : arvif->bank_id, refcount);
+
+attach_vlans:
+	if (vif->type == NL80211_IFTYPE_AP) {
+		list_for_each_entry(vlan, &arvif->ahvif->ppe_vlan_list,
+				    ppe_vlan_node) {
+			ret = ath12k_ppe_ds_vlan_attach(vlan, arvif);
+			if (ret)
+				ath12k_warn(ab,
+					    "failed to attach AP_VLAN to PPE vdev %u: %d\n",
+					    arvif->vdev_id, ret);
+		}
+	}
 	return 0;
 
 err_profile:
@@ -1101,21 +1297,36 @@ void ath12k_ppe_ds_vif_detach(struct ath12k_link_vif *arvif)
 	struct ath12k_base *ab;
 	struct ath12k_ppe_ds *ppe;
 	struct ieee80211_vif *vif;
+	struct ath12k_vif *vlan;
 	int search_idx = -1;
 	int bank_id = DP_INVALID_BANK_ID;
 	bool last;
 
-	if (!arvif || !arvif->ar || arvif->ppe_vp < 64)
+	if (!arvif || !arvif->ar)
 		return;
 	ab = arvif->ar->ab;
 	ppe = &ab->dp.ppe_ds;
+	/* ath12k_core_reconfigure_on_crash() frees the PPEDS node before
+	 * mac80211 tears down VIFs. qcom_ppe_ds_node_free() has already
+	 * detached its VPs in that case, so only discard the stale cache.
+	 */
+	if (!ppe->node) {
+		ath12k_ppe_ds_vif_invalidate(arvif);
+		return;
+	}
 	vif = ath12k_ahvif_to_vif(arvif->ahvif);
+	if (vif->type == NL80211_IFTYPE_AP)
+		list_for_each_entry(vlan, &arvif->ahvif->ppe_vlan_list,
+				    ppe_vlan_node)
+			ath12k_ppe_ds_vlan_detach(vlan, arvif);
+	if (arvif->ppe_vp < 64)
+		return;
 
 	qcom_ppe_ds_vp_free(ppe->node, arvif->ppe_vp);
 	last = ath12k_ppe_ds_vp_profile_put(ppe, arvif->ppe_vp_profile,
 					 &search_idx, &bank_id);
 	if (last)
-		ath12k_ppe_ds_vp_write(arvif, arvif->ppe_vp_profile, 0);
+		ath12k_ppe_ds_vp_write(ab, arvif->ppe_vp_profile, 0);
 	if (last && vif->type == NL80211_IFTYPE_STATION) {
