+static int
+ath12k_ppe_ds_peer_route_set(struct ath12k *ar, u32 vdev_id, int vp,
+			     const u8 *peer, const u8 *link_peer,
+			     bool track_peer, bool enable)
+{
+	struct ath12k_ppe_ds *ppe = &ar->ab->dp.ppe_ds;
+	int map_ret = 0;
+	int ret;
