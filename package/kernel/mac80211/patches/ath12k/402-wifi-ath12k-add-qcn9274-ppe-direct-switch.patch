From: Balamurugan Mahalingam <bmahalin@qti.qualcomm.com>
Date: Fri, 30 May 2025 22:20:41 -0700
Subject: [PATCH] wifi: ath12k: add QCN9274 PPE direct switching

Connect QCN9274 PPE2TCL and REO2PPE rings to the native Qualcomm PPE
direct-switch core. Keep separate cookie-converted TX buffers for the
direct path and recycle REO buffers directly to their owning RXDMA ring.

Based-on: 4590caf67ab7de99e7a1ea2bc70d2429b5f855e1
Link: https://git.codelinaro.org/clo/qsdk/oss/system/feeds/wlan-open/-/blob/1ee3a4ab7c59ceaff347c4668fc6c7604a04c323/patches/ath12k/0337-01-QSDK-DP-wifi-Add-support-for-PPE-DS-Direct-switch-fe.patch
Signed-off-by: Pradeep Kumar Chitrapu <pradeepc@qti.qualcomm.com>
Signed-off-by: Balamurugan Mahalingam <bmahalin@qti.qualcomm.com>
Signed-off-by: Ramanathan Choodamani <rchoodam@qti.qualcomm.com>
Signed-off-by: Ganesh Kariganuru Mahabalesh <gkarigan@qti.qualcomm.com>
Signed-off-by: Nithyanantham Paramasivam <nithp@qti.qualcomm.com>
Signed-off-by: Nandha Kishore Easwaran <nandhaki@qti.qualcomm.com>
Signed-off-by: Pavankumar Nandeshwar <pnandesh@qti.qualcomm.com>
Signed-off-by: Neha Bisht <nbisht@qti.qualcomm.com>
Signed-off-by: Aloka Dixit <alokad@qti.qualcomm.com>
Signed-off-by: Sidhanta Sahu <sidhanta@qti.qualcomm.com>
Assisted-by: Codex:GPT-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
diff --git a/drivers/net/wireless/ath/ath12k/Kconfig b/drivers/net/wireless/ath/ath12k/Kconfig
index 700b9a3..3972385 100644
--- a/drivers/net/wireless/ath/ath12k/Kconfig
+++ b/drivers/net/wireless/ath/ath12k/Kconfig
@@ -68,3 +68,9 @@ config ATH12K_THERMAL
         depends on THERMAL
         help
           Enable ath12k thermal sensor support.
+
+config ATH12K_PPE_DS_SUPPORT
+	bool "ath12k Qualcomm PPE direct switching"
+	depends on ATH12K
+	help
+	  Enable the QCN9274 direct-switch data path to the Qualcomm PPE.
diff --git a/local-symbols b/local-symbols
index 10ce2a7..faac79f 100644
--- a/local-symbols
+++ b/local-symbols
@@ -171,6 +171,7 @@ ATH12K_DEBUGFS=
 ATH12K_TRACING=
 ATH12K_COREDUMP=
 ATH12K_THERMAL=
+ATH12K_PPE_DS_SUPPORT=
 WLAN_VENDOR_ATMEL=
 AT76C50X_USB=
 WLAN_VENDOR_BROADCOM=
diff --git a/drivers/net/wireless/ath/ath12k/Makefile b/drivers/net/wireless/ath/ath12k/Makefile
index 21e8dfe..8440302 100644
--- a/drivers/net/wireless/ath/ath12k/Makefile
+++ b/drivers/net/wireless/ath/ath12k/Makefile
@@ -31,6 +31,7 @@ ath12k-$(CONFIG_PM) += wow.o
 ath12k-$(CPTCFG_ATH12K_COREDUMP) += coredump.o
 ath12k-$(CPTCFG_NL80211_TESTMODE) += testmode.o
 ath12k-$(CPTCFG_ATH12K_THERMAL) += thermal.o
+ath12k-$(CPTCFG_ATH12K_PPE_DS_SUPPORT) += ppe.o
 
 # for tracing framework to find trace.h
 CFLAGS_trace.o := -I$(src)
diff --git a/drivers/net/wireless/ath/ath12k/core.h b/drivers/net/wireless/ath/ath12k/core.h
index a9dca83..4e325bf 100644
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -313,6 +313,8 @@ struct ath12k_link_vif {
 	u32 dtim_period;
 	u16 ast_hash;
 	u16 ast_idx;
+	int ppe_vp;
+	int ppe_search_idx;
 	u16 tcl_metadata;
 	u8 hal_addr_search_flags;
 	u8 search_type;
diff --git a/drivers/net/wireless/ath/ath12k/dp.c b/drivers/net/wireless/ath/ath12k/dp.c
index 4a54b8c..82f25db 100644
--- a/drivers/net/wireless/ath/ath12k/dp.c
+++ b/drivers/net/wireless/ath/ath12k/dp.c
@@ -143,6 +143,13 @@ static int ath12k_dp_srng_calculate_msi_group(struct ath12k_base *ab,
 
 	switch (type) {
 	case HAL_WBM2SW_RELEASE:
+		if (ath12k_ppe_ds_enabled(ab) &&
+		    ring_num == HAL_WBM2SW_PPEDS_TX_CMPL_RING_NUM) {
+#ifdef CPTCFG_ATH12K_PPE_DS_SUPPORT
+			grp_mask = &ab->hw_params->ring_mask->ppeds_tx_cmpl[0];
+			break;
+#endif
+		}
 		if (ring_num == HAL_WBM2SW_REL_ERR_RING_NUM) {
 			grp_mask = &ab->hw_params->ring_mask->rx_wbm_rel[0];
 			ring_num = 0;
@@ -164,6 +171,14 @@ static int ath12k_dp_srng_calculate_msi_group(struct ath12k_base *ab,
 	case HAL_REO_DST:
 		grp_mask = &ab->hw_params->ring_mask->rx[0];
 		break;
+#ifdef CPTCFG_ATH12K_PPE_DS_SUPPORT
+	case HAL_REO2PPE:
+		grp_mask = &ab->hw_params->ring_mask->reo2ppe[0];
+		break;
+	case HAL_PPE2TCL:
+		grp_mask = &ab->hw_params->ring_mask->ppe2tcl[0];
+		break;
+#endif
 	case HAL_REO_STATUS:
 		grp_mask = &ab->hw_params->ring_mask->reo_status[0];
 		break;
@@ -270,10 +285,15 @@ int ath12k_dp_srng_setup(struct ath12k_base *ab, struct dp_srng *ring,
 
 	switch (type) {
 	case HAL_REO_DST:
+	case HAL_REO2PPE:
 		params.intr_batch_cntr_thres_entries =
 					HAL_SRNG_INT_BATCH_THRESHOLD_RX;
 		params.intr_timer_thres_us = HAL_SRNG_INT_TIMER_THRESHOLD_RX;
 		break;
+	case HAL_PPE2TCL:
+		params.intr_batch_cntr_thres_entries = 0;
+		params.intr_timer_thres_us = 3;
+		break;
 	case HAL_RXDMA_BUF:
 	case HAL_RXDMA_MONITOR_BUF:
 		params.low_threshold = num_entries >> 3;
@@ -895,6 +915,22 @@ int ath12k_dp_service_srng(struct ath12k_base *ab,
 	enum dp_monitor_mode monitor_mode;
 	u8 ring_mask;
 
+#ifdef CPTCFG_ATH12K_PPE_DS_SUPPORT
+	if (ab->hw_params->ring_mask->ppe2tcl[grp_id])
+		ath12k_ppe_ds_service_ppe2tcl(ab);
+
+	if (ab->hw_params->ring_mask->reo2ppe[grp_id])
+		ath12k_ppe_ds_service_reo2ppe(ab);
+
+	if (ab->hw_params->ring_mask->ppeds_tx_cmpl[grp_id]) {
+		work_done = ath12k_ppe_ds_service_tx_completion(ab, budget);
+		budget -= work_done;
+		tot_work_done += work_done;
+		if (budget <= 0)
+			goto done;
+	}
+#endif
+
 	if (ab->hw_params->ring_mask->tx[grp_id]) {
 		i = fls(ab->hw_params->ring_mask->tx[grp_id]) - 1;
 		ath12k_dp_tx_completion_handler(ab, i);
@@ -1011,6 +1047,8 @@ void ath12k_dp_pdev_free(struct ath12k_base *ab)
 {
 	int i;
 
+	ath12k_ppe_ds_stop(ab);
+
 	for (i = 0; i < ab->num_radios; i++)
 		ath12k_dp_rx_pdev_free(ab, i);
 }
@@ -1074,6 +1112,12 @@ int ath12k_dp_pdev_alloc(struct ath12k_base *ab)
 		}
 	}
 
+	ret = ath12k_ppe_ds_start(ab);
+	if (ret) {
+		ath12k_warn(ab, "failed to start PPE direct switching: %d\n", ret);
+		goto err;
+	}
+
 	return 0;
 err:
 	ath12k_dp_pdev_free(ab);
@@ -1307,6 +1351,8 @@ void ath12k_dp_free(struct ath12k_base *ab)
 	if (!dp->ab)
 		return;
 
+	ath12k_ppe_ds_detach(ab);
+
 	ath12k_dp_link_desc_cleanup(ab, dp->link_desc_banks,
 				    HAL_WBM_IDLE_LINK, &dp->wbm_idle_ring);
 
@@ -1426,7 +1472,7 @@ struct ath12k_tx_desc_info *ath12k_dp_get_tx_desc(struct ath12k_base *ab,
 	ppt_idx = u32_get_bits(cookie, ATH12K_DP_CC_COOKIE_PPT);
 	spt_idx = u32_get_bits(cookie, ATH12K_DP_CC_COOKIE_SPT);
 
-	start_ppt_idx = ATH12K_TX_SPT_PAGE_OFFSET;
+	start_ppt_idx = ATH12K_TX_SPT_PAGE_OFFSET(ab);
 	end_ppt_idx = start_ppt_idx +
 		      (ATH12K_TX_SPT_PAGES_PER_POOL(ab) * ATH12K_HW_MAX_QUEUES);
 
@@ -1509,7 +1555,7 @@ static int ath12k_dp_cc_desc_init(struct ath12k_base *ab)
 
 			tx_spt_page = i + pool_id *
 				      ATH12K_TX_SPT_PAGES_PER_POOL(ab);
-			ppt_idx = ATH12K_TX_SPT_PAGE_OFFSET + tx_spt_page;
+			ppt_idx = ATH12K_TX_SPT_PAGE_OFFSET(ab) + tx_spt_page;
 
 			dp->txbaddr[tx_spt_page] = &tx_descs[0];
 
@@ -1541,7 +1587,7 @@ static int ath12k_dp_cmem_init(struct ath12k_base *ab,
 
 	switch (type) {
 	case ATH12K_DP_TX_DESC:
-		start = ATH12K_TX_SPT_PAGE_OFFSET;
+		start = ATH12K_TX_SPT_PAGE_OFFSET(ab);
 		end = start + ATH12K_NUM_TX_SPT_PAGES(ab);
 		break;
 	case ATH12K_DP_RX_DESC:
@@ -1577,7 +1623,8 @@ void ath12k_dp_partner_cc_init(struct ath12k_base *ab)
 
 static u32 ath12k_dp_get_num_spt_pages(struct ath12k_base *ab)
 {
-	return ATH12K_NUM_RX_SPT_PAGES(ab) + ATH12K_NUM_TX_SPT_PAGES(ab);
+	return ATH12K_NUM_PPE_DS_TX_SPT_PAGES(ab) +
+	       ATH12K_NUM_RX_SPT_PAGES(ab) + ATH12K_NUM_TX_SPT_PAGES(ab);
 }
 
 static int ath12k_dp_cc_init(struct ath12k_base *ab)
@@ -1814,6 +1861,12 @@ int ath12k_dp_alloc(struct ath12k_base *ab)
 	if (ret)
 		goto fail_dp_rx_free;
 
+	ret = ath12k_ppe_ds_attach(ab);
+	if (ret) {
+		ath12k_warn(ab, "failed to attach PPE direct switching: %d\n", ret);
+		goto fail_dp_rx_free;
+	}
+
 	/* Init any SOC level resource for DP */
 
 	return 0;
diff --git a/drivers/net/wireless/ath/ath12k/dp.h b/drivers/net/wireless/ath/ath12k/dp.h
index 4ffec6a..9d96758 100644
--- a/drivers/net/wireless/ath/ath12k/dp.h
+++ b/drivers/net/wireless/ath/ath12k/dp.h
@@ -10,6 +10,7 @@
 #include "hal_desc.h"
 #include "hal_rx.h"
 #include "hw.h"
+#include "ppe.h"
 
 #define MAX_RXDMA_PER_PDEV     2
 
@@ -20,6 +21,7 @@ struct ath12k_vif;
 struct ath12k_link_vif;
 struct hal_tcl_status_ring;
 struct ath12k_ext_irq_grp;
+struct qcom_ppe_ds_node;
 
 #define DP_MON_PURGE_TIMEOUT_MS     100
 #define DP_MON_SERVICE_BUDGET       128
@@ -199,6 +201,13 @@ struct ath12k_pdev_dp {
 #define DP_TX_MONITOR_BUF_RING_SIZE	4096
 #define DP_TX_MONITOR_DEST_RING_SIZE	2048
 
+#define DP_PPE2TCL_RING_SIZE		8192
+#define DP_REO2PPE_RING_SIZE		8192
+#define DP_PPE_WBM2SW_RING_SIZE		8192
+#define DP_PPE_DS_TX_DESC_COUNT		8192
+#define DP_PPE_DS_TX_SPT_PAGES		(DP_PPE_DS_TX_DESC_COUNT / \
+					 ATH12K_MAX_SPT_ENTRIES)
+
 #define DP_TX_MONITOR_BUF_SIZE		2048
 #define DP_TX_MONITOR_BUF_SIZE_MIN	48
 #define DP_TX_MONITOR_BUF_SIZE_MAX	8192
@@ -252,8 +261,13 @@ struct ath12k_pdev_dp {
 #define ATH12K_NUM_TX_SPT_PAGES(ab)	(ATH12K_TX_SPT_PAGES_PER_POOL(ab) * \
 					 ATH12K_HW_MAX_QUEUES)
 
-#define ATH12K_TX_SPT_PAGE_OFFSET 0
-#define ATH12K_RX_SPT_PAGE_OFFSET(ab) ATH12K_NUM_TX_SPT_PAGES(ab)
+#define ATH12K_PPE_DS_TX_SPT_PAGE_OFFSET	0
+#define ATH12K_NUM_PPE_DS_TX_SPT_PAGES(ab) \
+	(ath12k_ppe_ds_enabled(ab) ? DP_PPE_DS_TX_SPT_PAGES : 0)
+#define ATH12K_TX_SPT_PAGE_OFFSET(ab) \
+	ATH12K_NUM_PPE_DS_TX_SPT_PAGES(ab)
+#define ATH12K_RX_SPT_PAGE_OFFSET(ab) \
+	(ATH12K_NUM_PPE_DS_TX_SPT_PAGES(ab) + ATH12K_NUM_TX_SPT_PAGES(ab))
 
 /* The SPT pages are divided for RX and TX, first block for RX
  * and remaining for TX
@@ -331,6 +345,46 @@ struct ath12k_tx_desc_info {
 	u8 pool_id;
 };
 
+#ifdef CPTCFG_ATH12K_PPE_DS_SUPPORT
+struct ath12k_ppe_ds_tx_desc {
+	struct list_head list;
+	struct sk_buff *skb;
+	dma_addr_t paddr;
+	u32 cookie;
+	u32 dma_len;
+	bool in_use;
+};
+
+struct ath12k_ppe_ds_stats {
+	atomic64_t ppe2tcl_prod;
+	atomic64_t ppe2tcl_cons;
+	atomic64_t reo2ppe_prod;
+	atomic64_t reo2ppe_cons;
+	atomic64_t tx_alloc;
+	atomic64_t tx_alloc_fail;
+	atomic64_t tx_complete;
+	atomic64_t rx_complete;
+	atomic64_t rx_requeue;
+	atomic64_t rx_drop;
+};
+
+struct ath12k_ppe_ds {
+	struct qcom_ppe_ds_node *node;
+	struct dp_srng ppe2tcl_ring;
+	struct dp_srng reo2ppe_ring;
+	struct dp_srng txcmpl_ring;
+	struct ath12k_ppe_ds_tx_desc **tx_desc_pages;
+	struct list_head tx_desc_free_list;
+	spinlock_t tx_desc_lock;
+	spinlock_t vp_lock;
+	unsigned long search_idx_map;
+	bool registered;
+	bool started;
+	bool quiesced;
+	struct ath12k_ppe_ds_stats stats;
+};
+#endif
+
 struct ath12k_tx_desc_params {
 	struct sk_buff *skb;
 	struct sk_buff *skb_ext_desc;
@@ -427,6 +481,9 @@ struct ath12k_dp {
 	struct dp_rxdma_mon_ring rx_mon_status_refill_ring[MAX_RXDMA_PER_PDEV];
 	struct ath12k_reo_q_addr_lut reoq_lut;
 	struct ath12k_reo_q_addr_lut ml_reoq_lut;
+#ifdef CPTCFG_ATH12K_PPE_DS_SUPPORT
+	struct ath12k_ppe_ds ppe_ds;
+#endif
 };
 
 /* HTT definitions */
diff --git a/drivers/net/wireless/ath/ath12k/hal.c b/drivers/net/wireless/ath/ath12k/hal.c
index 6406fcf..e3c08c0 100644
--- a/drivers/net/wireless/ath/ath12k/hal.c
+++ b/drivers/net/wireless/ath/ath12k/hal.c
@@ -57,6 +57,14 @@ static const struct hal_srng_config hw_srng_config_template[] = {
 		.ring_dir = HAL_SRNG_DIR_DST,
 		.max_size = HAL_REO_STATUS_RING_BASE_MSB_RING_SIZE,
 	},
+	[HAL_REO2PPE] = {
+		.start_ring_id = HAL_SRNG_RING_ID_REO2PPE,
+		.max_rings = 1,
+		.entry_size = sizeof(struct hal_reo_dest_ring) >> 2,
+		.mac_type = ATH12K_HAL_SRNG_UMAC,
+		.ring_dir = HAL_SRNG_DIR_DST,
+		.max_size = HAL_REO2PPE_RING_BASE_MSB_RING_SIZE,
+	},
 	[HAL_TCL_DATA] = {
 		.start_ring_id = HAL_SRNG_RING_ID_SW2TCL1,
 		.max_rings = 6,
@@ -175,7 +183,7 @@ static const struct hal_srng_config hw_srng_config_template[] = {
 		.start_ring_id = HAL_SRNG_RING_ID_PPE2TCL1,
 		.max_rings = 1,
 		.entry_size = sizeof(struct hal_tcl_entrance_from_ppe_ring) >> 2,
-		.mac_type = ATH12K_HAL_SRNG_PMAC,
+		.mac_type = ATH12K_HAL_SRNG_UMAC,
 		.ring_dir = HAL_SRNG_DIR_SRC,
 		.max_size = HAL_SW2TCL1_RING_BASE_MSB_RING_SIZE,
 	},
@@ -553,6 +561,11 @@ static int ath12k_hal_srng_create_config_qcn9274(struct ath12k_base *ab)
 	s->reg_start[0] = HAL_SEQ_WCSS_UMAC_REO_REG + HAL_REO_STATUS_RING_BASE_LSB(ab);
 	s->reg_start[1] = HAL_SEQ_WCSS_UMAC_REO_REG + HAL_REO_STATUS_HP;
 
+	s = &hal->srng_config[HAL_REO2PPE];
+	s->reg_start[0] = HAL_SEQ_WCSS_UMAC_REO_REG +
+			  HAL_REO2PPE_RING_BASE_LSB;
+	s->reg_start[1] = HAL_SEQ_WCSS_UMAC_REO_REG + HAL_REO2PPE_RING_HP;
+
 	s = &hal->srng_config[HAL_TCL_DATA];
 	s->reg_start[0] = HAL_SEQ_WCSS_UMAC_TCL_REG + HAL_TCL1_RING_BASE_LSB(ab);
 	s->reg_start[1] = HAL_SEQ_WCSS_UMAC_TCL_REG + HAL_TCL1_RING_HP;
@@ -1429,6 +1442,8 @@ static int ath12k_hal_srng_create_config_wcn7850(struct ath12k_base *ab)
 	/* below rings are not used */
 	s = &hal->srng_config[HAL_RXDMA_DIR_BUF];
 	s->max_rings = 0;
+	s = &hal->srng_config[HAL_REO2PPE];
+	s->max_rings = 0;
 
 	s = &hal->srng_config[HAL_PPE2TCL];
 	s->max_rings = 0;
diff --git a/drivers/net/wireless/ath/ath12k/hal.h b/drivers/net/wireless/ath/ath12k/hal.h
index efe00e1..298a2ba 100644
--- a/drivers/net/wireless/ath/ath12k/hal.h
+++ b/drivers/net/wireless/ath/ath12k/hal.h
@@ -130,6 +130,11 @@ struct ath12k_base;
 #define HAL_TCL_PPE2TCL1_RING_BASE_LSB		0x00000c48
 #define HAL_TCL_PPE2TCL1_RING_HP		0x00002038
 
+/* QCN9274 REO2PPE destination ring */
+#define HAL_REO2PPE_RING_BASE_LSB		0x00000938
+#define HAL_REO2PPE_RING_HP			0x00003090
+#define HAL_REO2PPE_RING_BASE_MSB_RING_SIZE	0xffffffff
+
 /* WBM PPE Release Ring address */
 #define HAL_WBM_PPE_RELEASE_RING_BASE_LSB(ab) \
 	((ab)->hw_params->regs->hal_ppe_rel_ring_base)
@@ -281,8 +286,12 @@ struct ath12k_base;
 #define HAL_WBM_SW_COOKIE_CONV_CFG_WBM2SW2_EN		BIT(3)
 #define HAL_WBM_SW_COOKIE_CONV_CFG_WBM2SW3_EN		BIT(4)
 #define HAL_WBM_SW_COOKIE_CONV_CFG_WBM2SW4_EN		BIT(5)
+#define HAL_WBM_SW_COOKIE_CONV_CFG_WBM2SW6_EN		BIT(7)
 #define HAL_WBM_SW_COOKIE_CONV_CFG_GLOBAL_EN		BIT(8)
 
+#define HAL_WBM2SW_PPEDS_TX_CMPL_RING_NUM	6
+#define HAL_WBM2SW_PPEDS_TX_CMPL_MAP_ID		11
+
 /* TCL ring field mask and offset */
 #define HAL_TCL1_RING_BASE_MSB_RING_SIZE		GENMASK(27, 8)
 #define HAL_TCL1_RING_BASE_MSB_RING_BASE_ADDR_MSB	GENMASK(7, 0)
@@ -547,6 +556,7 @@ enum hal_ring_type {
 	HAL_RXDMA_MONITOR_DST,
 	HAL_RXDMA_MONITOR_DESC,
 	HAL_RXDMA_DIR_BUF,
+	HAL_REO2PPE,
 	HAL_PPE2TCL,
 	HAL_PPE_RELEASE,
 	HAL_TX_MONITOR_BUF,
diff --git a/drivers/net/wireless/ath/ath12k/hw.c b/drivers/net/wireless/ath/ath12k/hw.c
index 6791ae1..2061683 100644
--- a/drivers/net/wireless/ath/ath12k/hw.c
+++ b/drivers/net/wireless/ath/ath12k/hw.c
