diff --git a/drivers/net/wireless/ath/ath12k/ppe.c b/drivers/net/wireless/ath/ath12k/ppe.c
new file mode 100644
index 0000000..af80e53
--- /dev/null
+++ b/drivers/net/wireless/ath/ath12k/ppe.c
@@ -0,0 +1,752 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/* Qualcomm QCN9274 PPE direct-switch support. */
+
+#include <linux/dma-mapping.h>
+#include <linux/property.h>
+#include <linux/soc/qcom/ppe-ds.h>
+
+#include "core.h"
+#include "debug.h"
+#include "hal.h"
+#include "hal_rx.h"
+#include "hif.h"
+#include "ppe.h"
+
+#define ATH12K_PPE_DS_BUFFER_SIZE	2048
+#define ATH12K_PPE_DS_HEADROOM		130
+#define ATH12K_PPE_DS_RXFILL_THRESHOLD	32
+
+#define ATH12K_PPE_VP_TABLE_BASE	0x00a44194
+#define ATH12K_PPE_VP_TABLE_STRIDE	4
+#define ATH12K_PPE_VP_NUM		GENMASK(7, 0)
+#define ATH12K_PPE_VP_PMAC_ID		GENMASK(9, 8)
+#define ATH12K_PPE_VP_BANK_ID		GENMASK(15, 10)
+#define ATH12K_PPE_VP_VDEV_ID		GENMASK(23, 16)
+#define ATH12K_PPE_VP_SEARCH_IDX	GENMASK(26, 24)
+
+#define ATH12K_PPE_SEARCH_TABLE_SIZE	8
+#define ATH12K_PPE_SEARCH_TABLE_BASE	(HAL_SEQ_WCSS_UMAC_TCL_REG + 0x214)
+#define ATH12K_PPE_SEARCH_AST_IDX	GENMASK(19, 0)
+#define ATH12K_PPE_SEARCH_AST_HASH	GENMASK(23, 20)
+
+#define ATH12K_PPE_REO_DEST_REG		(HAL_SEQ_WCSS_UMAC_REO_REG + 0xcf0)
+#define ATH12K_PPE_REO_DEST_VALUE	0x2000
+#define ATH12K_PPE_TCL_RBM_MAP_REG	(HAL_SEQ_WCSS_UMAC_TCL_REG + 0x88)
+#define ATH12K_PPE_TCL_RBM_SHIFT	(7 * 4)
+#define ATH12K_PPE_TCL_RBM_MASK		GENMASK(31, 28)
+
+static u32 ath12k_ppe_ds_cookie(u16 page, u16 entry)
+{
+	return (u32)page << ATH12K_CC_PPT_SHIFT | entry;
+}
+
+static struct ath12k_base *
+ath12k_ppe_ds_ab(struct qcom_ppe_ds_node *node)
+{
+	return *(struct ath12k_base **)qcom_ppe_ds_priv(node);
+}
+
+bool ath12k_ppe_ds_enabled(struct ath12k_base *ab)
+{
+	if (ab->hw_rev != ATH12K_HW_QCN9274_HW10 &&
+	    ab->hw_rev != ATH12K_HW_QCN9274_HW20)
+		return false;
+
+	return device_property_read_bool(ab->dev, "qcom,ppe-ds");
+}
+
+static struct ath12k_ppe_ds_tx_desc *
+ath12k_ppe_ds_tx_desc_get(struct ath12k_base *ab, u32 cookie)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	u16 page = u32_get_bits(cookie, ATH12K_DP_CC_COOKIE_PPT);
+	u16 entry = u32_get_bits(cookie, ATH12K_DP_CC_COOKIE_SPT);
+
+	if (!ppe->tx_desc_pages || page >= DP_PPE_DS_TX_SPT_PAGES ||
+	    entry >= ATH12K_MAX_SPT_ENTRIES || !ppe->tx_desc_pages[page])
+		return NULL;
+
+	return &ppe->tx_desc_pages[page][entry];
+}
+
+static bool
+ath12k_ppe_ds_tx_desc_valid(struct ath12k_base *ab,
+			    struct ath12k_ppe_ds_tx_desc *desc)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	int i;
+
+	if (!desc || !ppe->tx_desc_pages)
+		return false;
+
+	for (i = 0; i < DP_PPE_DS_TX_SPT_PAGES; i++)
+		if (desc >= ppe->tx_desc_pages[i] &&
+		    desc < ppe->tx_desc_pages[i] + ATH12K_MAX_SPT_ENTRIES)
+			return true;
+
+	return false;
+}
+
+static void
+ath12k_ppe_ds_tx_desc_release_locked(struct ath12k_base *ab,
+				     struct ath12k_ppe_ds_tx_desc *desc)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct sk_buff *skb;
+
+	if (!desc->in_use)
+		return;
+
+	skb = desc->skb;
+	if (skb) {
+		dma_unmap_single(ab->dev, desc->paddr, desc->dma_len,
+				 DMA_BIDIRECTIONAL);
+		dev_kfree_skb_any(skb);
+	}
+
+	desc->skb = NULL;
+	desc->paddr = 0;
+	desc->dma_len = 0;
+	desc->in_use = false;
+	list_add_tail(&desc->list, &ppe->tx_desc_free_list);
+}
+
+static void ath12k_ppe_ds_tx_desc_release(struct ath12k_base *ab,
+					  struct ath12k_ppe_ds_tx_desc *desc)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+
+	if (!ath12k_ppe_ds_tx_desc_valid(ab, desc))
+		return;
+
+	spin_lock_bh(&ppe->tx_desc_lock);
+	ath12k_ppe_ds_tx_desc_release_locked(ab, desc);
+	spin_unlock_bh(&ppe->tx_desc_lock);
+}
+
+static int ath12k_ppe_ds_tx_desc_init(struct ath12k_base *ab)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct ath12k_ppe_ds_tx_desc *descs;
+	u32 cmem_base;
+	int i, j;
+
+	INIT_LIST_HEAD(&ppe->tx_desc_free_list);
+	spin_lock_init(&ppe->tx_desc_lock);
+	spin_lock_init(&ppe->vp_lock);
+
+	ppe->tx_desc_pages = kcalloc(DP_PPE_DS_TX_SPT_PAGES,
+				     sizeof(*ppe->tx_desc_pages), GFP_KERNEL);
+	if (!ppe->tx_desc_pages)
+		return -ENOMEM;
+
+	for (i = 0; i < DP_PPE_DS_TX_SPT_PAGES; i++) {
+		descs = kcalloc(ATH12K_MAX_SPT_ENTRIES, sizeof(*descs),
+				GFP_KERNEL);
+		if (!descs)
+			return -ENOMEM;
+
+		ppe->tx_desc_pages[i] = descs;
+		for (j = 0; j < ATH12K_MAX_SPT_ENTRIES; j++) {
+			descs[j].cookie = ath12k_ppe_ds_cookie(i, j);
+			INIT_LIST_HEAD(&descs[j].list);
+			list_add_tail(&descs[j].list, &ppe->tx_desc_free_list);
+			*((struct ath12k_ppe_ds_tx_desc **)
+			  ab->dp.spt_info[i].vaddr + j) = &descs[j];
+		}
+	}
+
+	cmem_base = ab->qmi.dev_mem[ATH12K_QMI_DEVMEM_CMEM_INDEX].start;
+	for (i = 0; i < DP_PPE_DS_TX_SPT_PAGES; i++)
+		ath12k_hif_write32(ab, cmem_base + ATH12K_PPT_ADDR_OFFSET(i),
+				   ab->dp.spt_info[i].paddr >>
+				   ATH12K_SPT_4K_ALIGN_OFFSET);
+
+	return 0;
+}
+
+static void ath12k_ppe_ds_tx_desc_cleanup(struct ath12k_base *ab)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct ath12k_ppe_ds_tx_desc *descs;
+	int i, j;
+
+	if (!ppe->tx_desc_pages)
+		return;
+
+	spin_lock_bh(&ppe->tx_desc_lock);
+	for (i = 0; i < DP_PPE_DS_TX_SPT_PAGES; i++) {
+		descs = ppe->tx_desc_pages[i];
+		if (!descs)
+			continue;
+		for (j = 0; j < ATH12K_MAX_SPT_ENTRIES; j++) {
+			if (descs[j].in_use)
+				ath12k_ppe_ds_tx_desc_release_locked(ab, &descs[j]);
+			*((struct ath12k_ppe_ds_tx_desc **)
+			  ab->dp.spt_info[i].vaddr + j) = NULL;
+		}
+	}
+	spin_unlock_bh(&ppe->tx_desc_lock);
+
+	for (i = 0; i < DP_PPE_DS_TX_SPT_PAGES; i++)
+		kfree(ppe->tx_desc_pages[i]);
+	kfree(ppe->tx_desc_pages);
+	ppe->tx_desc_pages = NULL;
+	INIT_LIST_HEAD(&ppe->tx_desc_free_list);
+}
+
+static void ath12k_ppe_ds_ppe2tcl_produce(struct qcom_ppe_ds_node *node,
+					  u16 prod)
+{
+	struct ath12k_base *ab = ath12k_ppe_ds_ab(node);
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct hal_srng *srng;
+
+	if (READ_ONCE(ppe->quiesced))
+		return;
+
+	srng = &ab->hal.srng_list[ppe->ppe2tcl_ring.ring_id];
+	spin_lock_bh(&srng->lock);
+	ath12k_hal_srng_access_begin(ab, srng);
+	srng->u.src_ring.hp = prod * srng->entry_size;
+	ath12k_hal_srng_access_end(ab, srng);
+	spin_unlock_bh(&srng->lock);
+	atomic64_inc(&ppe->stats.ppe2tcl_prod);
+}
+
+static u32
+ath12k_ppe_ds_ppe2tcl_refill(struct qcom_ppe_ds_node *node, u32 count,
+			     u32 size, u32 headroom,
+			     struct qcom_ppe_ds_rxfill *buffers)
+{
+	struct ath12k_base *ab = ath12k_ppe_ds_ab(node);
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct ath12k_ppe_ds_tx_desc *desc;
+	struct sk_buff *skb;
+	dma_addr_t paddr;
+	u32 dma_len;
+	u32 done = 0;
+
+	dma_len = size - headroom;
+	while (done < count) {
+		spin_lock_bh(&ppe->tx_desc_lock);
+		desc = list_first_entry_or_null(&ppe->tx_desc_free_list,
+						struct ath12k_ppe_ds_tx_desc,
+						list);
+		if (desc)
+			list_del_init(&desc->list);
+		spin_unlock_bh(&ppe->tx_desc_lock);
+		if (!desc)
+			break;
+
+		skb = alloc_skb(size, GFP_ATOMIC | __GFP_NOWARN);
+		if (!skb) {
+			spin_lock_bh(&ppe->tx_desc_lock);
+			list_add_tail(&desc->list, &ppe->tx_desc_free_list);
+			spin_unlock_bh(&ppe->tx_desc_lock);
+			break;
+		}
+		skb_reserve(skb, headroom);
+		paddr = dma_map_single(ab->dev, skb->data, dma_len,
+				       DMA_BIDIRECTIONAL);
+		if (dma_mapping_error(ab->dev, paddr)) {
+			dev_kfree_skb_any(skb);
+			spin_lock_bh(&ppe->tx_desc_lock);
+			list_add_tail(&desc->list, &ppe->tx_desc_free_list);
+			spin_unlock_bh(&ppe->tx_desc_lock);
+			break;
+		}
+
+		desc->skb = skb;
+		desc->paddr = paddr;
+		desc->dma_len = dma_len;
+		desc->in_use = true;
+		buffers[done].dma = paddr;
+		buffers[done].cookie = desc->cookie;
+		done++;
+	}
+
+	atomic64_add(done, &ppe->stats.tx_alloc);
+	if (done != count)
+		atomic64_add(count - done, &ppe->stats.tx_alloc_fail);
+	return done;
+}
+
+static void ath12k_ppe_ds_ppe2tcl_release(struct qcom_ppe_ds_node *node,
+					  u64 cookie)
+{
+	struct ath12k_base *ab = ath12k_ppe_ds_ab(node);
+	struct ath12k_ppe_ds_tx_desc *desc;
+
+	desc = ath12k_ppe_ds_tx_desc_get(ab, cookie);
+	ath12k_ppe_ds_tx_desc_release(ab, desc);
+}
+
+static bool
+ath12k_ppe_ds_rx_requeue(struct ath12k_base *ab,
+			 struct ath12k_rx_desc_info *rx_desc)
+{
+	struct dp_rxdma_ring *rx_ring = &ab->dp.rx_refill_buf_ring;
+	struct ath12k_buffer_addr *ring_desc;
+	struct hal_srng *srng;
+	struct sk_buff *skb = rx_desc->skb;
+	dma_addr_t paddr;
+	u32 len;
+
+	if (!skb)
+		return false;
+
+	paddr = ATH12K_SKB_RXCB(skb)->paddr;
+	len = skb->len + skb_tailroom(skb);
+	srng = &ab->hal.srng_list[rx_ring->refill_buf_ring.ring_id];
+
+	spin_lock_bh(&srng->lock);
+	ath12k_hal_srng_access_begin(ab, srng);
+	ring_desc = ath12k_hal_srng_src_get_next_entry(ab, srng);
+	if (ring_desc) {
+		dma_sync_single_for_device(ab->dev, paddr, len, DMA_FROM_DEVICE);
+		ath12k_hal_rx_buf_addr_info_set(ring_desc, paddr, rx_desc->cookie,
+					       ab->hw_params->hal_params->rx_buf_rbm);
+	}
+	ath12k_hal_srng_access_end(ab, srng);
+	spin_unlock_bh(&srng->lock);
+
+	if (ring_desc)
+		return true;
+
+	dma_unmap_single(ab->dev, paddr, len, DMA_FROM_DEVICE);
+	dev_kfree_skb_any(skb);
+	rx_desc->skb = NULL;
+	rx_desc->in_use = false;
+	spin_lock_bh(&ab->dp.rx_desc_lock);
+	list_add_tail(&rx_desc->list, &ab->dp.rx_desc_free_list);
+	spin_unlock_bh(&ab->dp.rx_desc_lock);
+	return false;
+}
+
+static struct ath12k_base *
+ath12k_ppe_ds_rx_desc_owner(struct ath12k_base *ab,
+			    struct ath12k_rx_desc_info *rx_desc)
+{
+	struct ath12k_rx_desc_info *page;
+	struct ath12k_base *src_ab;
+	uintptr_t addr = (uintptr_t)rx_desc;
+	uintptr_t start, end;
+	int i, j;
+
+	if (!ab->ag || !rx_desc)
+		return NULL;
+
+	for (i = 0; i < ab->ag->num_devices; i++) {
+		src_ab = ab->ag->ab[i];
+		if (!src_ab || !src_ab->dp.rxbaddr)
+			continue;
+		for (j = 0; j < ATH12K_NUM_RX_SPT_PAGES(src_ab); j++) {
+			page = src_ab->dp.rxbaddr[j];
+			if (!page)
+				continue;
+			start = (uintptr_t)page;
+			end = (uintptr_t)(page + ATH12K_MAX_SPT_ENTRIES);
+			if (addr >= start && addr < end)
+				return src_ab;
+		}
+	}
+
+	return NULL;
+}
+
+static void ath12k_ppe_ds_reo_cons_update(struct ath12k_base *ab)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct hal_srng *srng;
+	u16 cons;
+
+	if (!ppe->node || READ_ONCE(ppe->quiesced))
+		return;
+
+	cons = qcom_ppe_ds_reo2ppe_cons(ppe->node);
+	srng = &ab->hal.srng_list[ppe->reo2ppe_ring.ring_id];
+	spin_lock_bh(&srng->lock);
+	ath12k_hal_srng_access_begin(ab, srng);
+	srng->u.dst_ring.tp = cons * srng->entry_size;
+	ath12k_hal_srng_access_end(ab, srng);
+	spin_unlock_bh(&srng->lock);
+	atomic64_inc(&ppe->stats.reo2ppe_cons);
+}
+
+static void
+ath12k_ppe_ds_reo2ppe_complete(struct qcom_ppe_ds_node *node,
+			       struct qcom_ppe_ds_txcmpl *buffers,
+			       u32 count)
+{
+	struct ath12k_base *ab = ath12k_ppe_ds_ab(node);
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct ath12k_rx_desc_info *rx_desc;
+	struct ath12k_base *src_ab;
+	u32 i;
+
+	for (i = 0; i < count; i++) {
+		rx_desc = (void *)(uintptr_t)buffers[i].cookie;
+		src_ab = ath12k_ppe_ds_rx_desc_owner(ab, rx_desc);
+		if (!src_ab || rx_desc->magic != ATH12K_DP_RX_DESC_MAGIC ||
+		    rx_desc->device_id != src_ab->device_id) {
+			atomic64_inc(&ppe->stats.rx_drop);
+			continue;
+		}
+
+		if (!ath12k_ppe_ds_rx_requeue(src_ab, rx_desc))
+			atomic64_inc(&ppe->stats.rx_drop);
+		else
+			atomic64_inc(&ppe->stats.rx_requeue);
+	}
+
+	atomic64_add(count, &ppe->stats.rx_complete);
+	ath12k_ppe_ds_reo_cons_update(ab);
+}
+
+static void ath12k_ppe_ds_quiesce(struct qcom_ppe_ds_node *node)
+{
+	struct ath12k_base *ab = ath12k_ppe_ds_ab(node);
+
+	WRITE_ONCE(ab->dp.ppe_ds.quiesced, true);
+}
+
+static const struct qcom_ppe_ds_ops ath12k_ppe_ds_ops = {
+	.ppe2tcl_produce = ath12k_ppe_ds_ppe2tcl_produce,
+	.ppe2tcl_refill = ath12k_ppe_ds_ppe2tcl_refill,
+	.ppe2tcl_release = ath12k_ppe_ds_ppe2tcl_release,
+	.reo2ppe_complete = ath12k_ppe_ds_reo2ppe_complete,
+	.quiesce = ath12k_ppe_ds_quiesce,
+};
+
+static void ath12k_ppe_ds_hw_config(struct ath12k_base *ab)
+{
+	u32 val;
+
+	ath12k_hif_write32(ab, ATH12K_PPE_REO_DEST_REG,
+			   ATH12K_PPE_REO_DEST_VALUE);
+	val = ath12k_hif_read32(ab, ATH12K_PPE_TCL_RBM_MAP_REG);
+	val &= ~ATH12K_PPE_TCL_RBM_MASK;
+	val |= HAL_WBM2SW_PPEDS_TX_CMPL_MAP_ID << ATH12K_PPE_TCL_RBM_SHIFT;
+	ath12k_hif_write32(ab, ATH12K_PPE_TCL_RBM_MAP_REG, val);
+}
+
+int ath12k_ppe_ds_attach(struct ath12k_base *ab)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct qcom_ppe_ds_reg reg = {};
+	int node_id, ret;
+
+	if (!ath12k_ppe_ds_enabled(ab))
+		return 0;
+	if (ppe->registered)
+		return 0;
+
+	node_id = ab->ag && ab->ag->num_devices > 1 ? ab->wsi_info.index : 0;
+	ppe->node = qcom_ppe_ds_node_alloc_id(ab->dev, &ath12k_ppe_ds_ops,
+					      node_id, sizeof(struct ath12k_base *));
+	if (IS_ERR(ppe->node)) {
+		ret = PTR_ERR(ppe->node);
+		ppe->node = NULL;
+		return ret;
+	}
+	*(struct ath12k_base **)qcom_ppe_ds_priv(ppe->node) = ab;
+
+	ret = ath12k_ppe_ds_tx_desc_init(ab);
+	if (ret)
+		goto err_desc;
+
+	ret = ath12k_dp_srng_setup(ab, &ppe->reo2ppe_ring, HAL_REO2PPE, 0, 0,
+				   DP_REO2PPE_RING_SIZE);
+	if (ret)
+		goto err_desc;
+	ret = ath12k_dp_srng_setup(ab, &ppe->ppe2tcl_ring, HAL_PPE2TCL, 0, 0,
+				   DP_PPE2TCL_RING_SIZE);
+	if (ret)
+		goto err_reo;
+	ret = ath12k_dp_srng_setup(ab, &ppe->txcmpl_ring, HAL_WBM2SW_RELEASE,
+				   HAL_WBM2SW_PPEDS_TX_CMPL_RING_NUM, 0,
+				   DP_PPE_WBM2SW_RING_SIZE);
+	if (ret)
+		goto err_tcl;
+
+	ath12k_ppe_ds_hw_config(ab);
+	reg.ppe2tcl_dma = ppe->ppe2tcl_ring.paddr;
+	reg.reo2ppe_dma = ppe->reo2ppe_ring.paddr;
+	reg.ppe2tcl_count = DP_PPE2TCL_RING_SIZE;
+	reg.reo2ppe_count = DP_REO2PPE_RING_SIZE;
+	reg.rxfill_count = DP_PPE2TCL_RING_SIZE;
+	reg.txcmpl_count = DP_REO2PPE_RING_SIZE;
+	reg.buffer_size = ATH12K_PPE_DS_BUFFER_SIZE;
+	reg.headroom = ATH12K_PPE_DS_HEADROOM;
+	reg.rxfill_low_threshold = ATH12K_PPE_DS_RXFILL_THRESHOLD;
+	ret = qcom_ppe_ds_register(ppe->node, &reg);
+	if (ret)
+		goto err_cmpl;
+
+	ppe->registered = true;
+	ppe->quiesced = true;
+	ath12k_info(ab, "PPE direct-switch node %d registered\n",
+		    qcom_ppe_ds_node_id(ppe->node));
+	return 0;
+
+err_cmpl:
+	ath12k_dp_srng_cleanup(ab, &ppe->txcmpl_ring);
+err_tcl:
+	ath12k_dp_srng_cleanup(ab, &ppe->ppe2tcl_ring);
+err_reo:
+	ath12k_dp_srng_cleanup(ab, &ppe->reo2ppe_ring);
+err_desc:
+	ath12k_ppe_ds_tx_desc_cleanup(ab);
+	qcom_ppe_ds_node_free(ppe->node);
+	ppe->node = NULL;
+	return ret;
+}
+
+int ath12k_ppe_ds_start(struct ath12k_base *ab)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	int ret;
+
+	if (!ppe->registered || ppe->started)
+		return 0;
+
+	WRITE_ONCE(ppe->quiesced, false);
+	ret = qcom_ppe_ds_start(ppe->node);
+	if (ret) {
+		WRITE_ONCE(ppe->quiesced, true);
+		return ret;
+	}
+	ppe->started = true;
+	return 0;
+}
+
+void ath12k_ppe_ds_stop(struct ath12k_base *ab)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	int i, j;
+
+	if (!ppe->registered || !ppe->started)
+		return;
+
+	qcom_ppe_ds_stop(ppe->node);
+	ppe->started = false;
+	ath12k_ppe_ds_service_tx_completion(ab, DP_PPE_WBM2SW_RING_SIZE);
+
+	spin_lock_bh(&ppe->tx_desc_lock);
+	for (i = 0; i < DP_PPE_DS_TX_SPT_PAGES; i++)
+		for (j = 0; j < ATH12K_MAX_SPT_ENTRIES; j++)
+			if (ppe->tx_desc_pages[i][j].in_use)
+				ath12k_ppe_ds_tx_desc_release_locked(ab,
+							    &ppe->tx_desc_pages[i][j]);
+	spin_unlock_bh(&ppe->tx_desc_lock);
+}
+
+void ath12k_ppe_ds_detach(struct ath12k_base *ab)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+
+	if (!ppe->registered)
+		return;
+
+	ath12k_ppe_ds_stop(ab);
+	qcom_ppe_ds_node_free(ppe->node);
+	ppe->node = NULL;
+	ppe->registered = false;
+	ath12k_dp_srng_cleanup(ab, &ppe->txcmpl_ring);
+	ath12k_dp_srng_cleanup(ab, &ppe->ppe2tcl_ring);
+	ath12k_dp_srng_cleanup(ab, &ppe->reo2ppe_ring);
+	ath12k_ppe_ds_tx_desc_cleanup(ab);
+}
+
+int ath12k_ppe_ds_service_ppe2tcl(struct ath12k_base *ab)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct hal_srng *srng;
+	u16 cons, prod;
+
+	if (!ppe->started || READ_ONCE(ppe->quiesced))
+		return 0;
+
+	srng = &ab->hal.srng_list[ppe->ppe2tcl_ring.ring_id];
+	spin_lock_bh(&srng->lock);
+	ath12k_hal_srng_access_begin(ab, srng);
+	cons = srng->u.src_ring.cached_tp / srng->entry_size;
+	qcom_ppe_ds_ppe2tcl_consume(ppe->node, cons);
+	prod = qcom_ppe_ds_ppe2tcl_prod(ppe->node);
+	srng->u.src_ring.hp = prod * srng->entry_size;
+	ath12k_hal_srng_access_end(ab, srng);
+	spin_unlock_bh(&srng->lock);
+	atomic64_inc(&ppe->stats.ppe2tcl_cons);
+	return 0;
+}
+
+int ath12k_ppe_ds_service_reo2ppe(struct ath12k_base *ab)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct hal_srng *srng;
+	u16 prod, cons;
+
+	if (!ppe->started || READ_ONCE(ppe->quiesced))
+		return 0;
+
+	srng = &ab->hal.srng_list[ppe->reo2ppe_ring.ring_id];
+	spin_lock_bh(&srng->lock);
+	ath12k_hal_srng_access_begin(ab, srng);
+	prod = srng->u.dst_ring.cached_hp / srng->entry_size;
+	qcom_ppe_ds_reo2ppe_produce(ppe->node, prod);
+	cons = qcom_ppe_ds_reo2ppe_cons(ppe->node);
+	srng->u.dst_ring.tp = cons * srng->entry_size;
+	ath12k_hal_srng_access_end(ab, srng);
+	spin_unlock_bh(&srng->lock);
+	atomic64_inc(&ppe->stats.reo2ppe_prod);
+	atomic64_inc(&ppe->stats.reo2ppe_cons);
+	return 0;
+}
+
+int ath12k_ppe_ds_service_tx_completion(struct ath12k_base *ab, int budget)
+{
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct ath12k_ppe_ds_tx_desc *tx_desc;
+	struct hal_wbm_completion_ring_tx *desc;
+	struct hal_srng *srng;
+	u64 addr;
+	u32 cookie;
+	int done = 0;
+
+	if (!ppe->registered)
+		return 0;
+
+	srng = &ab->hal.srng_list[ppe->txcmpl_ring.ring_id];
+	spin_lock_bh(&srng->lock);
+	ath12k_hal_srng_access_begin(ab, srng);
+	while (done < budget &&
+	       (desc = ath12k_hal_srng_dst_get_next_entry(ab, srng))) {
+		if (le32_get_bits(desc->info0, HAL_WBM_COMPL_TX_INFO0_CC_DONE)) {
+			addr = le32_to_cpu(desc->buf_va_lo) |
+			       (u64)le32_to_cpu(desc->buf_va_hi) << 32;
+			tx_desc = (void *)(uintptr_t)addr;
+			if (!ath12k_ppe_ds_tx_desc_valid(ab, tx_desc))
+				tx_desc = NULL;
+		} else {
+			cookie = le32_get_bits(desc->info0,
+					       HAL_WBM_COMPL_TX_INFO0_SW_COOKIE_LO) |
+				 le32_get_bits(desc->info3,
+					       HAL_WBM_COMPL_TX_INFO3_SW_COOKIE_HI) << 12;
+			tx_desc = ath12k_ppe_ds_tx_desc_get(ab, cookie);
+		}
+		if (tx_desc)
+			ath12k_ppe_ds_tx_desc_release(ab, tx_desc);
+		done++;
+	}
+	ath12k_hal_srng_access_end(ab, srng);
+	spin_unlock_bh(&srng->lock);
+
+	atomic64_add(done, &ppe->stats.tx_complete);
+	return done;
+}
+
+static void ath12k_ppe_ds_vp_write(struct ath12k_link_vif *arvif,
+				   u32 value)
+{
+	struct ath12k_base *ab = arvif->ar->ab;
+
+	ath12k_hif_write32(ab, ATH12K_PPE_VP_TABLE_BASE +
+			   arvif->ppe_vp * ATH12K_PPE_VP_TABLE_STRIDE, value);
+}
+
+int ath12k_ppe_ds_vif_attach(struct ath12k_link_vif *arvif)
+{
+	struct ath12k_base *ab = arvif->ar->ab;
+	struct ath12k_ppe_ds *ppe = &ab->dp.ppe_ds;
+	struct ieee80211_vif *vif = ath12k_ahvif_to_vif(arvif->ahvif);
+	struct wireless_dev *wdev = ieee80211_vif_to_wdev(vif);
+	u32 config = 0;
+	int search_idx = 0;
+	int vp;
+
+	if (!ppe->started || !wdev || !wdev->netdev)
+		return 0;
+	if (vif->type != NL80211_IFTYPE_AP &&
+	    vif->type != NL80211_IFTYPE_STATION)
+		return 0;
+	if (arvif->ppe_vp >= 64)
+		return 0;
+
+	vp = qcom_ppe_ds_vp_alloc(ppe->node, wdev->netdev);
+	if (vp < 0)
+		return vp;
+
+	if (vif->type == NL80211_IFTYPE_STATION) {
+		spin_lock_bh(&ppe->vp_lock);
+		search_idx = find_first_zero_bit(&ppe->search_idx_map,
+						ATH12K_PPE_SEARCH_TABLE_SIZE);
+		if (search_idx < ATH12K_PPE_SEARCH_TABLE_SIZE)
+			__set_bit(search_idx, &ppe->search_idx_map);
+		spin_unlock_bh(&ppe->vp_lock);
+		if (search_idx >= ATH12K_PPE_SEARCH_TABLE_SIZE) {
+			qcom_ppe_ds_vp_free(ppe->node, vp);
+			return -ENOSPC;
+		}
+	}
+
+	arvif->ppe_vp = vp;
+	arvif->ppe_search_idx = search_idx;
+	config |= u32_encode_bits(vp, ATH12K_PPE_VP_NUM) |
+		  u32_encode_bits(arvif->ar->lmac_id, ATH12K_PPE_VP_PMAC_ID) |
+		  u32_encode_bits(arvif->bank_id, ATH12K_PPE_VP_BANK_ID) |
+		  u32_encode_bits(arvif->vdev_id, ATH12K_PPE_VP_VDEV_ID) |
+		  u32_encode_bits(search_idx, ATH12K_PPE_VP_SEARCH_IDX);
+	ath12k_ppe_ds_vp_write(arvif, config);
+	return 0;
+}
+
+void ath12k_ppe_ds_vif_detach(struct ath12k_link_vif *arvif)
+{
+	struct ath12k_base *ab;
+	struct ath12k_ppe_ds *ppe;
+	struct ieee80211_vif *vif;
+
+	if (!arvif || !arvif->ar || arvif->ppe_vp < 64)
+		return;
+	ab = arvif->ar->ab;
+	ppe = &ab->dp.ppe_ds;
+	vif = ath12k_ahvif_to_vif(arvif->ahvif);
+
+	ath12k_ppe_ds_vp_write(arvif, 0);
+	qcom_ppe_ds_vp_free(ppe->node, arvif->ppe_vp);
+	if (vif->type == NL80211_IFTYPE_STATION) {
+		ath12k_hif_write32(ab, ATH12K_PPE_SEARCH_TABLE_BASE +
+				   arvif->ppe_search_idx * 4, 0);
+		spin_lock_bh(&ppe->vp_lock);
+		__clear_bit(arvif->ppe_search_idx, &ppe->search_idx_map);
+		spin_unlock_bh(&ppe->vp_lock);
+	}
+	arvif->ppe_vp = -1;
+	arvif->ppe_search_idx = -1;
+}
+
+void ath12k_ppe_ds_peer_route(struct ath12k *ar,
+			      struct ath12k_link_vif *arvif,
+			      struct ath12k_link_sta *arsta, bool enable)
+{
+	struct ath12k_base *ab = ar->ab;
+	struct ieee80211_vif *vif = ath12k_ahvif_to_vif(arvif->ahvif);
+	u32 map = 0;
+
+	if (!ab->dp.ppe_ds.started || arvif->ppe_vp < 64)
+		return;
+
+	if (vif->type == NL80211_IFTYPE_STATION) {
+		if (enable)
+			map = u32_encode_bits(arvif->ast_idx,
+					      ATH12K_PPE_SEARCH_AST_IDX) |
+			      u32_encode_bits(arvif->ast_hash,
+					      ATH12K_PPE_SEARCH_AST_HASH);
+		ath12k_hif_write32(ab, ATH12K_PPE_SEARCH_TABLE_BASE +
+				   arvif->ppe_search_idx * 4, map);
+	}
+
+	ath12k_wmi_config_peer_ppeds_routing(ar, arsta->addr, arvif->vdev_id,
+					      arvif->ppe_vp, enable);
+}
