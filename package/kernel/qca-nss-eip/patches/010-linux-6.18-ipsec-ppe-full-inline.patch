+static void
+eip_ipsec_flow_tuple_set(struct eip_flow_tuple *dst,
+			 const struct qcom_ppe_eip_inner_tuple *src)
+{
+	memset(dst, 0, sizeof(*dst));
+	dst->ip_ver = src->ipv6 ? 6 : IPVERSION;
+	dst->ip_proto = src->protocol;
+	/* EIP-197's inner-flow hash consumes L4 ports as host-order values,
+	 * despite the exported tuple fields carrying sparse __be16 types.
+	 */
+	dst->src_port = ntohs(src->src_port);
+	dst->dst_port = ntohs(src->dst_port);
+	/* The EIP inner classifier must not include the outbound ESP SPI. */
+	dst->spi = 0;
+
+	if (src->ipv6) {
+		memcpy(dst->src_ip, &src->src.v6, sizeof(src->src.v6));
+		memcpy(dst->dst_ip, &src->dst.v6, sizeof(src->dst.v6));
+		return;
+	}
+
+	dst->src_ip[0] = src->src.v4;
+	dst->dst_ip[0] = src->dst.v4;
+}
+
+static bool eip_ipsec_flow_rekey_match(const struct eip_ipsec_sa *a,
+				       const struct eip_ipsec_sa *b)
+{
+	size_t addr_len;
+	u32 mask = EIP_IPSEC_FLAG_ENC | EIP_IPSEC_FLAG_IPV6 |
+		   EIP_IPSEC_FLAG_UDP | EIP_IPSEC_FLAG_TUNNEL;
+
+	if ((a->flags & mask) != (b->flags & mask) ||
+	    a->tuple.ip_version != b->tuple.ip_version ||
+	    a->tuple.protocol != b->tuple.protocol ||
+	    a->tuple.sport != b->tuple.sport ||
+	    a->tuple.dport != b->tuple.dport)
+		return false;
+
+	addr_len = a->tuple.ip_version == IPVERSION ?
+		   sizeof(a->tuple.src_ip[0]) : sizeof(a->tuple.src_ip);
+
+	return !memcmp(a->tuple.src_ip, b->tuple.src_ip, addr_len) &&
+	       !memcmp(a->tuple.dest_ip, b->tuple.dest_ip, addr_len);
+}
