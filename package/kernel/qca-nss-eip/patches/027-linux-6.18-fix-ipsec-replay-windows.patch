 /*
+ * eip_ipsec_replay_supported()
+ *	Check whether EIP96 supports the requested anti-replay window.
+ */
+bool eip_ipsec_replay_supported(struct eip_ctx *ctx,
+				enum eip_ipsec_replay replay)
+{
+	if (!ctx || !ctx->ep)
+		return false;
+
+	switch (replay) {
+	case EIP_IPSEC_REPLAY_NONE:
+	case EIP_IPSEC_REPLAY_32:
+	case EIP_IPSEC_REPLAY_64:
+	case EIP_IPSEC_REPLAY_128:
+		return true;
+	case EIP_IPSEC_REPLAY_256:
+		return ctx->ep->eip96_options &
+			(EIP_HW_PE_EIP96_SEQMASK_256 |
+			 EIP_HW_PE_EIP96_SEQMASK_384);
+	case EIP_IPSEC_REPLAY_384:
+		return ctx->ep->eip96_options & EIP_HW_PE_EIP96_SEQMASK_384;
+	default:
+		return false;
+	}
+}
+EXPORT_SYMBOL(eip_ipsec_replay_supported);
