 #include <crypto/aes.h>
 #include "eip_ipsec_priv.h"
 
+/* Convert only replay windows that EIP96 can represent exactly. */
+bool eip_ipsec_replay_from_window(u32 replay_win,
+				  enum eip_ipsec_replay *replay)
+{
+	switch (replay_win) {
+	case 0:
+		*replay = EIP_IPSEC_REPLAY_NONE;
+		return true;
+	case 32:
+		*replay = EIP_IPSEC_REPLAY_32;
+		return true;
+	case 64:
+		*replay = EIP_IPSEC_REPLAY_64;
+		return true;
+	case 128:
+		*replay = EIP_IPSEC_REPLAY_128;
+		return true;
+	case 256:
+		*replay = EIP_IPSEC_REPLAY_256;
+		return true;
+	case 384:
+		*replay = EIP_IPSEC_REPLAY_384;
+		return true;
+	default:
+		return false;
+	}
+}
