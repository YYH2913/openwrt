+	}
 
+	tr_stats = this_cpu_ptr(tr->stats_pcpu);
 	tr_stats->rx_frags += nsegs;
 	tr_stats->rx_pkts++;
 	tr_stats->rx_bytes += skb->len;
@@ -223,11 +229,17 @@ static inline void eip_dma_hy_tr_deliver
  */
 static inline void eip_dma_hy_tr_deliver_err(struct eip_tr *tr, struct sk_buff *skb, uint32_t nsegs, uint16_t tr_err)
 {
-	struct eip_tr_stats *tr_stats = this_cpu_ptr(tr->stats_pcpu);
+	struct eip_tr_stats *tr_stats;
 
-	BUG_ON(tr->svc != EIP_SVC_IPSEC &&
-	       tr->svc != EIP_SVC_HYBRID_IPSEC);
+	if (unlikely((tr->svc != EIP_SVC_IPSEC &&
+		      tr->svc != EIP_SVC_HYBRID_IPSEC) ||
+		     !tr->ipsec.ops.err_cb)) {
+		pr_warn_ratelimited("%px: invalid hybrid error service %u\n", tr, tr->svc);
+		consume_skb(skb);
+		return;
+	}
 
+	tr_stats = this_cpu_ptr(tr->stats_pcpu);
 	tr_stats->rx_frags += nsegs;
 	tr_stats->rx_pkts++;
 	tr_stats->rx_bytes += skb->len;
@@ -632,6 +642,7 @@ int eip_dma_hy_tx_comp(struct eip_dma *d
 		struct eip_sw_desc *sw;
 
 		sw = (struct eip_sw_desc *)dma->in.meta[in_cidx];
+		dma->in.meta[in_cidx] = 0;
 		in_cidx = EIP_DMA_IDX_INC(in_cidx);
 
 		if (!sw)
--- a/driver/eip197/eip_flow.c
+++ b/driver/eip197/eip_flow.c
@@ -518,7 +518,13 @@ int eip_flow_add(struct eip_tun *tun, st
 	 * Obtain the tail of the current chain. Here, atleast one node will be already present,hence tail can't be null.
 	 */
 	tail_flow = eip_flow_get_tail(flow_head);
-	BUG_ON(tail_flow == NULL);
+	if (WARN_ON_ONCE(!tail_flow)) {
