From: Yanghan Ye <yyh94306@gmail.com>
Date: Wed, 5 Aug 2026 23:30:00 +0800
Subject: [PATCH] qca-nss-eip: harden recoverable error paths

Several vendor error paths turn recoverable hardware or lifecycle faults into
kernel crashes.  In particular, an HMAC key-digest error panics while leaving
the synchronous caller blocked, IPsec lookaside requests install a NULL error
callback, and defensive flow and device checks use BUG_ON().

Complete failed digest requests and propagate the failure to transform-record
initialization.  Give IPsec lookaside requests a real error completion, reject
invalid hybrid services without invoking the wrong callback union, and fail
corrupt flow/device lifecycle operations without taking down the system.
Clear consumed command-ring metadata so a stale completion cannot reuse an
old software descriptor after the ring wraps.

The CodeLinaro nss-eip branches retain the crashing behavior and no external
correction for these faults could be identified.

Link: https://git.codelinaro.org/clo/qsdk/oss/lklm/nss-eip/-/tree/10a89a95f814cd325e23105f102428644f45014f
Assisted-by: Codex:GPT-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
--- a/driver/eip197/eip_tr_ahash.c
+++ b/driver/eip197/eip_tr_ahash.c
@@ -197,6 +197,11 @@ static const struct eip_svc_entry ahash_
 
 };
 
+struct eip_tr_ahash_digest_result {
+	struct completion *completion;
+	bool success;
+};
+
 /*
  * eip_tr_ahash_tx_complete()
  *	Free Resources held during transmit.
@@ -224,11 +229,14 @@ static inline void eip_tr_ahash_tx_compl
  */
 static void eip_tr_ahash_digest_err(struct eip_tr *tr, struct eip_hw_desc *hw, struct eip_sw_desc *sw, uint16_t cle_err, uint16_t tr_err)
 {
+	struct eip_tr_ahash_digest_result *result = sw->req;
+
 	/*
 	 * Digest computation must not fail unless there is any programming error.
 	 */
 	pr_err("%px: Digest completed with cle_err(%u) tr_err(%u)\n", tr, cle_err, tr_err);
-	BUG_ON(1);
+	eip_tr_ahash_tx_complete(tr, sw);
+	complete(result->completion);
 }
 
 /*
@@ -237,15 +246,16 @@ static void eip_tr_ahash_digest_err(stru
  */
 static void eip_tr_ahash_digest_done(struct eip_tr *tr, struct eip_hw_desc *hw, struct eip_sw_desc *sw)
 {
-	struct completion *completion = sw->req;
+	struct eip_tr_ahash_digest_result *result = sw->req;
 
 	/*
 	 * Free transmit resources.
 	 */
+	result->success = true;
 	eip_tr_ahash_tx_complete(tr, sw);
 
 	pr_debug("%px: Digest completed\n", tr);
-	complete(completion);
+	complete(result->completion);
 }
 
 /*
@@ -365,8 +375,12 @@ bool eip_tr_ahash_key2digest(struct eip_
 	void *key_data;
 	uint32_t data_len;
 	uint32_t tk_words;
+	struct eip_tr_ahash_digest_result result = {
+		.success = false,
+	};
 
 	DECLARE_COMPLETION_ONSTACK(completion);
+	result.completion = &completion;
 
 	/*
 	 * Sanity check.
@@ -436,7 +450,7 @@ bool eip_tr_ahash_key2digest(struct eip_
 	sw->tr_addr_type = tr->tr_addr_type;
 	sw->tk_words = tk_words;
 	sw->hw_svc = EIP_HW_CMD_HWSERVICE_LAC;
-	sw->req = &completion;
+	sw->req = &result;
 
 	/*
 	 * Schedule the transformation.
@@ -463,7 +477,7 @@ retry:
 	pr_debug("%px: Waiting for Digest completion\n", tr);
 	wait_for_completion(&completion);
 	kfree(key_data);
-	return true;
+	return result.success;
 
 fail_alloc_desc:
 	kmem_cache_free(ctx->tk_cache, tk);
--- a/driver/eip197/eip_tr_ipsec.h
+++ b/driver/eip197/eip_tr_ipsec.h
@@ -25,6 +25,8 @@
 void eip_tr_ipsec_dec_cmn_init(struct eip_tr *tr, struct eip_tr_info *info, const struct eip_svc_entry *algo);
 void eip_tr_ipsec_enc_cmn_init(struct eip_tr *tr, struct eip_tr_info *info, const struct eip_svc_entry *algo);
 void eip_tr_ipsec_tx_done(struct eip_tr *tr, struct eip_hw_desc *hw, struct eip_sw_desc *sw);
+void eip_tr_ipsec_tx_err(struct eip_tr *tr, struct eip_hw_desc *hw,
+		struct eip_sw_desc *sw, uint16_t cle_err, uint16_t tr_err);
 uint8_t eip_tr_ipsec_get_ohdr(uint32_t sa_flags);
 
 #endif /* __EIP_TR_IPSEC_H */
--- a/driver/eip197/eip_tr_ipsec.c
+++ b/driver/eip197/eip_tr_ipsec.c
@@ -538,6 +538,37 @@ void eip_tr_ipsec_tx_done(struct eip_tr
 	eip_tr_deref(tr);
 }
 
+/*
+ * eip_tr_ipsec_tx_err()
+ *	Hardware error callback for host-submitted inline packets.
+ */
+void eip_tr_ipsec_tx_err(struct eip_tr *tr, struct eip_hw_desc *hw,
+		struct eip_sw_desc *sw, uint16_t cle_err, uint16_t tr_err)
+{
+	eip_tr_err_callback_t cb = tr->ipsec.ops.err_cb;
+	struct sk_buff *skb = eip_req2skb(sw->req);
+	void *app_data = tr->ipsec.app_data;
+	struct eip_ctx *ctx = tr->ctx;
+	int err;
+
+	err = eip_tr_classify_err(cle_err, tr_err);
+	if (skb->len >= sizeof(struct ethhdr))
+		skb_pull(skb, sizeof(struct ethhdr));
+
+	kmem_cache_free(ctx->sw_cache, sw);
+
+	if (likely(cb)) {
+		cb(app_data, skb, err);
+	} else {
+		pr_warn_ratelimited("IPsec request failed without an error callback: %d\n",
+				    err);
+		consume_skb(skb);
+	}
+
+	/* Keep the TR, and therefore its SA callback data, alive through cb(). */
+	eip_tr_deref(tr);
+}
+
