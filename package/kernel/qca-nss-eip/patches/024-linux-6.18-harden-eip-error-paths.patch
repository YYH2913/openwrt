 	sw->tk_hdr |= skb->len;
 	sw->comp = &eip_tr_ipsec_tx_done;
-	sw->err_comp = NULL; /* There is no error in Transmit completion */
+	sw->err_comp = &eip_tr_ipsec_tx_err;
 
 	dma = &ctx->dma[smp_processor_id()];
 
