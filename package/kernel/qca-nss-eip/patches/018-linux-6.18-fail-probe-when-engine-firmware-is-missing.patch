From: Yanghan Ye <yyh94306@gmail.com>
Subject: [PATCH] qca-nss-eip: fail probe when engine firmware is missing

EIP-197 needs all four packet-engine firmware images before lookaside or
inline traffic can be processed.  The vendor driver logged a warning but
continued probing when request_firmware() failed, leaving apparently loaded
modules backed by an unusable engine.

Return firmware errors to the platform probe and leave the selected RAM bank
in reset.  This makes missing or inaccessible BIN-NSS firmware visible as a
hard initialization failure instead of silent software fallback.

Link: https://git.codelinaro.org/clo/qsdk/oss/lklm/nss-eip/-/tree/10a89a95f814cd325e23105f102428644f45014f
Assisted-by: Codex:GPT-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
--- a/driver/eip197/eip_hw.c
+++ b/driver/eip197/eip_hw.c
@@ -379,11 +379,11 @@
  * eip_hw_boot_ofpp()
  *	load output flow post processor (OFPP) firmware
  */
-static void eip_hw_boot_ofpp(struct device *dev, void __iomem *base_addr, const char *fw_name)
+static int eip_hw_boot_ofpp(struct device *dev, void __iomem *base_addr, const char *fw_name)
 {
 	const struct firmware *fw = NULL;
 	uint32_t *data;
-	int i;
+	int i, ret;
 
 	/*
 	 * pulling engine out of reset
@@ -394,9 +394,11 @@
 	/*
 	 * load the firmware to the engine
 	 */
-	if (request_firmware(&fw, fw_name, dev)) {
-		pr_warn("%px: FW(%s) load failed\n", dev, fw_name);
-		return;
+	ret = request_firmware(&fw, fw_name, dev);
+	if (ret) {
+		pr_err("%px: FW(%s) load failed: %d\n", dev, fw_name, ret);
+		iowrite32(0x0, base_addr + EIP_HW_PE_OCE_RAM_CTRL);
+		return ret;
 	}
 
 	for (i = 0, data = (uint32_t *)fw->data; i < fw->size; i += 4, data++)
@@ -417,17 +419,19 @@
 
 	pr_info("%px: %s version(0x%x)\n", dev, fw_name,
 			ioread32(base_addr + EIP_HW_OCE_OFPP_VERSION_REG));
+
+	return 0;
 }
 
