+static void eip_ipsec_sa_set_callbacks(struct eip_ipsec_sa *sa,
+				       struct eip_tr_info *tr_info,
+				       bool encap)
+{
+	tr_info->ipsec.app_data = sa;
+	if (encap) {
+		tr_info->ipsec.cb = sa->tuple.ip_version == IPVERSION ?
+			eip_ipsec_dev_enc_done_v4 : eip_ipsec_dev_enc_done_v6;
+		tr_info->ipsec.err_cb = eip_ipsec_dev_enc_err;
+		return;
+	}
+
+	tr_info->ipsec.cb = eip_ipsec_proto_dec_done;
+	tr_info->ipsec.err_cb = eip_ipsec_proto_dec_err;
+}
