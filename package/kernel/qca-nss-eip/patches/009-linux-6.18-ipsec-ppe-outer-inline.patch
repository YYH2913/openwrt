 /*
+ * eip_ipsec_proto_ppe_rx()
+ *	Deliver a decrypted packet which returned through PPE but missed a
+ *	downstream hardware flow.  The source VP is unique to this SA, so no SPI
+ *	lookup is needed during rekey overlap.
+ */
+bool eip_ipsec_proto_ppe_rx(void *app_data, struct sk_buff *skb,
+			    u16 service_code)
+{
+	struct eip_ipsec_sa *sa = eip_ipsec_sa_ref_unless_zero(app_data);
+	struct eip_ipsec_dev_stats *dev_stats;
+	struct eip_ipsec_sa_stats *sa_stats;
+	unsigned int ip_hdr_sz;
+	struct sec_path *sp;
+	struct xfrm_state *x;
+
+	if (unlikely(!sa))
+		return false;
+
+	dev_stats = this_cpu_ptr(sa->eid->stats_pcpu);
+	sa_stats = this_cpu_ptr(sa->stats_pcpu);
+
+	if (unlikely(service_code != EIP_IPSEC_PPE_SC_EIP2PPE ||
+		     !pskb_may_pull(skb, ETH_HLEN)))
+		goto drop;
+
+	if (sa->xs && unlikely(!eip_ipsec_xfrm_input_state_ok(sa->xs)))
+		goto drop;
+
+	/* PPE exception frames include the fake Ethernet header selected in the
+	 * EIP transform metadata.  Strip it before restoring XFRM receive state.
+	 */
+	skb_scrub_packet(skb, false);
+	skb->dev = sa->ndev;
+	skb->skb_iif = sa->ndev->ifindex;
+	skb->protocol = eth_type_trans(skb, sa->ndev);
+	skb->pkt_type = PACKET_HOST;
+	skb->ip_summed = CHECKSUM_NONE;
+	skb_reset_network_header(skb);
+
+	if (skb->protocol == htons(ETH_P_IP)) {
+		if (unlikely(!pskb_may_pull(skb, sizeof(struct iphdr)) ||
+			     ip_hdr(skb)->version != IPVERSION ||
+			     ip_hdr(skb)->ihl < 5))
+			goto drop;
+		ip_hdr_sz = ip_hdr(skb)->ihl * 4;
+		if (unlikely(!pskb_may_pull(skb, ip_hdr_sz)))
+			goto drop;
+	} else if (skb->protocol == htons(ETH_P_IPV6)) {
+		if (unlikely(!pskb_may_pull(skb, sizeof(struct ipv6hdr)) ||
+			     ipv6_hdr(skb)->version != 6))
+			goto drop;
+		ip_hdr_sz = sizeof(struct ipv6hdr);
+	} else {
+		goto drop;
+	}
+
+	skb_set_transport_header(skb, ip_hdr_sz);
+	x = sa->xs;
+	if (x) {
+		sp = secpath_set(skb);
+		if (unlikely(!sp || sp->len == XFRM_MAX_DEPTH)) {
+			sa_stats->fail_sp_alloc++;
+			goto drop;
+		}
+
+		if (unlikely(!refcount_inc_not_zero(&x->refcnt)))
+			goto drop;
+
+		sp->xvec[sp->len++] = x;
+	}
+
+	/* TR hardware deltas account all inline packets.  Count only the punt
+	 * here so exception traffic is not added to lifetime and byte totals
+	 * twice.
+	 */
+	dev_stats->rx_vp++;
+	netif_receive_skb(skb);
+	eip_ipsec_sa_deref(sa);
+	return true;
+
+drop:
+	dev_stats->rx_fail++;
+	eip_ipsec_sa_deref(sa);
+	consume_skb(skb);
+	return true;
+}
