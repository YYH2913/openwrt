+static struct net_device *
+eip_ipsec_sa_get_ingress_dev(const struct eip_ipsec_tuple *t)
+{
+	struct net_device *dev;
+
+	if (t->ip_version == IPVERSION) {
+		struct rtable *rt;
+
+		rt = ip_route_output(&init_net, htonl(t->src_ip[0]), 0, 0, 0,
+				     RT_SCOPE_UNIVERSE);
+		if (IS_ERR(rt))
+			return NULL;
+
+		dev = rt->dst.dev;
+		dev_hold(dev);
+		ip_rt_put(rt);
+		return dev;
+	}
+
+	if (t->ip_version == 6) {
+		struct in6_addr remote = {};
+		struct in6_addr local = {};
+		struct rt6_info *rt6;
+		int i;
+
+		for (i = 0; i < ARRAY_SIZE(t->src_ip); i++) {
+			remote.s6_addr32[i] = htonl(t->src_ip[i]);
+			local.s6_addr32[i] = htonl(t->dest_ip[i]);
+		}
+
+		rt6 = rt6_lookup(&init_net, &remote, NULL, 0, 0, 0);
+		if (!rt6)
+			rt6 = rt6_lookup(&init_net, &remote, &local, 0, 0, 0);
+		if (!rt6)
+			return NULL;
+
+		dev = rt6->dst.dev;
+		dev_hold(dev);
+		ip6_rt_put(rt6);
+		return dev;
+	}
+
+	return NULL;
+}
+
+static void eip_ipsec_sa_fill_eip_flow(const struct eip_ipsec_tuple *t,
+					struct eip_flow_tuple *flow)
+{
+	int i, words = t->ip_version == IPVERSION ? 1 : 4;
+
+	memset(flow, 0, sizeof(*flow));
+	flow->ip_ver = t->ip_version;
+	flow->ip_proto = t->protocol;
+	flow->spi = htonl(t->esp_spi);
+	/* EIP's outer IPsec classifier matches SPI for both ESP and NAT-T. */
+	for (i = 0; i < words; i++) {
+		flow->src_ip[i] = htonl(t->src_ip[i]);
+		flow->dst_ip[i] = htonl(t->dest_ip[i]);
+	}
+}
+
+static void eip_ipsec_sa_fill_ppe_flow(const struct eip_ipsec_tuple *t,
+					struct qcom_ppe_eip_tuple *flow)
+{
+	int i;
+
+	memset(flow, 0, sizeof(*flow));
+	flow->protocol = t->protocol;
+	flow->ipv6 = t->ip_version == 6;
+	if (flow->protocol == IPPROTO_UDP) {
+		flow->src_port = htons(t->sport);
+		flow->dst_port = htons(t->dport);
+	}
+
+	if (!flow->ipv6) {
+		flow->src.v4 = htonl(t->src_ip[0]);
+		flow->dst.v4 = htonl(t->dest_ip[0]);
+		return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(t->src_ip); i++) {
+		flow->src.v6.s6_addr32[i] = htonl(t->src_ip[i]);
+		flow->dst.v6.s6_addr32[i] = htonl(t->dest_ip[i]);
+	}
+}
+
+static void eip_ipsec_sa_inline_flow_stop(struct eip_ipsec_sa *sa)
+{
+	struct eip_flow_info flow_info = {};
+
+	if (sa->ppe_flow) {
+		qcom_ppe_eip_flow_put(sa->ppe_flow);
+		sa->ppe_flow = NULL;
+	}
+
+	if (sa->eip_flow_installed) {
+		flow_info.tuple = sa->eip_flow_tuple;
+		eip_flow_del(sa->inline_tun, &flow_info);
+		sa->eip_flow_installed = false;
+	}
+}
+
+static void eip_ipsec_sa_inline_rollback(struct eip_ipsec_sa *sa)
+{
+	eip_ipsec_sa_inline_flow_stop(sa);
+	if (sa->tr)
+		eip_tr_disable(sa->tr);
+	if (sa->ppe_vp >= 0) {
+		qcom_ppe_eip_vp_free(sa->ppe_vp);
+		sa->ppe_vp = -1;
+	}
+	if (sa->inline_tun) {
+		eip_tun_free(sa->inline_tun);
+		sa->inline_tun = NULL;
+	}
+	if (sa->tr) {
+		eip_tr_free(sa->tr);
+		sa->tr = NULL;
+	}
+	sa->inline_offload = false;
+}
+
+static int eip_ipsec_sa_inline_setup(struct eip_ipsec_sa *sa,
+				     struct eip_ipsec_data *data)
+{
+	struct eip_ipsec_drv *drv = &eip_ipsec_drv_g;
+	struct qcom_ppe_eip_tuple ppe_tuple;
+	struct eip_flow_info flow_info = {};
+	struct net_device *ingress;
+	struct eip_tr_info tr_info;
+	int err;
+
+	if (!drv->inline_ctx)
+		return -EOPNOTSUPP;
+
+	ingress = eip_ipsec_sa_get_ingress_dev(&sa->tuple);
+	if (!ingress)
+		return -ENETUNREACH;
+
+	sa->ppe_vp = qcom_ppe_eip_vp_alloc(sa->ndev,
+					      eip_ipsec_proto_ppe_rx, sa);
+	if (sa->ppe_vp < 0) {
+		err = sa->ppe_vp;
+		goto out_dev;
+	}
+
+	eip_ipsec_sa_data_to_tr_info(data, &sa->tuple,
+					 EIP_SVC_HYBRID_IPSEC, &tr_info);
+	eip_ipsec_sa_set_callbacks(sa, &tr_info, false);
+	eip_ipsec_ppe_mdata_set(&tr_info, sa->ppe_vp);
+	sa->tr = eip_tr_alloc(drv->inline_ctx, &tr_info);
+	if (!sa->tr) {
+		err = -EINVAL;
+		goto rollback;
+	}
+
+	sa->inline_tun = eip_tun_alloc(drv->inline_ctx);
+	if (!sa->inline_tun) {
+		err = -ENOMEM;
+		goto rollback;
+	}
+
+	eip_ipsec_sa_fill_eip_flow(&sa->tuple, &sa->eip_flow_tuple);
+	flow_info.tuple = sa->eip_flow_tuple;
+	flow_info.tr = sa->tr;
+	err = eip_flow_add(sa->inline_tun, &flow_info);
+	if (err)
+		goto rollback;
+	sa->eip_flow_installed = true;
+
+	eip_ipsec_sa_fill_ppe_flow(&sa->tuple, &ppe_tuple);
+	err = qcom_ppe_eip_flow_get(ingress, &ppe_tuple, &sa->ppe_flow);
+	if (err)
+		goto rollback;
+
+	sa->inline_offload = true;
+	pr_info("%p: enabled PPE-EIP-PPE decap for SPI 0x%x on %s (VP %d)\n",
+		sa, sa->tuple.esp_spi, ingress->name, sa->ppe_vp);
+	dev_put(ingress);
+	return 0;
