 	complete(&drv->completion);
 }
 
+static void eip_ipsec_stats_sync_work(struct work_struct *work)
+{
+	struct eip_ipsec_drv *drv = container_of(to_delayed_work(work),
+						   struct eip_ipsec_drv,
+						   stats_sync_work);
+	struct eip_ipsec_sa *sa;
+	int i;
+
+	rcu_read_lock_bh();
+	for (i = 0; i < ARRAY_SIZE(drv->sa_hlist); i++) {
+		hlist_for_each_entry_rcu(sa, &drv->sa_hlist[i], hnode) {
+			if (READ_ONCE(sa->inline_offload))
+				eip_ipsec_sa_sync_hw_stats(sa);
+		}
+	}
+	rcu_read_unlock_bh();
+
+	if (READ_ONCE(drv->stats_sync_enabled))
+		schedule_delayed_work(&drv->stats_sync_work,
+				      EIP_IPSEC_STATS_SYNC_INTERVAL);
+}
