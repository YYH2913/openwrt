+/* Fully inline packets never reach an EIP completion callback.  Consume the
+ * transform-record deltas periodically so Linux lifetime limits and the
+ * driver counters include PPE-forwarded traffic as well as exception punts.
+ */
+void eip_ipsec_sa_sync_hw_stats(struct eip_ipsec_sa *sa)
+{
+	struct eip_ipsec_dev_stats *dev_stats;
+	struct eip_ipsec_sa_stats *sa_stats;
+	struct eip_hw_stats delta = {};
+	struct xfrm_state *xs;
+
+	if (unlikely(!sa->tr))
+		return;
+
+	eip_tr_get_hw_stats(sa->tr, &delta);
+	if (!delta.pkt_cnt && !delta.byte_cnt)
+		return;
+
+	preempt_disable();
+	dev_stats = this_cpu_ptr(sa->eid->stats_pcpu);
+	sa_stats = this_cpu_ptr(sa->stats_pcpu);
+	dev_stats->rx_pkts += delta.pkt_cnt;
+	dev_stats->rx_bytes += delta.byte_cnt;
+	sa_stats->rx_pkts += delta.pkt_cnt;
+	sa_stats->rx_bytes += delta.byte_cnt;
+	preempt_enable();
+
+	xs = READ_ONCE(sa->xs);
+	if (!xs)
+		return;
+
+	spin_lock_bh(&xs->lock);
+	if (xs->km.state != XFRM_STATE_DEAD) {
+		xs->curlft.packets += delta.pkt_cnt;
+		xs->curlft.bytes += delta.byte_cnt;
+		xs->lastused = ktime_get_real_seconds();
+		xfrm_state_check_expire(xs);
+	}
+	spin_unlock_bh(&xs->lock);
+}
