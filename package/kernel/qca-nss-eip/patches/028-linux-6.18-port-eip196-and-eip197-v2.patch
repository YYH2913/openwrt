Index: nss-eip-10a89a95f814cd325e23105f102428644f45014f/driver/eip196/eip_dma.c
===================================================================
--- nss-eip-10a89a95f814cd325e23105f102428644f45014f.orig/driver/eip196/eip_dma.c
+++ nss-eip-10a89a95f814cd325e23105f102428644f45014f/driver/eip196/eip_dma.c
@@ -13,6 +13,7 @@
 #include <linux/debugfs.h>
 #include <linux/platform_device.h>
 #include <linux/slab.h>
+#include <linux/vmalloc.h>
 #include <linux/of_address.h>
 #include <linux/of_irq.h>
 
@@ -846,6 +847,12 @@ int eip_dma_res_init(struct eip_dma *dma
 	return 0;
 }
 
+static void eip_dma_la_irq_disable(struct eip_dma *dma)
+{
+	iowrite32(EIP_HW_HIA_IRQ_DISABLE, dma->out.proc_thresh);
+	iowrite32(EIP_HW_RDR_PROC_IRQ_STATUS, dma->out.proc_status);
+}
+
 /*
  * eip_dma_la_deinit()
  *	De-Initialize the DMA HW ring.
@@ -857,9 +864,13 @@ void eip_dma_la_deinit(struct eip_dma *d
 	}
 
 	debugfs_remove_recursive(dma->dentry);
+	eip_dma_la_irq_disable(dma);
+	irq_set_affinity_hint(dma->irq, NULL);
 	free_irq(dma->irq, dma);
 	napi_disable(&dma->out.napi);
+	eip_dma_la_irq_disable(dma);
 	netif_napi_del(&dma->out.napi);
+	free_netdev(dma->out.ndev);
 	kfree(dma->out.kaddr);
 	kfree(dma->in.kaddr);
 
@@ -886,9 +897,10 @@ int eip_dma_la_init(struct eip_dma *dma,
 	dma->irq_mask = EIP_HW_RDR_PROC_IRQ_STATUS;
 	dma->irq_status = base_addr + EIP_HW_HIA_RDR_STAT(ring_id);
 	dma->irq = platform_get_irq(ep->pdev, rx_cpu);
-	if (!dma->irq) {
-		pr_err("%px: irq_of_parse_and_map() fail for irq, ring_id(%u)\n", dma, ring_id);
-		return -EINVAL;
+	if (dma->irq < 0) {
+		pr_err("%p: failed to get IRQ index(%u) for ring_id(%u): %d\n",
+		       dma, rx_cpu, ring_id, dma->irq);
+		return dma->irq;
 	}
 
 	/*
@@ -913,16 +925,21 @@ int eip_dma_la_init(struct eip_dma *dma,
 	 */
 	status = request_irq(dma->irq, eip_dma_handle_irq, IRQF_SHARED, irq_name[ring_id], dma);
 	if (status < 0) {
-		pr_err("%px: IRQ %u request failed\n", dma, dma->irq);
+		pr_err("%p: IRQ %d request failed\n", dma, dma->irq);
 		goto fail_irq;
 	}
 
-	init_dummy_netdev(&dma->out.ndev);
+	dma->out.ndev = alloc_netdev_dummy(0);
+	if (!dma->out.ndev) {
+		status = -ENOMEM;
+		goto fail_netdev;
+	}
+
 #if (LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0))
-	netif_napi_add(&dma->out.ndev, &dma->out.napi, eip_dma_napi_rx_poll, eip_dma_rx_napi_weight);
+	netif_napi_add(dma->out.ndev, &dma->out.napi, eip_dma_napi_rx_poll, eip_dma_rx_napi_weight);
 #else
-	netif_napi_add_weight(&dma->out.ndev, &dma->out.napi, eip_dma_napi_rx_poll,
-			eip_dma_rx_napi_weight);
+	netif_napi_add_weight(dma->out.ndev, &dma->out.napi,
+			      eip_dma_napi_rx_poll, eip_dma_rx_napi_weight);
 #endif
 	napi_enable(&dma->out.napi);
 
@@ -936,7 +953,11 @@ int eip_dma_la_init(struct eip_dma *dma,
 	pr_info("%px: DMA ring(%u) configured and Rx mapped to cpu(%u)\n", dma, ring_id, rx_cpu);
 	return 0;
 
+fail_netdev:
+	eip_dma_la_irq_disable(dma);
+	free_irq(dma->irq, dma);
 fail_irq:
+	eip_dma_la_irq_disable(dma);
 	kfree(dma->out.kaddr);
 fail_res:
 	kfree(dma->in.kaddr);
