From 14528dfe8fb5fd149213706b1cdadfde9a05c9d6 Mon Sep 17 00:00:00 2001
From: Yanghan Ye <yyh94306@gmail.com>
Date: Fri, 7 Aug 2026 00:15:00 +0800
Subject: [PATCH] qca-nss-eip: port alternate engines to Linux 6.18

Bring the EIP196 and EIP197 v2 driver variants in line with the
Linux 6.18 APIs already used by the primary EIP197 implementation.
Select coherent DMA handling for IPQ95xx, include vmalloc declarations,
update platform remove callbacks, allocate dummy NAPI devices, and use
the upstream Qualcomm PPE port lookup.

Preserve negative IRQ lookup errors, quiesce ring interrupts during
teardown, free the original ring allocations and posted skbs, and
provide the synchronous transform invalidation required by the shared
IPsec clients. Scope internal callbacks and add missing prototypes so
both variants build cleanly.

Link: https://git.codelinaro.org/clo/qsdk/oss/lklm/nss-eip/-/tree/10a89a95f814cd325e23105f102428644f45014f
Assisted-by: Codex:GPT-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
Index: nss-eip-10a89a95f814cd325e23105f102428644f45014f/driver/eip196/Makefile
===================================================================
--- nss-eip-10a89a95f814cd325e23105f102428644f45014f.orig/driver/eip196/Makefile
+++ nss-eip-10a89a95f814cd325e23105f102428644f45014f/driver/eip196/Makefile
@@ -8,6 +8,10 @@ NSS_EIP_DRIVER_INCLUDE = -I$(obj)/../exp
 ccflags-y += $(NSS_EIP_DRIVER_INCLUDE)
 
 ccflags-y += -Wall -Werror
+ifeq ($(SoC),ipq95xx)
+ccflags-y += -DEIP_DMA_COHERENT
+endif
+
 ccflags-y += -DNSS_EIP_BUILD_ID=\"'Build_ID - $(shell date +'%m/%d/%y, %H:%M:%S') SoC=$(SoC)'\"
 
 obj-m += $(NSS_EIP_MOD_NAME).o
Index: nss-eip-10a89a95f814cd325e23105f102428644f45014f/driver/eip196/eip.c
===================================================================
--- nss-eip-10a89a95f814cd325e23105f102428644f45014f.orig/driver/eip196/eip.c
+++ nss-eip-10a89a95f814cd325e23105f102428644f45014f/driver/eip196/eip.c
@@ -183,7 +183,7 @@ fail_alloc:
  * eip_device_remove()
  *	Remove Device and free all linked resources.
  */
-static int eip_device_remove(struct platform_device *pdev)
+static void eip_device_remove(struct platform_device *pdev)
 {
 	struct eip_drv *drv = &eip_drv_g;
 	struct eip_pdev *ep;
@@ -209,7 +209,6 @@ static int eip_device_remove(struct plat
 	kfree(ep);
 	platform_set_drvdata(pdev, NULL);
 
-	return 0;
 }
 
 /*
@@ -252,7 +251,7 @@ EXPORT_SYMBOL(eip_feature_check);
  * eip_init_module()
  *	Initialize all the resources.
  */
-int __init eip_init_module(void)
+static int __init eip_init_module(void)
 {
 	struct eip_drv *drv = &eip_drv_g;
 
@@ -299,7 +298,7 @@ int __init eip_init_module(void)
  * eip_exit_module()
  *	Cleanup during module exit.
  */
-void __exit eip_exit_module(void)
+static void __exit eip_exit_module(void)
 {
 	struct eip_drv *drv = &eip_drv_g;
 	platform_driver_unregister(&eip_device);
