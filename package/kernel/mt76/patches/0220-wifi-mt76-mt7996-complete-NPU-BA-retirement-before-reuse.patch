 }
 
+int mt7996_npu_reset_rro_sessions(struct mt7996_dev *dev)
+{
+	const size_t group_size = MT7996_RRO_WINDOW_MAX_SIZE *
+				  sizeof(struct mt7996_wed_rro_addr);
+	const size_t session_size = MT7996_RRO_WINDOW_MAX_LEN *
+				    sizeof(struct mt7996_wed_rro_addr);
+	unsigned long start, deadline;
+	const unsigned int count = MT7996_RRO_MAX_SESSION + 1;
+	unsigned int sid;
+	int i, err;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	if (!is_mt7996(&dev->mt76) || !mt76_npu_device_active(&dev->mt76))
+		return 0;
+
+	BUILD_BUG_ON(MT7996_RRO_ADDR_ELEM_LEN != 128);
+	BUILD_BUG_ON(MT7996_RRO_MAX_SESSION != 1024);
+	BUILD_BUG_ON(MT7996_RRO_WINDOW_MAX_LEN != 1024);
+	BUILD_BUG_ON(MT7996_RRO_WINDOW_MAX_SIZE *
+		     sizeof(struct mt7996_wed_rro_addr) != SZ_64K);
+	BUILD_BUG_ON(MT7996_RRO_WINDOW_MAX_LEN *
+		     sizeof(struct mt7996_wed_rro_addr) != SZ_8K);
+
+	/* Validate the backing storage for the retained cold-init registrations. */
+	for (i = 0; i < ARRAY_SIZE(dev->wed_rro.addr_elem); i++) {
+		if (!dev->wed_rro.addr_elem[i].ptr ||
+		    dev->wed_rro.addr_elem[i].phy_addr > U32_MAX - group_size + 1)
+			return -EINVAL;
+	}
+	if (!dev->wed_rro.session.ptr ||
+	    dev->wed_rro.session.phy_addr > U32_MAX - session_size + 1)
+		return -EINVAL;
+
+	start = jiffies;
+	deadline = start + 30 * HZ;
+	dev_info(dev->mt76.dev,
+		 "NPU BA signature sweep start: SIDs 0-%u, budget_ms=%u\n",
+		 (unsigned int)MT7996_RRO_MAX_SESSION,
+		 jiffies_to_msecs(deadline - start));
+
+	/* The interface3 callback invalidates one complete session's signatures
+	 * without zeroing its head, count, or address fields.
+	 */
+	for (sid = 0; sid < count; sid++) {
+		err = mt76_npu_send_txrx_addr_wait(&dev->mt76, 3, sid,
+						   0, 0, 0, deadline);
+		if (err) {
+			dev_err(dev->mt76.dev,
+				"NPU BA signature sweep failed: completed=%u sid=%u elapsed_ms=%u error=%d\n",
+				sid, sid, jiffies_to_msecs(jiffies - start), err);
+			return err;
+		}
+	}
+
+	dev_info(dev->mt76.dev,
+		 "NPU BA signature sweep complete: commands=%u elapsed_ms=%u\n",
+		 count, jiffies_to_msecs(jiffies - start));
+
+	return 0;
+}
+
+static void mt7996_wed_rro_request_reset(struct mt7996_dev *dev)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&dev->recovery_lock, flags);
+	if (!READ_ONCE(dev->removing) && dev->recovery.hw_init_done) {
+		dev->recovery.restart = true;
+		set_bit(MT76_MCU_RESET, &dev->mphy.state);
+		wake_up(&dev->mt76.mcu.wait);
+		queue_work(dev->mt76.wq, &dev->reset_work);
+		wake_up(&dev->reset_wait);
+	}
+	spin_unlock_irqrestore(&dev->recovery_lock, flags);
+}
+
 static void mt7996_wed_rro_work(struct work_struct *work)
 {
 	u32 val = FIELD_PREP(WED_RRO_ADDR_SIGNATURE_MASK, 0xff);
+	struct mt7996_wed_rro_session_id *e;
 	struct mt7996_dev *dev;
+	bool npu_retire;
 	LIST_HEAD(list);
+	int err = 0;
 
 	dev = (struct mt7996_dev *)container_of(work, struct mt7996_dev,
 						wed_rro.work);
 
+	mutex_lock(&dev->mt76.mutex);
+	npu_retire = is_mt7996(&dev->mt76) && mt76_npu_device_active(&dev->mt76);
+	if (dev->wed_rro.reset_pending ||
+	    (npu_retire && (READ_ONCE(dev->removing) ||
+			    test_bit(MT76_MCU_RESET, &dev->mphy.state))))
+		goto unlock;
+
 	spin_lock_bh(&dev->wed_rro.lock);
 	list_splice_init(&dev->wed_rro.poll_list, &list);
 	spin_unlock_bh(&dev->wed_rro.lock);
 
 	while (!list_empty(&list)) {
-		struct mt7996_wed_rro_session_id *e;
 		int i;
 
 		e = list_first_entry(&list, struct mt7996_wed_rro_session_id,
@@ -1235,9 +1343,17 @@ static void mt7996_wed_rro_work(struct w
 		list_del_init(&e->list);
 
 		if (mt76_npu_device_active(&dev->mt76)) {
-			if (is_mt7996(&dev->mt76))
-				mt76_npu_send_txrx_addr(&dev->mt76, 3, e->id,
-							0, 0, 0);
+			if (npu_retire) {
+				if (e->id > MT7996_RRO_MAX_SESSION) {
+					err = -EINVAL;
+					goto recover;
+				}
+				err = mt76_npu_send_txrx_addr_wait(&dev->mt76, 3,
+								   e->id, 0, 0, 0,
+								   jiffies + 2 * HZ);
+				if (err)
+					goto recover;
+			}
 			goto reset_session;
 		}
 
@@ -1262,10 +1378,33 @@ reset:
 			elem->data |= cpu_to_le32(val);
 		}
 reset_session:
-		mt7996_mcu_wed_rro_reset_sessions(dev, e->id);
+		if (npu_retire && (READ_ONCE(dev->removing) ||
+				   test_bit(MT76_MCU_RESET, &dev->mphy.state))) {
+			err = -ESHUTDOWN;
+			goto recover;
+		}
+		err = mt7996_mcu_wed_rro_reset_sessions(dev, e->id);
+		if (err && npu_retire)
+			goto recover;
 out:
 		kfree(e);
 	}
+unlock:
+	mutex_unlock(&dev->mt76.mutex);
+	return;
+
+recover:
+	dev_warn(dev->mt76.dev, "RRO session %u retirement failed: %d\n", e->id, err);
+	/* A WM delete may already have completed; never replay this ledger. */
+	dev->wed_rro.reset_pending = true;
+	list_add(&e->list, &list);
+	spin_lock_bh(&dev->wed_rro.lock);
+	list_splice_init(&list, &dev->wed_rro.poll_list);
+	spin_unlock_bh(&dev->wed_rro.lock);
+	mutex_unlock(&dev->mt76.mutex);
+
+	/* Full reset cancels this worker before acquiring the device mutex. */
+	mt7996_wed_rro_request_reset(dev);
 }
 
