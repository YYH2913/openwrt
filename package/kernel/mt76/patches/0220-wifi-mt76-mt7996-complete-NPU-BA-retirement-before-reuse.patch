+int mt76_npu_send_txrx_addr_wait(struct mt76_dev *dev, int ifindex,
+				 u32 direction, u32 i_count_addr,
+				 u32 o_status_addr, u32 o_count_addr,
+				 unsigned long deadline)
+{
+	struct {
+		__le32 dir;
+		__le32 in_count_addr;
+		__le32 out_status_addr;
+		__le32 out_count_addr;
+	} info = {
+		.dir = cpu_to_le32(direction),
+		.in_count_addr = cpu_to_le32(i_count_addr),
+		.out_status_addr = cpu_to_le32(o_status_addr),
+		.out_count_addr = cpu_to_le32(o_count_addr),
+	};
+	struct airoha_npu_mailbox_result result;
+	struct airoha_npu *npu;
+	int err;
+
+	lockdep_assert_held(&dev->mutex);
+	npu = rcu_dereference_protected(dev->mmio.npu,
+					lockdep_is_held(&dev->mutex));
+	if (!npu)
+		return -ENODEV;
+
+	err = airoha_npu_wlan_send_msg_wait(npu, ifindex,
+					    WLAN_FUNC_SET_WAIT_INODE_TXRX_REG_ADDR,
+					    &info, sizeof(info), deadline, &result);
+	if (!err && (!result.submitted || !result.completed ||
+		     result.status != MT76_NPU_MBOX_SUCCESS ||
+		     result.request_len != sizeof(info) + MT76_NPU_WLAN_MSG_HEAD_LEN ||
+		     result.reply_len))
+		return -EIO;
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(mt76_npu_send_txrx_addr_wait);
