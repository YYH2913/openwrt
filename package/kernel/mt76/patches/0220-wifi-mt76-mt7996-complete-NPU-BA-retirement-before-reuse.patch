 	return mt7996_dma_rro_init(dev);
 }
 
+void mt7996_wed_rro_free_sessions(struct mt7996_dev *dev)
+{
+	struct mt7996_wed_rro_session_id *e, *tmp;
+	LIST_HEAD(list);
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	spin_lock_bh(&dev->wed_rro.lock);
+	list_splice_init(&dev->wed_rro.poll_list, &list);
+	spin_unlock_bh(&dev->wed_rro.lock);
+
+	list_for_each_entry_safe(e, tmp, &list, list) {
+		list_del(&e->list);
+		kfree(e);
+	}
+}
