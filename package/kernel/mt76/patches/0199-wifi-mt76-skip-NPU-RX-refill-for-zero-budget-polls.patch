From 803edd67dccd0a9ecc014bc2f9a9610cf9ace9e8 Mon Sep 17 00:00:00 2001
From: Yanghan Ye <yyh94306@gmail.com>
Date: Sat, 10 Oct 2026 20:27:15 -0700
Subject: [PATCH] wifi: mt76: skip NPU RX refill for zero-budget polls

A zero NAPI budget permits skb TX completion work only and forbids
page-pool RX operations. The NPU callback has no TX completion work, but
still refills its RX ring through the page pool after skipping the receive
loop. Return before touching RX state when no budget is available.

Fixes: 141a81557070 ("wifi: mt76: Introduce the NPU generic layer")
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 npu.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/npu.c b/npu.c
index 2bbc5e2..5e7697c 100644
--- a/npu.c
+++ b/npu.c
@@ -223,6 +223,9 @@ static int mt76_npu_rx_poll(struct napi_struct *napi, int budget)
 	struct airoha_npu *npu;
 	int done = 0;
 
+	if (!budget)
+		return 0;
+
 	rcu_read_lock();
 
 	npu = rcu_dereference(dev->mmio.npu);
-- 
2.43.0

