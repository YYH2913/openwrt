. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

if [ -e /etc/config/ubootenv ]; then
	case "$board" in
	axon,xg2010g-xgspon|axon,xg2010g|econet,xg2010g)
		existing="$(uci -q get 'ubootenv.@ubootenv[0].dev' || true)"
		[ -n "$existing" ] && exit 0
		;;
	*)
		exit 0
		;;
	esac
fi

touch /etc/config/ubootenv

case "$board" in
axon,xg2010g-xgspon|\
axon,xg2010g|\
econet,xg2010g|\
gemtek,w1700k-ubi|\
nokia,xg-040g-md-ubi)
	ubootenv_add_ubi_default
	;;
nokia,xg-040g-md)
	ubootenv_add_mtd "u-boot-env" "0x1c000" "0x4000" "0x4000"
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config

exit 0
