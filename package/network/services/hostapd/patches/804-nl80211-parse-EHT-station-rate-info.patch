From: Yanghan Ye <yyh94306@gmail.com>
Date: Mon, 27 Jul 2026 19:00:00 +0800
Subject: [PATCH] nl80211: parse EHT station rate information

The kernel has reported EHT MCS, NSS, guard interval and bandwidth in nested
station rate attributes since EHT rate reporting was added.  hostapd parses
the numeric bitrate but stops at HE-specific metadata and does not retain
the PPDU bandwidth, so users of read_sta_data cannot tell a narrow EHT PPDU
from an actual fallback to HE.

Parse the EHT fields and non-RU channel widths for both directions and retain
them in hostap_sta_driver_data.  This keeps association capability and the
current PPDU mode and bandwidth independently observable.

Assisted-by: Codex:GPT-5.6-sol
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 src/drivers/driver.h         | 14 ++++++++++
 src/drivers/driver_nl80211.c | 88 ++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 102 insertions(+)

--- a/src/drivers/driver.h
+++ b/src/drivers/driver.h
@@ -2780,6 +2780,14 @@ enum guard_interval {
 #define STA_DRV_DATA_RX_HE_DCM BIT(15)
 #define STA_DRV_DATA_TX_HE_GI BIT(16)
 #define STA_DRV_DATA_RX_HE_GI BIT(17)
+#define STA_DRV_DATA_TX_EHT_MCS BIT(18)
+#define STA_DRV_DATA_RX_EHT_MCS BIT(19)
+#define STA_DRV_DATA_TX_EHT_NSS BIT(20)
+#define STA_DRV_DATA_RX_EHT_NSS BIT(21)
+#define STA_DRV_DATA_TX_EHT_GI BIT(22)
+#define STA_DRV_DATA_RX_EHT_GI BIT(23)
+#define STA_DRV_DATA_TX_RATE_MHZ BIT(24)
+#define STA_DRV_DATA_RX_RATE_MHZ BIT(25)
 
 struct hostap_sta_driver_data {
 	unsigned long rx_packets, tx_packets;
@@ -2790,6 +2798,8 @@ struct hostap_sta_driver_data {
 	int bytes_64bit; /* whether 64-bit byte counters are supported */
 	unsigned long current_tx_rate; /* in kbps */
 	unsigned long current_rx_rate; /* in kbps */
+	unsigned int tx_rate_mhz;
+	unsigned int rx_rate_mhz;
 	unsigned long inactive_msec;
 	unsigned long connected_sec;
 	unsigned long flags; /* bitfield of STA_DRV_DATA_* */
@@ -2806,6 +2812,10 @@ struct hostap_sta_driver_data {
 	int signal; /* dBm; or -WPA_INVALID_NOISE */
 	u8 rx_hemcs;
 	u8 tx_hemcs;
+	u8 rx_ehtmcs;
+	u8 tx_ehtmcs;
+	u8 rx_eht_nss;
+	u8 tx_eht_nss;
 	u8 rx_vhtmcs;
 	u8 tx_vhtmcs;
 	u8 rx_mcs;
--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -8713,6 +8713,24 @@ static void get_sta_tid_stats(struct hos
 	}
 }
 
+static unsigned int nl80211_rate_mhz(struct nlattr **rate)
+{
+	if (rate[NL80211_RATE_INFO_HE_RU_ALLOC] ||
+	    rate[NL80211_RATE_INFO_EHT_RU_ALLOC])
+		return 0;
+
+	if (rate[NL80211_RATE_INFO_320_MHZ_WIDTH])
+		return 320;
+	if (rate[NL80211_RATE_INFO_160_MHZ_WIDTH] ||
+	    rate[NL80211_RATE_INFO_80P80_MHZ_WIDTH])
+		return 160;
+	if (rate[NL80211_RATE_INFO_80_MHZ_WIDTH])
+		return 80;
+	if (rate[NL80211_RATE_INFO_40_MHZ_WIDTH])
+		return 40;
+	return 20;
+}
+
 
 static int get_sta_handler(struct nl_msg *msg, void *arg)
 {
@@ -8757,6 +8775,16 @@ static int get_sta_handler(struct nl_msg
 		[NL80211_RATE_INFO_HE_NSS] = { .type = NLA_U8 },
 		[NL80211_RATE_INFO_HE_GI] = { .type = NLA_U8 },
 		[NL80211_RATE_INFO_HE_DCM] = { .type = NLA_U8 },
+		[NL80211_RATE_INFO_40_MHZ_WIDTH] = { .type = NLA_FLAG },
+		[NL80211_RATE_INFO_80_MHZ_WIDTH] = { .type = NLA_FLAG },
+		[NL80211_RATE_INFO_80P80_MHZ_WIDTH] = { .type = NLA_FLAG },
+		[NL80211_RATE_INFO_160_MHZ_WIDTH] = { .type = NLA_FLAG },
+		[NL80211_RATE_INFO_320_MHZ_WIDTH] = { .type = NLA_FLAG },
+		[NL80211_RATE_INFO_HE_RU_ALLOC] = { .type = NLA_U8 },
+		[NL80211_RATE_INFO_EHT_MCS] = { .type = NLA_U8 },
+		[NL80211_RATE_INFO_EHT_NSS] = { .type = NLA_U8 },
+		[NL80211_RATE_INFO_EHT_GI] = { .type = NLA_U8 },
+		[NL80211_RATE_INFO_EHT_RU_ALLOC] = { .type = NLA_U8 },
 	};
 
 	nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0),
@@ -8872,6 +8900,10 @@ static int get_sta_handler(struct nl_msg
 		/* Convert from 100 kbps to kbps; it's a more convenient unit.
 		 * It's also safe up until ~1Tbps. */
 		data->current_tx_rate = data->current_tx_rate * 100;
+		data->tx_rate_mhz = nl80211_rate_mhz(rate);
+		if (data->tx_rate_mhz)
+			data->flags |= STA_DRV_DATA_TX_RATE_MHZ;
+
 
 		if (rate[NL80211_RATE_INFO_MCS]) {
 			data->tx_mcs = nla_get_u8(rate[NL80211_RATE_INFO_MCS]);
@@ -8918,5 +8950,31 @@ static int get_sta_handler(struct nl_msg
 			data->flags |= STA_DRV_DATA_TX_HE_DCM;
 		}
+		if (rate[NL80211_RATE_INFO_EHT_MCS]) {
+			data->tx_ehtmcs =
+				nla_get_u8(rate[NL80211_RATE_INFO_EHT_MCS]);
+			data->flags |= STA_DRV_DATA_TX_EHT_MCS;
+		}
+		if (rate[NL80211_RATE_INFO_EHT_NSS]) {
+			data->tx_eht_nss =
+				nla_get_u8(rate[NL80211_RATE_INFO_EHT_NSS]);
+			data->flags |= STA_DRV_DATA_TX_EHT_NSS;
+		}
+		if (rate[NL80211_RATE_INFO_EHT_GI]) {
+			switch (nla_get_u8(rate[NL80211_RATE_INFO_EHT_GI])) {
+			case NL80211_RATE_INFO_EHT_GI_0_8:
+				data->tx_guard_interval = GUARD_INTERVAL_0_8;
+				data->flags |= STA_DRV_DATA_TX_EHT_GI;
+				break;
+			case NL80211_RATE_INFO_EHT_GI_1_6:
+				data->tx_guard_interval = GUARD_INTERVAL_1_6;
+				data->flags |= STA_DRV_DATA_TX_EHT_GI;
+				break;
+			case NL80211_RATE_INFO_EHT_GI_3_2:
+				data->tx_guard_interval = GUARD_INTERVAL_3_2;
+				data->flags |= STA_DRV_DATA_TX_EHT_GI;
+				break;
+			}
+		}
 	}
 
 	if (stats[NL80211_STA_INFO_RX_BITRATE] &&
@@ -8960,6 +9018,10 @@ static int get_sta_handler(struct nl_msg
 		/* Convert from 100 kbps to kbps; it's a more convenient unit.
 		 * It's also safe up until ~1Tbps. */
 		data->current_rx_rate = data->current_rx_rate * 100;
+		data->rx_rate_mhz = nl80211_rate_mhz(rate);
+		if (data->rx_rate_mhz)
+			data->flags |= STA_DRV_DATA_RX_RATE_MHZ;
+
 
 		if (rate[NL80211_RATE_INFO_MCS]) {
 			data->rx_mcs = nla_get_u8(rate[NL80211_RATE_INFO_MCS]);
@@ -8988,5 +9050,31 @@ static int get_sta_handler(struct nl_msg
 			data->flags |= STA_DRV_DATA_RX_HE_DCM;
 		}
+		if (rate[NL80211_RATE_INFO_EHT_MCS]) {
+			data->rx_ehtmcs =
+				nla_get_u8(rate[NL80211_RATE_INFO_EHT_MCS]);
+			data->flags |= STA_DRV_DATA_RX_EHT_MCS;
+		}
+		if (rate[NL80211_RATE_INFO_EHT_NSS]) {
+			data->rx_eht_nss =
+				nla_get_u8(rate[NL80211_RATE_INFO_EHT_NSS]);
+			data->flags |= STA_DRV_DATA_RX_EHT_NSS;
+		}
+		if (rate[NL80211_RATE_INFO_EHT_GI]) {
+			switch (nla_get_u8(rate[NL80211_RATE_INFO_EHT_GI])) {
+			case NL80211_RATE_INFO_EHT_GI_0_8:
+				data->rx_guard_interval = GUARD_INTERVAL_0_8;
+				data->flags |= STA_DRV_DATA_RX_EHT_GI;
+				break;
+			case NL80211_RATE_INFO_EHT_GI_1_6:
+				data->rx_guard_interval = GUARD_INTERVAL_1_6;
+				data->flags |= STA_DRV_DATA_RX_EHT_GI;
+				break;
+			case NL80211_RATE_INFO_EHT_GI_3_2:
+				data->rx_guard_interval = GUARD_INTERVAL_3_2;
+				data->flags |= STA_DRV_DATA_RX_EHT_GI;
+				break;
+			}
+		}
 	}
 
 	if (stats[NL80211_STA_INFO_TID_STATS])
-- 
2.43.0
