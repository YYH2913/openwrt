#!/bin/sh

# Execute and record one directed edge among the four 10G PON modes. The
# transactional LuCI RPC remains the only writer; evidence never contains
# registration credentials.
set -eu

umask 077

collector="${AIROHA_XPON_ACCEPT_COLLECTOR:-/usr/sbin/airoha-xpon-evidence}"
ubus_command="${AIROHA_XPON_ACCEPT_UBUS:-ubus}"
jsonfilter_command="${AIROHA_XPON_ACCEPT_JSONFILTER:-jsonfilter}"
sleep_command="${AIROHA_XPON_ACCEPT_SLEEP:-sleep}"
flock_command="${AIROHA_XPON_ACCEPT_FLOCK:-flock}"
lock_file="${AIROHA_XPON_ACCEPT_LOCK_FILE:-/var/lock/airoha-xpon-accept-edge.lock}"
timeout="${AIROHA_XPON_ACCEPT_TIMEOUT:-180}"
minimum_rx="${AIROHA_XPON_ACCEPT_MIN_RX_BYTES:-0}"
minimum_tx="${AIROHA_XPON_ACCEPT_MIN_TX_BYTES:-0}"
target_mode="${1:-}"
output_directory="${2:-}"

usage() {
	echo "usage: $0 {xgpon|xgspon|epon-10g-1g|epon-10g-10g} [new-output-directory]" >&2
}

valid_mode() {
	case "$1" in
		xgpon|xgspon|epon-10g-1g|epon-10g-10g) return 0 ;;
		*) return 1 ;;
	esac
}

unsigned_integer() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

evidence_field() {
	local file="$1" name="$2"

	awk -F= -v name="$name" '$1 == name { print substr($0, length(name) + 2); exit }' \
		"$file"
}

record_result() {
	local result="$1"

	{
		printf 'version=1\n'
		printf 'from_mode=%s\n' "$current_mode"
		printf 'target_mode=%s\n' "$target_mode"
		printf 'result=%s\n' "$result"
		printf 'attempts=%s\n' "$attempts"
		printf 'registration_ready_seen=%s\n' "$registration_ready_seen"
		printf 'traffic_baseline_after_registration=%s\n' "$traffic_baseline_set"
		printf 'minimum_rx_bytes=%s\n' "$minimum_rx"
		printf 'minimum_tx_bytes=%s\n' "$minimum_tx"
		printf 'rx_delta=%s\n' "$rx_delta"
		printf 'tx_delta=%s\n' "$tx_delta"
		printf 'pon_counter_source=%s\n' "$pon_counter_source"
		printf 'pon_rx_counter_unit=%s\n' "$pon_rx_counter_unit"
		printf 'pon_tx_counter_unit=%s\n' "$pon_tx_counter_unit"
		printf 'pon_rx_delta=%s\n' "$pon_rx_delta"
		printf 'pon_tx_delta=%s\n' "$pon_tx_delta"
		printf 'completed_at_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	} > "$output_directory/result.env"
}

switch_mode() {
	local mode="$1" request response success

	case "$mode" in
		xgpon) request='{"pon_mode":"xgpon"}' ;;
		xgspon) request='{"pon_mode":"xgspon"}' ;;
		epon-10g-1g) request='{"pon_mode":"epon-10g-1g"}' ;;
		epon-10g-10g) request='{"pon_mode":"epon-10g-10g"}' ;;
		*) return 1 ;;
	esac
	response="$("$ubus_command" call luci.airoha-gpon set_mode "$request")" ||
		return 1
	success="$("$jsonfilter_command" -s "$response" -e '@.success' 2>/dev/null)" ||
		return 1
	[ "$success" = true ]
}

common_ready() {
	local file="$1" mode="$2" require_commit="$3" switch_state

	[ "$(evidence_field "$file" runtime_mode)" = "$mode" ] || return 1
	[ "$(evidence_field "$file" bosa_mode_match)" = 1 ] || return 1
	[ "$(evidence_field "$file" bosa_fault_locked)" = 0 ] || return 1
	[ "$(evidence_field "$file" bosa_los)" = 0 ] || return 1
	[ "$(evidence_field "$file" bosa_tx_disable)" = 0 ] || return 1
	switch_state="$(evidence_field "$file" core_switch_state)"
	case "$switch_state" in
		*'switching=0'*'rollback_failed=0'*'fault_locked=0'*) ;;
		*) return 1 ;;
	esac
	if [ "$require_commit" -eq 1 ]; then
		case "$switch_state" in *'committed=1'*) ;; *) return 1 ;; esac
	fi
}

mode_ready() {
	local file="$1" mode="$2" require_commit="$3" mpcp_state

	common_ready "$file" "$mode" "$require_commit" || return 1
	case "$mode" in
		xgpon|xgspon)
			[ "$(evidence_field "$file" xgspon_enabled)" = 1 ] &&
				[ "$(evidence_field "$file" xgspon_state)" = registered ] &&
				[ "$(evidence_field "$file" xgspon_ready)" = 1 ] &&
				[ "$(evidence_field "$file" xgspon_key_derivation_state)" = \
					registered-secure-omcc-ready ] &&
				[ "$(evidence_field "$file" control_state)" = online ] &&
				[ "$(evidence_field "$file" control_pon_mode)" = "$mode" ] &&
				[ "$(evidence_field "$file" platform_state)" = applied ]
			;;
		epon-10g-1g|epon-10g-10g)
			[ "$(evidence_field "$file" epon_enabled)" = 1 ] || return 1
			mpcp_state="$(evidence_field "$file" epon_mpcp_state)"
			case "$mpcp_state" in *:8:*) ;; *) return 1 ;; esac
			[ "$(evidence_field "$file" control_state)" = online ] &&
				[ "$(evidence_field "$file" control_pon_mode)" = "$mode" ] &&
				[ "$(evidence_field "$file" control_control_plane)" = epon-oam ] &&
				[ "$(evidence_field "$file" control_omci)" = false ]
			;;
	esac
}

counter_delta() {
	local before="$1" after="$2"

	unsigned_integer "$before" && unsigned_integer "$after" &&
		[ "$after" -ge "$before" ] || {
		printf '%s\n' -1
		return
	}
	printf '%s\n' "$((after - before))"
}

threshold_met() {
	local minimum="$1" delta="$2"

	[ "$minimum" -eq 0 ] || [ "$delta" -ge "$minimum" ]
}

pon_proof_met() {
	local minimum="$1" delta="$2" unit="$3"

	[ "$minimum" -gt 0 ] || return 0
	unsigned_integer "$delta" || return 1
	case "$unit" in
		bytes) [ "$delta" -ge "$minimum" ] ;;
		frames) [ "$delta" -ge 1 ] ;;
		*) return 1 ;;
	esac
}

valid_mode "$target_mode" || {
	usage
	exit 2
}
unsigned_integer "$timeout" && [ "$timeout" -ge 1 ] &&
	[ "$timeout" -le 3600 ] || {
	echo 'invalid acceptance timeout' >&2
	exit 2
}
unsigned_integer "$minimum_rx" && unsigned_integer "$minimum_tx" || {
	echo 'traffic thresholds must be unsigned byte counts' >&2
	exit 2
}
exec 9>"$lock_file" || {
	echo "failed to open acceptance lock $lock_file" >&2
	exit 1
}
if ! "$flock_command" -n 9; then
	echo 'another PON edge acceptance transaction is running' >&2
	exit 1
fi
before_text="$("$collector")" || {
	echo 'failed to collect the current PON state' >&2
	exit 1
}
current_mode="$(printf '%s\n' "$before_text" |
	awk -F= '$1 == "runtime_mode" { print $2; exit }')"
valid_mode "$current_mode" || {
	echo "current mode $current_mode is outside the four-mode matrix" >&2
	exit 1
}
[ "$current_mode" != "$target_mode" ] || {
	echo 'source and target PON modes must differ' >&2
	exit 2
}
if [ -z "$output_directory" ]; then
	output_directory="/tmp/airoha-xpon-${current_mode}-to-${target_mode}-$(date -u +%Y%m%dT%H%M%SZ)"
fi
[ ! -e "$output_directory" ] || {
	echo "$output_directory already exists" >&2
	exit 1
}
mkdir -p "$output_directory"
printf '%s\n' "$before_text" > "$output_directory/before.env"
printf 'version=1\nfrom_mode=%s\ntarget_mode=%s\nstarted_at_utc=%s\n' \
	"$current_mode" "$target_mode" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
	> "$output_directory/transition.env"

before_rx="$(evidence_field "$output_directory/before.env" net_rx_bytes)"
before_tx="$(evidence_field "$output_directory/before.env" net_tx_bytes)"
before_pon_rx="$(evidence_field "$output_directory/before.env" pon_rx_counter)"
before_pon_tx="$(evidence_field "$output_directory/before.env" pon_tx_counter)"
attempts=0
registration_ready_seen=0
traffic_baseline_set=0
rx_delta=-1
tx_delta=-1
pon_rx_delta=-1
pon_tx_delta=-1
pon_counter_source="$(evidence_field "$output_directory/before.env" pon_counter_source)"
pon_rx_counter_unit="$(evidence_field "$output_directory/before.env" pon_rx_counter_unit)"
pon_tx_counter_unit="$(evidence_field "$output_directory/before.env" pon_tx_counter_unit)"
baseline_pon_source=
baseline_pon_rx_unit=
baseline_pon_tx_unit=

if ! mode_ready "$output_directory/before.env" "$current_mode" 0; then
	record_result source-not-ready
	echo "source PON mode is not registered and stable; evidence: $output_directory" >&2
	exit 1
fi

if ! switch_mode "$target_mode"; then
	"$collector" > "$output_directory/after.env" 2>/dev/null || true
	# A lost RPC reply is ambiguous: the kernel or UCI transaction may already
	# have committed. Reapply the source mode before returning a failure.
	if switch_mode "$current_mode" &&
		"$collector" "$current_mode" > "$output_directory/rollback.env" 2>/dev/null; then
		record_result rpc-switch-failed-source-restored
	else
		record_result rpc-switch-failed-source-restore-failed
	fi
	echo "PON switch RPC failed; source restore attempted; evidence: $output_directory" >&2
	exit 1
fi

while [ "$attempts" -lt "$timeout" ]; do
	attempts=$((attempts + 1))
	if "$collector" "$target_mode" > "$output_directory/after.env" 2>/dev/null; then
		after_rx="$(evidence_field "$output_directory/after.env" net_rx_bytes)"
		after_tx="$(evidence_field "$output_directory/after.env" net_tx_bytes)"
		after_pon_rx="$(evidence_field "$output_directory/after.env" pon_rx_counter)"
		after_pon_tx="$(evidence_field "$output_directory/after.env" pon_tx_counter)"
		after_pon_source="$(evidence_field "$output_directory/after.env" pon_counter_source)"
		after_pon_reset="$(evidence_field "$output_directory/after.env" pon_counter_reset)"
		after_pon_rx_unit="$(evidence_field "$output_directory/after.env" pon_rx_counter_unit)"
		after_pon_tx_unit="$(evidence_field "$output_directory/after.env" pon_tx_counter_unit)"
		pon_counter_source="$after_pon_source"
		pon_rx_counter_unit="$after_pon_rx_unit"
		pon_tx_counter_unit="$after_pon_tx_unit"
		rx_delta="$(counter_delta "$before_rx" "$after_rx")"
		tx_delta="$(counter_delta "$before_tx" "$after_tx")"
		pon_rx_delta="$(counter_delta "$before_pon_rx" "$after_pon_rx")"
		pon_tx_delta="$(counter_delta "$before_pon_tx" "$after_pon_tx")"
		if mode_ready "$output_directory/after.env" "$target_mode" 1; then
			registration_ready_seen=1
			if [ "$minimum_rx" -gt 0 ] || [ "$minimum_tx" -gt 0 ]; then
				if [ "$traffic_baseline_set" -eq 0 ]; then
					before_rx="$after_rx"
					before_tx="$after_tx"
					before_pon_rx="$after_pon_rx"
					before_pon_tx="$after_pon_tx"
					baseline_pon_source="$after_pon_source"
					baseline_pon_rx_unit="$after_pon_rx_unit"
					baseline_pon_tx_unit="$after_pon_tx_unit"
					traffic_baseline_set=1
					rx_delta=0
					tx_delta=0
					pon_rx_delta=0
					pon_tx_delta=0
				else
					rx_delta="$(counter_delta "$before_rx" "$after_rx")"
					tx_delta="$(counter_delta "$before_tx" "$after_tx")"
					if [ "$after_pon_reset" = 0 ] &&
						[ "$after_pon_source" = "$baseline_pon_source" ] &&
						[ "$after_pon_rx_unit" = "$baseline_pon_rx_unit" ] &&
						[ "$after_pon_tx_unit" = "$baseline_pon_tx_unit" ]; then
						pon_rx_delta="$(counter_delta "$before_pon_rx" "$after_pon_rx")"
						pon_tx_delta="$(counter_delta "$before_pon_tx" "$after_pon_tx")"
					else
						pon_rx_delta=-1
						pon_tx_delta=-1
					fi
				fi
			fi
			if threshold_met "$minimum_rx" "$rx_delta" &&
				threshold_met "$minimum_tx" "$tx_delta" &&
				pon_proof_met "$minimum_rx" "$pon_rx_delta" \
					"$pon_rx_counter_unit" &&
				pon_proof_met "$minimum_tx" "$pon_tx_delta" \
					"$pon_tx_counter_unit"; then
				record_result passed
				printf '%s\n' "$output_directory"
				exit 0
			fi
		fi
	fi
	"$sleep_command" 1
done

if switch_mode "$current_mode" &&
	"$collector" "$current_mode" > "$output_directory/rollback.env" 2>/dev/null; then
	if [ "$registration_ready_seen" -eq 1 ]; then
		record_result traffic-threshold-timeout-runtime-rolled-back
	else
		record_result target-not-ready-runtime-rolled-back
	fi
else
	record_result target-timeout-rollback-failed
fi
echo "PON edge acceptance failed; evidence: $output_directory" >&2
exit 1
